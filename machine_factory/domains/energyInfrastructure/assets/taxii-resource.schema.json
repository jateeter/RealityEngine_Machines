{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realityengine.local/energyInfrastructure/taxii-resource.schema.json",
  "$comment": "Project closed fixture profile derived from property tables; not an OASIS schema. Original source and Notices are retained at intake/taxii21/taxii-v2.1-os.html.",
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "error_id": {
          "type": "string",
          "minLength": 1
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "http_status": {
          "type": "string",
          "minLength": 1
        },
        "external_details": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "more": {
          "type": "boolean"
        },
        "next": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "string",
          "minLength": 1
        },
        "api_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "api-root": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_content_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "title",
        "versions",
        "max_content_length"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "complete",
            "pending"
          ]
        },
        "request_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "success_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "successes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/status-details"
          }
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/status-details"
          }
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/status-details"
          }
        }
      },
      "required": [
        "id",
        "status",
        "total_count",
        "success_count",
        "failure_count",
        "pending_count"
      ],
      "additionalProperties": false
    },
    "status-details": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "collections": {
      "type": "object",
      "properties": {
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/collection"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "can_read": {
          "type": "boolean"
        },
        "can_write": {
          "type": "boolean"
        },
        "media_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "title",
        "can_read",
        "can_write"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "more": {
          "type": "boolean"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/manifest-record"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "manifest-record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "date_added": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "date_added",
        "version"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "more": {
          "type": "boolean"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
