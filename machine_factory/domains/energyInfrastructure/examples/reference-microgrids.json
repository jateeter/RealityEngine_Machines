  "authorityRoles": [
    {
      "id": "UTILITY_OPERATOR",
      "identityKind": "GENERIC_OPERATING_ROLE",
      "allowed": [
        "propose grid/PCC envelope",
        "grant scenario reconnect permission"
      ],
      "prohibited": [
        "override local synch-check",
        "approve corpus admission"
      ],
      "namedPerson": null
    },
    {
      "id": "MICROGRID_OPERATOR",
      "identityKind": "GENERIC_OPERATING_ROLE",
      "allowed": [
        "request mode transition",
        "approve exact bounded operating proposal within scenario scope"
      ],
      "prohibited": [
        "bypass gateway",
        "reuse stale approval"
      ],
      "namedPerson": null
    },
    {
      "id": "LOCAL_PROTECTION",
      "identityKind": "SIMULATED_INDEPENDENT_CONTROL",
      "allowed": [
        "trip modeled protection",
        "deny energization or PCC close when interlocks fail"
      ],
      "prohibited": [
        "delegate protective authority to a model"
      ],
      "namedPerson": null
    },
    {
      "id": "DISPATCH_SERVICE",
      "identityKind": "ACTUAL_SOFTWARE_ROLE",
      "allowed": [
        "validate and execute scoped bounded commands after gateway checks"
      ],
      "prohibited": [
        "grant itself user/operator privileges",
        "change constraints without reviewed policy"
      ],
      "namedPerson": null
    },
    {
      "id": "MODEL_PLANNER",
      "identityKind": "ACTUAL_SOFTWARE_ROLE",
      "allowed": [
        "retrieve authorized references",
        "propose typed schedules and explanations"
      ],
      "prohibited": [
        "device credentials",
        "direct actuator/vector writes",
        "approve own proposal"
      ],
      "namedPerson": null
    },
    {
      "id": "CYBER_ANALYST",
      "identityKind": "ACTUAL_SOFTWARE_ROLE",
      "allowed": [
        "correlate threat evidence",
        "draft risk rationale"
      ],
      "prohibited": [
        "autonomous feeder isolation",
        "accept residual risk"
      ],
      "namedPerson": null
    },
    {
      "id": "RISK_REVIEWER",
      "identityKind": "GENERIC_OPERATING_ROLE",
      "allowed": [
        "review scenario risk treatment within declared role scope"
      ],
      "prohibited": [
        "approve real site risk from simulation"
      ],
      "namedPerson": null
    },
    {
      "id": "ASSURANCE_REVIEWER",
      "identityKind": "AUTHENTIC_REPOSITORY_REVIEW",
      "allowed": [
        "review artifacts and actual run evidence"
      ],
      "prohibited": [
        "substitute simulated human approval for repository review"
      ],
      "namedPerson": null
    },
    {
      "id": "ADMISSION_RELEASE_OWNER",
      "identityKind": "AUTHENTIC_REPOSITORY_REVIEW",
      "allowed": [
        "authorize genuine domain workflow/release with real identity"
      ],
      "prohibited": [
        "accept TEST_ONLY workflow receipts as production admission"
      ],
      "namedPerson": null
    }
  ],
