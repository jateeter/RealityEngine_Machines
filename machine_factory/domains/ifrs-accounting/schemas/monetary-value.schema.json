{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:re:ifrs:document-money:v1",
  "type": "object",
  "required": [
    "amount",
    "currency",
    "asOf",
    "evidenceRefs"
  ],
  "properties": {
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
