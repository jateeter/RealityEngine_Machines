{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:re:ifrs:document-revision:v1",
  "type": "object",
  "required": [
    "assetTypeId",
    "entityId",
    "period",
    "content",
    "evidenceRefs",
    "upstreamRefs",
    "inputFingerprint",
    "revision",
    "contentHash",
    "changeReason",
    "previousRevision",
    "ownerName"
  ],
  "properties": {
    "assetTypeId": {
      "enum": [
        "SOURCE-REGISTER",
        "RAG-RECEIPTS",
        "EVIDENCE-REGISTER",
        "ELIGIBILITY-MEMO",
        "JUDGMENT-REGISTER",
        "COST-EFFORT-MEMO",
        "POLICY-REGISTER",
        "GOING-CONCERN-MEMO",
        "MATERIALITY-MEMO",
        "COMPARATIVE-SCHEDULE",
        "FINANCIAL-POSITION",
        "PERFORMANCE-STATEMENTS",
        "EQUITY-STATEMENT",
        "DIVIDEND-REGISTER",
        "CASH-FLOW-STATEMENT",
        "CASH-CLASSIFICATION",
        "FINANCING-RECONCILIATION",
        "SUPPLIER-FINANCE-NOTE",
        "NOTES-PACK",
        "DISCLOSURE-CHECKLIST",
        "CONTROL-MEMO",
        "CONSOLIDATION-PACK",
        "SEPARATE-FS-ELECTION",
        "RESTATEMENT-PACK",
        "INSTRUMENT-REGISTER",
        "INSTRUMENT-SCHEDULE",
        "HEDGE-PACK",
        "VALUATION-PACK",
        "FAIR-VALUE-NOTE",
        "INVENTORY-SCHEDULE",
        "INVESTMENT-SCHEDULE",
        "JOINT-ARRANGEMENT-MEMO",
        "PROPERTY-CLASSIFICATION",
        "INVESTMENT-PROPERTY-SCHEDULE",
        "PPE-SCHEDULE",
        "RESTORATION-SCHEDULE",
        "INTANGIBLE-SCHEDULE",
        "ACQUISITION-MEMO",
        "PURCHASE-ALLOCATION",
        "GOODWILL-SCHEDULE",
        "LEASE-REGISTER",
        "LEASE-SCHEDULE",
        "PROVISION-SCHEDULE",
        "CAPITAL-SCHEDULE",
        "CONTRACT-REGISTER",
        "REVENUE-SCHEDULE",
        "REVENUE-GUIDANCE-MEMO",
        "GRANT-SCHEDULE",
        "BORROWING-COST-SCHEDULE",
        "SHARE-PAYMENT-SCHEDULE",
        "IMPAIRMENT-SCHEDULE",
        "BENEFITS-SCHEDULE",
        "TAX-SCHEDULE",
        "FX-SCHEDULE",
        "HYPERINFLATION-SCHEDULE",
        "SUBSEQUENT-EVENTS",
        "AUTHORISATION-REGISTER",
        "RELATED-PARTY-NOTE",
        "AGRICULTURE-SCHEDULE",
        "EXTRACTIVE-MEMO",
        "CONCESSION-SCHEDULE",
        "FIRST-ADOPTION-PACK",
        "EDITION-TRANSITION-PACK",
        "TERMINOLOGY-MAP",
        "SEMANTIC-INTEGRITY-LOG",
        "OCI-ROLLFORWARD",
        "STATEMENT-BUNDLE",
        "COMPLIANCE-REVIEW"
      ]
    },
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object"
    },
    "evidenceRefs": {
      "type": "array"
    },
    "upstreamRefs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changeReason": {
      "type": "string"
    },
    "previousRevision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ownerName": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
