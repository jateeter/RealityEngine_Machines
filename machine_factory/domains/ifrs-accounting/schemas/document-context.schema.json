{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:re:ifrs:document-context:v1",
  "type": "object",
  "required": [
    "entityId",
    "period",
    "factsFingerprint",
    "sourceFingerprint",
    "policyFingerprint"
  ],
  "properties": {
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "factsFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "sourceFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "policyFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "indexSnapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolvedRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notApplicableAssets": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
