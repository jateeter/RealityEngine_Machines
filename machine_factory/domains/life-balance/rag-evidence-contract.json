{
  "contractId": "urn:re:life-balance:rag-evidence:v1",
  "status": "DESIGN_ONLY",
  "requiredReceiptFields": [
    "interactionId",
    "subjectScope",
    "purpose",
    "effectiveQuery",
    "scopeFilters",
    "retrievedAt",
    "sourcePassages",
    "indexSnapshot",
    "embeddingModelVersion",
    "generationModelVersion",
    "claims",
    "unresolvedInputs"
  ],
  "requiredPassageFields": [
    "documentId",
    "chunkId",
    "sourceURI",
    "sourceVersion",
    "contentSHA256",
    "sourceSpan",
    "passageTextOrImmutableRef",
    "reviewStatus",
    "applicability",
    "retrievalScore"
  ],
  "claimPolicy": "Material factual recommendation maps to verified passages and applicable scoped facts; absent support yields unresolved/abstain.",
  "authorizationPolicy": "Gateway verifies scope before retrieval and before effects; metadata and retrieved instructions never grant permissions.",
  "invalidationTriggers": [
    "source-changed",
    "index-changed",
    "plan-superseded",
    "observation-corrected",
    "consent-revoked"
  ],
  "referenceCollectionStatus": "SOURCE_PACKS_NOT_INCLUDED_OR_INGESTED"
}
