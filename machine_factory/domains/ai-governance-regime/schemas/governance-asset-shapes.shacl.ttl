@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix solid:  <http://www.w3.org/ns/solid/terms#> .
@prefix spdx:   <https://spdx.org/rdf/3.0.1/terms#> .
@prefix re:     <https://opencommons.org/ns/reality-engine/v0.18#> .

# ==============================================================================
# RealityEngine V0.18 — AIGovernanceRegime SHACL Validation Suite (v2)
# Enforces Solid Asset Frame, AIBOM, Task-Sufficiency Dossier, Auditor Evidence,
# Emergency Break-Glass Override (M-GOV-15), and Quorum Keyring (M-GOV-17)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Governance Asset Frame & One-Shot Continuation Shape (Section 6, T2, T15-17)
# ------------------------------------------------------------------------------
re:GovernanceAssetFrameShape
    a sh:NodeShape ;
    sh:targetClass re:GovernanceAssetFrame ;
    sh:property [
        sh:path re:assetId ;
        sh:datatype xsd:string ;
        sh:pattern "^urn:re:asset:gov:[a-z0-9-]+:[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "assetId must follow canonical urn:re:asset:gov:<workflow>:YYYY-MM-DD-NNNN format." ;
    ] ;
    sh:property [
        sh:path re:domainId ;
        sh:hasValue "ai-governance-regime" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:templateMachine ;
        sh:datatype xsd:string ;
        sh:pattern "^M-GOV-([0-9]{2}|[A-Z]{3}-[0-9]{3})$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:pinnedArtifacts ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path re:activeContinuation ;
        sh:node re:ContinuationShape ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:receiptChainHead ;
        sh:node re:ReceiptChainHeadShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

re:PinnedArtifactShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:uri ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:etag ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:sha256 ;
        sh:datatype xsd:string ;
        sh:pattern "^(sha256:)?[a-f0-9]{64}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

re:ContinuationShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:oneShot ;
        sh:hasValue true ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "All governance continuations must be strictly one-shot (T2 replay defense)." ;
    ] ;
    sh:property [
        sh:path re:targetEngine ;
        sh:in ( "RealityEngine_CPP" "RealityEngine_Scala" "RealityEngine_LSP" ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:escapeOnHashMismatch ;
        sh:hasValue "rework" ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path re:escapeOnMissingEngine ;
        sh:hasValue "rework" ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path re:quorumPolicy ;
        sh:node re:QuorumPolicyShape ;
        sh:maxCount 1 ;
    ] .

re:QuorumPolicyShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:faultModel ;
        sh:in ( "crash" "byzantine" ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:n ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:q ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:excludedPrincipals ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Agent identities must be explicitly listed in excludedPrincipals (T15)." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Quorum threshold q violates faultModel bound (crash: q >= floor(n/2)+1; byzantine: n >= 3f+1 and q >= 2f+1)." ;
        sh:select """
            PREFIX re: <https://opencommons.org/ns/reality-engine/v0.18#>
            SELECT $this WHERE {
                $this re:faultModel ?fm ; re:n ?n ; re:q ?q .
                FILTER (
                    (?fm = "crash" && ?q < (FLOOR(?n / 2) + 1)) ||
                    (?fm = "byzantine" && (?n < 4 || ?q < (2 * FLOOR((?n - 1) / 3) + 1)))
                )
            }
        """ ;
    ] .

re:ReceiptChainHeadShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:sequence ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:prevReceiptHash ;
        sh:datatype xsd:string ;
        sh:pattern "^sha256:[a-f0-9]{64}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:ed25519Signature ;
        sh:datatype xsd:string ;
        sh:pattern "^sig:ed25519:[a-f0-9]+$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

# ------------------------------------------------------------------------------
# 2. AIBOM Manifest Shape (Section 12.2-12.5, TC-NEU-01/02, T19)
# ------------------------------------------------------------------------------
re:AIBOMManifestShape
    a sh:NodeShape ;
    sh:targetClass re:AIBOMManifest ;
    sh:property [
        sh:path re:instanceUUID ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:ruleEpoch ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:foundationModel ;
        sh:node re:FoundationModelPinShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:topKSaeDictionary ;
        sh:node re:TopKSaeDictionaryShape ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:proof ;
        sh:node re:CanonicalProofShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

re:FoundationModelPinShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:modelDigestSha256 ;
        sh:datatype xsd:string ;
        sh:pattern "^sha256:[a-f0-9]{64}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:neuraleseTap ;
        sh:node re:NeuraleseTapShape ;
        sh:maxCount 1 ;
    ] .

re:NeuraleseTapShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:isreBandOffset ;
        sh:datatype xsd:integer ;
        sh:minInclusive 86016 ;
        sh:message "Neuralese ISRE band offset must be >= 86016 to avoid colliding with corpus and clone space [20480:86015]." ;
    ] .

re:TopKSaeDictionaryShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:dictionarySha256 ;
        sh:datatype xsd:string ;
        sh:pattern "^sha256:[a-f0-9]{64}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:tcNeu01GatePass ;
        sh:hasValue true ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:tcNeu02GatePass ;
        sh:hasValue true ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:deadFeatureRateMeasured ;
        sh:datatype xsd:decimal ;
        sh:maxInclusive 0.20 ;
        sh:message "TC-NEU-02 requires dead dictionary feature rate <= 0.20 (20%)." ;
    ] .

re:CanonicalProofShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:canonicalization ;
        sh:hasValue "RFC8785" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:signatureAlgorithm ;
        sh:hasValue "Ed25519" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

# ------------------------------------------------------------------------------
# 3. Task-Sufficiency & Impact Dossier Shape (Prop. 1, ISO 42005, EU Art. 27)
# ------------------------------------------------------------------------------
re:TaskSufficiencyAndImpactDossierShape
    a sh:NodeShape ;
    sh:targetClass re:TaskSufficiencyAndImpactDossier ;
    sh:property [
        sh:path re:targetDomainId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:domainManifestSha256 ;
        sh:datatype xsd:string ;
        sh:pattern "^sha256:[a-f0-9]{64}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:declaredHazards ;
        sh:node re:DeclaredHazardEntryShape ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path re:signOffChain ;
        sh:node re:DossierSignOffShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

re:DeclaredHazardEntryShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [ sh:path re:observationMode ; sh:hasValue "FiberSaturated" ; sh:minCount 1 ] ;
            sh:property [ sh:path re:encodedIsreCells ; sh:minCount 1 ] ;
            sh:property [ sh:path re:completenessArgument ; sh:datatype xsd:string ; sh:minCount 1 ] ;
        ]
        [
            sh:property [ sh:path re:observationMode ; sh:hasValue "TemporallyBoundedIncomplete" ; sh:minCount 1 ] ;
            sh:property [ sh:path re:exposureBudgetMu ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:minCount 1 ] ;
            sh:property [ sh:path re:returnPathSource ; sh:datatype xsd:string ; sh:minCount 1 ] ;
            sh:property [ sh:path re:failSafeVector ; sh:minCount 1 ] ;
        ]
    ) ;
    sh:message "Every declared hazard must be either FiberSaturated (Prop. 1) or TemporallyBoundedIncomplete with mu, Source, and s_safe." .

re:DossierSignOffShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:preparerWebId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:approverWebId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:recertificationExpiresAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Separation of duties violation (T15): approverWebId must differ from preparerWebId." ;
        sh:select """
            PREFIX re: <https://opencommons.org/ns/reality-engine/v0.18#>
            SELECT $this WHERE {
                $this re:preparerWebId ?prep ; re:approverWebId ?app .
                FILTER (?prep = ?app)
            }
        """ ;
    ] .

# ------------------------------------------------------------------------------
# 4. Auditor Evidence Pack Shape (M-GOV-13 Sealed Container)
# ------------------------------------------------------------------------------
re:AuditorEvidencePackShape
    a sh:NodeShape ;
    sh:targetClass re:AuditorEvidencePack ;
    sh:property [
        sh:path re:dossierReceipt ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:aibomReceipt ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:walSegmentReceipt ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:quorumSignatureBundle ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:parityCertificate3of3 ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:egressArt50Log ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:klineIncidentArchive ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:proof ;
        sh:node re:CanonicalProofShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

# ------------------------------------------------------------------------------
# 5. Emergency Epoch Override Frame Shape (M-GOV-15 Break-Glass Pipeline)
# ------------------------------------------------------------------------------
re:EmergencyEpochOverrideFrameShape
    a sh:NodeShape ;
    sh:targetClass re:EmergencyEpochOverrideFrame ;
    sh:property [
        sh:path re:overrideId ;
        sh:datatype xsd:string ;
        sh:pattern "^urn:re:breakglass:[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:targetMachine ;
        sh:hasValue "M-GOV-15" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:targetCorpusBundle ;
        sh:node re:PinnedArtifactShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:rootHardwareTokenSignature ;
        sh:datatype xsd:string ;
        sh:pattern "^sig:(ed25519|ecdsa-p256):[a-f0-9]+$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Break-glass override requires an offline hardware-token root signature (YubiHSM/TPM)." ;
    ] ;
    sh:property [
        sh:path re:ttlSeconds ;
        sh:datatype xsd:integer ;
        sh:minInclusive 60 ;
        sh:maxInclusive 14400 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Emergency override TTL must be strictly bounded to <= 14,400 seconds (4 hours)." ;
    ] ;
    sh:property [
        sh:path re:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:expiresAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:ratificationContinuationId ;
        sh:datatype xsd:string ;
        sh:pattern "^cont-[0-9]+-ratify$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every break-glass override must spawn a mandatory post-hoc M-GOV-04 ratification continuation." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expiresAt must strictly follow issuedAt." ;
        sh:select """
            PREFIX re: <https://opencommons.org/ns/reality-engine/v0.18#>
            SELECT $this WHERE {
                $this re:issuedAt ?start ; re:expiresAt ?end .
                FILTER (?end <= ?start)
            }
        """ ;
    ] .

# ------------------------------------------------------------------------------
# 6. Quorum Keyring & Key Rotation Shape (M-GOV-17 Key Custody & Revocation)
# ------------------------------------------------------------------------------
re:QuorumKeyringShape
    a sh:NodeShape ;
    sh:targetClass re:QuorumKeyring ;
    sh:property [
        sh:path re:keyringEpoch ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:targetMachine ;
        sh:hasValue "M-GOV-17" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:crlDistributionPoint ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:members ;
        sh:node re:QuorumMemberKeyShape ;
        sh:minCount 3 ;
        sh:message "QuorumKeyring must contain at least 3 distinct departmental members (Risk, Engineering, Legal)." ;
    ] ;
    sh:property [
        sh:path re:proof ;
        sh:node re:CanonicalProofShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Cross-departmental quorum diversity violation: active members must span Risk, Engineering, and Legal." ;
        sh:select """
            PREFIX re: <https://opencommons.org/ns/reality-engine/v0.18#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this re:members ?m1 . ?m1 re:department "Risk" ; re:status "active" . }
                FILTER NOT EXISTS { $this re:members ?m2 . ?m2 re:department "Engineering" ; re:status "active" . }
                FILTER NOT EXISTS { $this re:members ?m3 . ?m3 re:department "Legal" ; re:status "active" . }
            }
        """ ;
    ] .

re:QuorumMemberKeyShape
    a sh:NodeShape ;
    sh:property [
        sh:path re:principalWebId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:department ;
        sh:in ( "Risk" "Engineering" "Legal" "Security" ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:publicKeyEd25519 ;
        sh:datatype xsd:string ;
        sh:pattern "^ed25519:[a-f0-9]{64}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:status ;
        sh:in ( "active" "revoked" "rotated" ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path re:leafExpiresAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .
