{
  "version": "1.0",
  "completionEndpoint": "/api/integrations/completions",
  "sourceMappings": [
    {
      "id": "mvp-provider-completion-risk",
      "sensorIdTemplate": "mvp.provider.{provider}.{agent}.completion",
      "region": {
        "offset": 4400,
        "length": 4
      },
      "extract": {
        "type": "json",
        "pointers": [
          "/completed",
          "/failed",
          "/confidence",
          "/actionClass"
        ]
      },
      "normalize": {
        "mode": "passthrough",
        "clamp": true
      },
      "ttlMs": 300000,
      "pushMode": "debounced",
      "debounceMs": 250
    }
  ]
}
