            "length": 4
          },
          "ttlMs": 300000,
          "normalization": "already-normalized-0-1",
          "ingest": {
            "endpoint": "/api/integrations/completions",
            "method": "POST",
            "triggerPush": false,
            "compactPush": true
          },
          "expectedJsonPointers": [
            "/completed",
            "/failed",
            "/confidence",
            "/actionClass"
          ]
        }
      }
    }
  }
}
