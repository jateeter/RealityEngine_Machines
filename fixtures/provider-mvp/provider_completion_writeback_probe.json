{
  "fixtureVersion": "1.0",
  "machine": {
    "id": "mvp-provider-completion-writeback-probe",
    "name": "MVP Provider Completion Writeback Probe",
    "metadata": {
      "domain": "provider-mvp",
      "machineClass": "agent-dispatcher",
      "aiTrigger": "mvp.provider.completion",
      "agentBinding": {
        "mode": "advise",
        "providers": [
          "openai",
          "ollama",
          "mcp"
