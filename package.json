{
  "name": "reality-engine-machines",
  "version": "1.0.0",
  "description": "Machine corpus (skills) and system-wide tests for the RealityEngine universe",
  "private": true,
  "type": "module",
  "scripts": {
    "agent-contracts:plan": "python3 scripts/backfill-agent-contracts.py",
    "agent-contracts:write": "python3 scripts/backfill-agent-contracts.py --write",
    "arbitration-registry:check": "python3 scripts/build-arbitration-registry.py --check",
    "arbitration-registry:summary": "python3 scripts/build-arbitration-registry.py --summary",
    "arbitration-registry:write": "python3 scripts/build-arbitration-registry.py --write",
    "autonomy-contracts:plan": "python3 scripts/backfill-autonomy-contracts.py",
    "autonomy-contracts:write": "python3 scripts/backfill-autonomy-contracts.py --write",
    "corpus-index:check": "python3 scripts/build-corpus-index.py --check",
    "corpus-index:write": "python3 scripts/build-corpus-index.py --write",
    "dispatch-contracts:plan": "python3 scripts/backfill-dispatch-contracts.py",
    "dispatch-contracts:write": "python3 scripts/backfill-dispatch-contracts.py --write",
    "dispatch-envelope:example": "python3 scripts/build-dispatch-envelope.py machines/AGX001_aquaculture-water-quality-stability.json",
    "guardrails:check": "bash scripts/validate-guardrails.sh",
    "lane-contracts:check": "python3 scripts/backfill-lane-contracts.py --check",
    "lane-contracts:plan": "python3 scripts/backfill-lane-contracts.py",
    "lane-contracts:write": "python3 scripts/backfill-lane-contracts.py --write",
    "lanes:check": "python3 scripts/project-lanes.py --check",
    "lanes:project": "python3 scripts/project-lanes.py --write",
    "owl:actions:plan": "python3 scripts/backfill-action-codes.py --all",
    "owl:actions:write": "python3 scripts/backfill-action-codes.py --all --write",
    "owl:check": "python3 scripts/generate-owl.py --domain health-personal --check --strict-actions",
    "owl:generate": "python3 scripts/generate-owl.py --domain health-personal --write --strict-actions",
    "owl:manifest:check": "python3 scripts/generate-owl.py --manifest-check --strict-actions",
    "owl:manifest:write": "python3 scripts/generate-owl.py --manifest-write --strict-actions",
    "owl:reason": "bash scripts/reason-owl.sh",
    "owl:reason:all": "bash scripts/reason-owl.sh --all",
    "owl:reason:all:complete": "bash scripts/reason-owl.sh --all --reasoner both",
    "owl:reason:domains": "for d in $(ls machines/domains); do bash scripts/reason-owl.sh \"$d\" || exit 1; done",
    "qudt:check": "python3 scripts/extract-qudt-subset.py --source .qudt-cache --check",
    "qudt:extract": "python3 scripts/extract-qudt-subset.py --download --write",
    "region-allocation:check": "python3 scripts/build-region-allocation.py --check",
    "region-allocation:write": "python3 scripts/build-region-allocation.py --write",
    "seed": "bash scripts/seed-machines.sh",
    "seed:local": "bash scripts/seed-machines.sh https://localhost:5001",
    "semantic-buses:inventory": "python3 scripts/inventory-semantic-buses.py",
    "semantic-buses:write": "python3 scripts/inventory-semantic-buses.py --write",
    "test": "npx playwright test",
    "test:contracts": "python3 -m unittest discover -s tests/contracts -p '*_test.py'",
    "test:e2e": "npx playwright test tests/e2e",
    "test:integration": "npx playwright test tests/integration",
    "test:report": "npx playwright show-report e2e-report",
    "test:smoke": "npx playwright test tests/smoke",
    "typecheck": "tsc --noEmit",
    "ucum:atoms": "python3 scripts/ucum.py --atoms",
    "ucum:check": "python3 scripts/ucum.py --scan domains/region-allocation.json",
    "validate": "bash scripts/validate-corpus.sh",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:strict": "STRICT_DOMAIN_CONTRACT=1 bash scripts/validate-corpus.sh",
    "validate:summary": "python3 scripts/audit-corpus.py --summary-only",
    "writeback-contracts:plan": "python3 scripts/backfill-writeback-contracts.py",
    "writeback-contracts:write": "python3 scripts/backfill-writeback-contracts.py --write",
    "writeback-payload:example": "python3 scripts/build-writeback-completion.py machines/AGX001_aquaculture-water-quality-stability.json"
  },
  "engines": {
    "node": ">=25.5.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.4.0"
  }
}
