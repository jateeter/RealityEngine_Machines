m:rule-ag-yield-ai-emergency-1
    a owl:NamedIndividual , re:TriggerRule ;
    rdfs:label "Ag Yield Optimization AI — ag-yield-ai-emergency rule 1 (RED)" ;
    re:appliesToSequence m:seq-ag-yield-ai-emergency ;
    re:outputMatchVector "1,0,0,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "EMERGENCY_INTERVENTION: multi-threat crop crisis at [310:316]" .

m:rule-ag-yield-ai-harvest-optimize-1
    a owl:NamedIndividual , re:TriggerRule ;
    rdfs:label "Ag Yield Optimization AI — ag-yield-ai-harvest-optimize rule 1 (GREEN)" ;
