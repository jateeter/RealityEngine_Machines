    re:outputMatchVector "0,0,1,0,0,0" ;
    re:matchesOutputPosition 2 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "OPTIMIZE_HARVEST: AI entering final yield optimization mode at [310:316]" .

m:rule-ag-yield-ai-harvest-optimize-2
