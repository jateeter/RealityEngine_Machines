m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Service Delivery Integrity Monitor" ;
    dcterms:description "Integration machine that reads combined output signals from the Case Worker Capacity Monitor [968:972] and the Service Delivery Compliance Monitor [972:976] to detect service delivery integrity failures — conditions where compliance obligations cannot be met because worker capacity has been exhausted. In community services, the most dangerous failure mode is when capacity pressure forces regulatory corners to be cut: documentation skipped, contacts missed, timelines violated. These are compliance violations whose root cause is a staffing crisis, not a process failure. Output at [992:996] is available to downstream care coordination systems." ;
    re:domainName "community-services" ;
    re:machineClass "safety-compliance-checker" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/community-services/ServiceDeliveryIntegrityMonitor.json" ;
