    rdfs:label "Document Signing Workflow Monitor" ;
    dcterms:description "Tracks document collection completeness, signature status, witness verification, and legal validity for community service enrollment agreements, consent forms, release of information authorizations, and benefit assignment documents. Document signing is a critical gating step in community services — unsigned consent forms block care coordination, unsigned ROIs prevent inter-agency data sharing, and missing program agreements delay benefit issuance by days or weeks. Output at [960:964] feeds the Workflow Completion Monitor." ;
    re:domainName "community-services" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/community-services/DocumentSigningWorkflowMonitor.json" ;
