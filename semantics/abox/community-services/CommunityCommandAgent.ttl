m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Community Command Agent" ;
    dcterms:description "Meta-CES — orchestrates a referral workflow across community-services leaf machines.  Its 'inputs' are event-bus bits latched by the engine when {benefits-eligibility, intake-triage, housing-placement} sequences fire.  Asserts referral-complete when all three milestones have fired in order." ;
    re:domainName "community-services" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:sourceFile "machines/domains/community-services/CommunityCommandAgent.json" ;
    re:hasPerceptualMapping m:perceptual-mapping ;
    re:hasGovernance m:governance ;
    re:hasSequence m:seq-referral-completion , m:seq-referral-incomplete ;
    re:hasTriggerRule m:rule-referral-completion-1 , m:rule-referral-incomplete-1 .

m:perceptual-mapping
    a owl:NamedIndividual , re:PerceptualMapping ;
    re:inputOffset 5500 ;
    re:inputLength 3 ;
    re:outputOffset 5503 ;
    re:outputLength 4 ;
    re:bitsPerElement 1 .

m:governance
    a owl:NamedIndividual , re:GovernancePolicy ;
    re:ownerTeam "social-services-on-call" ;
    re:runbook "https://runbooks.example.org/community-services/communitycommandagent"^^xsd:anyURI ;
    re:escalationPolicy "pagerduty:social-services" .

m:seq-referral-completion
    a owl:NamedIndividual , re:CriticalEventSequence ;
    re:sequenceId "referral-completion" ;
    rdfs:label "Referral completion — all three milestones latched" ;
    rdfs:comment "The meta-CES asserts referral-complete once {benefits-eligible.fired, intake-complete.fired, housing-placed.fired} have all been latched on the event bus.  Latching is monotonic — once a producer fires, the bit stays 1 until the simulator is reset — so this conjunction terminates the workflow regardless of arrival order.  Order discipline (benefits → intake → housing) is enforced upstream by the producer agents, not by the meta-CES." ;
    re:hasStep m:step-ccr-all-milestones-reached ;
    re:hasInitialStep m:step-ccr-all-milestones-reached .

m:step-ccr-all-milestones-reached
    a owl:NamedIndividual , re:SequenceStep ;
    re:isInitialStep true ;
    re:hasElementValue m:step-ccr-all-milestones-reached-e0 , m:step-ccr-all-milestones-reached-e1 , m:step-ccr-all-milestones-reached-e2 ;
    re:emitsDetermination m:out-ccr-out-referral-complete .

m:step-ccr-all-milestones-reached-e0
    a owl:NamedIndividual , re:ElementValue ;
    re:elementIndex 0 ;
    re:elementLevel 1 ;
    re:elementThreshold 0.5 .

m:step-ccr-all-milestones-reached-e1
    a owl:NamedIndividual , re:ElementValue ;
    re:elementIndex 1 ;
    re:elementLevel 1 ;
    re:elementThreshold 0.5 .

m:step-ccr-all-milestones-reached-e2
    a owl:NamedIndividual , re:ElementValue ;
    re:elementIndex 2 ;
    re:elementLevel 1 ;
    re:elementThreshold 0.5 .

m:out-ccr-out-referral-complete
    a owl:NamedIndividual , re:Determination ;
    re:outputTier 1 ;
    re:outputConfidence 0 .

m:seq-referral-incomplete
    a owl:NamedIndividual , re:CriticalEventSequence ;
    re:sequenceId "referral-incomplete" ;
    rdfs:label "Referral incomplete — milestones missing" ;
    rdfs:comment "Continuously asserts that referral is NOT complete (terminal value [0,1,0,0]) while at least one milestone is unmet.  Pairs with the referral-completion sequence on the same output region — final write wins per merge ordering, so once all three latch, REFERRAL_COMPLETE supersedes." ;
    re:hasStep m:step-ccr-await-all ;
    re:hasInitialStep m:step-ccr-await-all .

m:step-ccr-await-all
    a owl:NamedIndividual , re:SequenceStep ;
    re:isInitialStep true ;
    re:hasElementValue m:step-ccr-await-all-e0 , m:step-ccr-await-all-e1 , m:step-ccr-await-all-e2 ;
    re:emitsDetermination m:out-ccr-out-referral-pending .

m:step-ccr-await-all-e0
    a owl:NamedIndividual , re:ElementValue ;
    re:elementIndex 0 ;
    re:elementLevel 0 ;
    re:elementThreshold 0.5 .

m:step-ccr-await-all-e1
    a owl:NamedIndividual , re:ElementValue ;
    re:elementIndex 1 ;
    re:elementLevel 0 ;
    re:elementThreshold 0.5 .

m:step-ccr-await-all-e2
    a owl:NamedIndividual , re:ElementValue ;
    re:elementIndex 2 ;
    re:elementLevel 0 ;
    re:elementThreshold 0.5 .

m:out-ccr-out-referral-pending
    a owl:NamedIndividual , re:Determination ;
    re:outputTier 0 ;
    re:outputConfidence 1 .

m:rule-referral-completion-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-referral-completion ;
    re:outputMatchVector "1,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:GREEN ;
