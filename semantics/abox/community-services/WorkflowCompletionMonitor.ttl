m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Workflow Completion Monitor" ;
    dcterms:description "Integration machine that reads combined output signals from the Document Signing Workflow Monitor [960:964] and the Qualification Verification Monitor [964:968] to detect workflow completion failures — cases where signing and qualification are both required before services can be delivered but one or both remain incomplete. In community services, unclosed workflow loops (unsigned forms + unverified qualifications) create audit risk, delay benefit issuance, and prevent inter-agency coordination. Output at [988:992] is available to downstream care coordination systems." ;
    re:domainName "community-services" ;
    re:machineClass "risk-forecaster" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/community-services/WorkflowCompletionMonitor.json" ;
