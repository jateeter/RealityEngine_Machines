m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Referral Network Monitor" ;
    dcterms:description "Monitors referral acceptance rates, wait time performance, warm handoff completion, and follow-through rates across community service referral partnerships. Referral networks are the connective tissue of community services — they route clients to specialized resources (food banks, legal aid, mental health, substance use treatment, housing) that the referring agency cannot provide directly. Network degradation (partner agencies at capacity, wait lists expanding, warm handoff failures) silently starves clients of services they were told they would receive. Output at [976:980] feeds the Community Access Monitor." ;
    re:domainName "community-services" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/community-services/ReferralNetworkMonitor.json" ;
    re:hasPerceptualMapping m:perceptual-mapping ;
    re:hasGovernance m:governance ;
    re:hasSequence m:seq-referral-breakdown-escalation , m:seq-referral-delays , m:seq-referral-ok ;
    re:hasTriggerRule m:rule-referral-breakdown-escalation-1 , m:rule-referral-delays-1 , m:rule-referral-ok-1 ;
    re:hasInterconnection m:ix-community-services_community-services-core_referral-network-monitor ;
