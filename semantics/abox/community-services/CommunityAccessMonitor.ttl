m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Community Access Monitor" ;
    dcterms:description "Integration machine that reads combined output signals from the Referral Network Monitor [976:980] and the Community Outreach Monitor [980:984] to detect community access failures — conditions where the outreach and referral systems that connect people to community services have broken down. When outreach fails to reach eligible populations AND the referral network cannot route connected clients to services, community services become inaccessible regardless of how many programs exist on paper. Output at [996:1000] is available to downstream care coordination systems." ;
    re:domainName "community-services" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
