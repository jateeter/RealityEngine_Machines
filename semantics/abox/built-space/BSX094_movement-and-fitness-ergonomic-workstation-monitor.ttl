    a owl:NamedIndividual , re:AgentBinding ;
    rdfs:label "Built Space WELL Movement And Fitness Ergonomic Workstation Monitor — well_nourishment_agent (observe)" ;
    re:writesToRegionOf m:machine ;
    re:boundAgent m:agent ;
    re:autonomyMode re:Observe ;
    re:agentTrigger "built-space-well-movement-and-fitness-ergonomic-workstation-monitor" ;
    re:allowedAction "Dispatch well_nourishment_agent to verify WELL operational conformance for ergonomic workstation monitor." ;
    re:allowedAction "Run predictive optimization for ergonomic workstation monitor using occupant, system, and evidence trends." ;
    re:allowedAction "Create an operations, maintenance, policy, or evidence work order for ergonomic workstation monitor." ;
    re:allowedAction "Mark ergonomic workstation monitor in the current compliant operating window." ;
