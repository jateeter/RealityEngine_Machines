    re:appliesToSequence m:seq-fall-impact-recovered ;
    re:outputMatchVector "3,3" ;
    re:matchesOutputPosition 0 ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Severe motion sustained then recovered — caregiver check-in recommended" .

m:rule-fall-confirmed-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-fall-confirmed ;
    re:outputMatchVector "4,3" ;
    re:matchesOutputPosition 0 ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "Confirmed fall: motion onset → sustained → severe → impact stillness over six ticks. Dispatch caregiver / emergency contact." ;
    re:hasGovernance m:rule-fall-confirmed-1-governance .

m:rule-fall-confirmed-1-governance
    a owl:NamedIndividual , re:GovernancePolicy ;
    re:slaSeconds 30 ;
    re:runbook "https://runbooks.example.org/patient-safety/fall-detection#confirmed-red"^^xsd:anyURI ;
    re:ownerTeam "patient-safety-on-call-tier-1" .

m:rule-fall-slow-collapse-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-fall-slow-collapse ;
    re:outputMatchVector "4,2" ;
    re:matchesOutputPosition 0 ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "Sudden onset of stillness escalating over three ticks without preceding motion — possible syncope / silent collapse" ;
    re:hasGovernance m:rule-fall-slow-collapse-1-governance .

m:rule-fall-slow-collapse-1-governance
    a owl:NamedIndividual , re:GovernancePolicy ;
    re:slaSeconds 45 ;
    re:runbook "https://runbooks.example.org/patient-safety/fall-detection#slow-collapse"^^xsd:anyURI .

m:rule-fall-intentional-lying-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-fall-intentional-lying ;
    re:outputMatchVector "0,2" ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "Stillness reached without preceding motion or impact — likely intentional lying down (sleep / rest)" .

m:ix-health-personal_patient-safety-transport_fall-outcome
    a owl:NamedIndividual , re:Interconnection ;
    re:sourceMachine m:machine ;
    re:interconnectionId "health-personal.patient-safety-transport.fall-outcome" ;
    re:interconnectionType "published-domain-bus-producer" ;
    re:busId "health-personal.patient-safety-transport" ;
    re:targetMachineName "Patient Safety Transport Interconnect" ;
    re:sourceOutputOffset 1941 ;
    re:sourceOutputLength 2 ;
    re:targetInputOffset 4310 ;
    re:targetInputLength 10 ;
    re:publishedOutputOffset 7378 ;
    re:publishedOutputLength 4 ;
    re:privacyBoundary "PE composes normalized status bits only; raw PHI and source payloads remain outside the universal reality vector." ;
    rdfs:comment "Publish fall severity and confidence into the personal-health patient-safety transport bus." .

m:ix-health-personal_daily-patient-care-response_fall-criticality
    a owl:NamedIndividual , re:Interconnection ;
    re:sourceMachine m:machine ;
    re:interconnectionId "health-personal.daily-patient-care-response.fall-criticality" ;
    re:interconnectionType "published-domain-bus-producer" ;
    re:busId "health-personal.daily-patient-care-response" ;
    re:targetMachineName "Daily Patient Care Response Interconnect" ;
    re:sourceOutputOffset 1941 ;
    re:sourceOutputLength 2 ;
    re:targetInputOffset 4480 ;
    re:targetInputLength 18 ;
    re:publishedOutputOffset 4498 ;
    re:publishedOutputLength 4 ;
    re:dispatchMode "asynchronous-no-wait" ;
    re:privacyBoundary "PE composes normalized status bits only; raw PHI and source payloads remain outside the universal reality vector." ;
    rdfs:comment "Publish fall criticality into the personal-health daily patient care response bus." .

m:openclaw-projection
    a owl:NamedIndividual , re:OpenClawProjection ;
    re:sourceMachine m:machine ;
    re:projectionId "openclaw-fall-detection-native-input-projection" ;
    re:dispatchMode "accepted-no-wait" ;
    re:targetInputOffset 3813 ;
    re:targetInputLength 2 ;
    rdfs:comment "OpenClaw maps fall observations to native motion/stillness ordinals; PE writes the vector source and does not wait inside a PE cycle." .

m:agent-binding
    a owl:NamedIndividual , re:AgentBinding ;
    re:writesToRegionOf m:machine ;
    re:boundAgent m:agent ;
    re:autonomyMode re:Advise ;
    re:hasSemanticAxis m:axis-0 , m:axis-1 .

m:agent
    a owl:NamedIndividual , re:Agent ;
    re:agentId "openclaw-input-analyst" ;
    re:agentRole "openclaw-input-analyst" .

m:axis-0
    a owl:NamedIndividual , re:SemanticAxis ;
    re:axisIndex 0 ;
    re:axisName "motion_progression_ordinal" ;
    re:axisNameSource "openclaw-projection" .

m:axis-1
    a owl:NamedIndividual , re:SemanticAxis ;
    re:axisIndex 1 ;
    re:axisName "stillness_progression_ordinal" ;
    re:axisNameSource "openclaw-projection" .
