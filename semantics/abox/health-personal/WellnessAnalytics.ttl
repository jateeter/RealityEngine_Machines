    a owl:NamedIndividual , re:Determination ;
    re:outputTier 0 ;
    re:outputConfidence 0 ;
    re:prescribesAction re:NotifyCareTeam ;
    re:actionNarrative "Notify care team of wellness improvement. Do NOT cancel any pending TRANSITION_REVIEW meetings — confirm recovery holds at next assessment cycle before closing the ALERT episode. Document which interventions correlated with the improvement. Maintain increased monitoring frequency for 2 more cycles. If recovery is confirmed at next cycle, de-escalate to standard bi-weekly monitoring." .

m:rule-wa-sustained-alert-community-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wa-sustained-alert-community ;
    re:outputMatchVector "1,0,0,0,0,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "INFLOW_EVALUATION — sustained ALERT in community-dwelling patient; initiate NewPatientInflow standard evaluation sequence" .

m:rule-wa-critical-community-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wa-critical-community ;
    re:outputMatchVector "0,1,0,0,0,0,0,0" ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "INFLOW_URGENT — CRITICAL wellness in community-dwelling patient; initiate urgent NewPatientInflow evaluation with accelerated timeline" .

m:rule-wa-sustained-alert-facility-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wa-sustained-alert-facility ;
    re:outputMatchVector "0,0,1,0,0,0,0,0" ;
    re:matchesOutputPosition 2 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "TRANSITION_REVIEW — sustained ALERT in facility resident; activate CareTransitionWorkflow for care level review" .

m:rule-wa-critical-facility-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wa-critical-facility ;
    re:outputMatchVector "0,0,0,1,0,0,0,0" ;
    re:matchesOutputPosition 3 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "TRANSITION_ESCALATION — CRITICAL wellness in facility resident; activate CareTransitionWorkflow emergency escalation to hospital" .

m:rule-wa-rapid-decline-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wa-rapid-decline ;
    re:outputMatchVector "0,0,0,0,1,0,0,0" ;
    re:matchesOutputPosition 4 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "TRANSITION_URGENT — rapid 2-level wellness decline in facility resident; initiate priority care level review without waiting for two-cycle confirmation" .

m:rule-wa-wellness-improving-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wa-wellness-improving ;
    re:outputMatchVector "0,0,0,0,0,1,0,0" ;
    re:matchesOutputPosition 5 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "WELLNESS_IMPROVING — facility resident returning to GOOD level after ALERT; no care escalation required; care team notified of recovery" .

