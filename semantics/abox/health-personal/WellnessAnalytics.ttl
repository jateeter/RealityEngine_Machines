    re:hasInterconnection m:ix-health-personal_care-transition-response_wellness-transition-routing , m:ix-health-personal_facilities-maintenance-response_wellness-escalation , m:ix-health-personal_medication-access-adherence_wellness-routing , m:ix-health-personal_sleep-recovery-wellness_wellness-recovery , m:ix-health-personal_intake-wellness-routing_wellness-analytics ;
