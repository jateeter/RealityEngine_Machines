m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "WellnessAnalytics" ;
    dcterms:description "Analytics layer that consumes PatientWellness four-level metric outputs and detects longitudinal anomaly patterns — sustained deterioration, rapid decline, and recovery. Routes clinical decisions to downstream machines: NewPatientInflow (for community-dwelling patients requiring initial assisted living evaluation) and CareTransitionWorkflow (for facility residents requiring care level changes). Produces six routing outputs covering both community and facility escalation paths." ;
    re:domainName "health-personal" ;
    re:machineClass "outcome-stabilizer" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
