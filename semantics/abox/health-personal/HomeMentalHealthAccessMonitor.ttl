m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Home Mental Health Access Monitor" ;
    dcterms:description "Integration machine that reads combined output signals from the Home Chronic Disease Monitor [2019:2023] and the Home Chronic Pain Monitor [2023:2027] to detect mental health access needs driven by chronic illness burden. Chronic disease and chronic pain are bidirectionally linked to depression and anxiety — each worsens the other — and low-income patients carrying both have the least access to mental health services. This machine identifies patients who need mental health integration into their medical home care plan. Output at [2039:2043] is available to downstream care coordination systems." ;
    re:domainName "health-personal" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/health-personal/HomeMentalHealthAccessMonitor.json" ;
    re:hasPerceptualMapping m:perceptual-mapping ;
    re:hasGovernance m:governance ;
    re:hasSequence m:seq-mh-access-crisis , m:seq-mh-referral-needed , m:seq-mh-comorbidity-risk , m:seq-mh-access-adequate ;
    re:hasTriggerRule m:rule-mh-access-crisis , m:rule-mh-referral-needed , m:rule-mh-comorbidity-risk , m:rule-mh-access-adequate ;
    re:hasInterconnection m:ix-health-personal_chronic-pain-mental-health-access_mental-health-access , m:ix-health-personal_social-isolation-access_mental-health-access ;
    re:hasOpenClawProjection m:openclaw-projection .

