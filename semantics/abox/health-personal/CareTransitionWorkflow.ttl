m:seq-transition-emergency-escalation
    a owl:NamedIndividual , re:CriticalEventSequence , re:LifeSafetySequence ;
    re:sequenceId "transition-emergency-escalation" ;
    rdfs:label "Emergency Re-escalation — Any Care Facility to Acute Hospital" ;
    rdfs:comment "Patient in a post-acute or assisted living facility experiences acute clinical deterioration requiring emergency hospital transfer. Common causes: new cardiac event, respiratory failure, sepsis, acute stroke, fall with suspected fracture, severe medication reaction, acute altered mental status. D6=H and D7=H together distinguish this sequence from Sequence 1 (which has D7=H but D6=L — no prior facility context). This sequence handles both SNF→Hospital and ALF→Hospital emergency escalations." ;
    re:hasStep m:step-escalation-decline , m:step-escalation-family-alert , m:step-escalation-transport ;
    re:hasInitialStep m:step-escalation-decline .

