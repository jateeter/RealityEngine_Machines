m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "CareTransitionWorkflow" ;
    dcterms:description "Models patient readiness for changes in living situation across three care transition scenarios: (1) non-assisted home/community living to acute hospital admission for life-threatening conditions; (2) acute hospital discharge to a rehabilitation facility as a transitional environment; (3) rehabilitation facility discharge to assisted living for the next phase of life. Produces transition-specific readiness outputs with embedded external communication requirements." ;
    re:domainName "health-personal" ;
    re:machineClass "risk-forecaster" ;
    re:severity "life-safety" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/health-personal/CareTransitionWorkflow.json" ;
