    re:hasInterconnection m:ix-health-personal_child-development-support_home-environment-safety , m:ix-health-personal_facilities-maintenance-response_environment-safety , m:ix-health-personal_pediatric-adolescent-family-support_environment-safety , m:ix-health_infrastructure-support_consumer_home_environment_safety_context ;
