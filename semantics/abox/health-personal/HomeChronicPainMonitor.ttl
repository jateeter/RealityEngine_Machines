m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Home Chronic Pain Monitor" ;
    dcterms:description "Monitors pain intensity, functional impairment, opioid risk indicators, and physical activity for adults managing chronic pain at home in low- and medium-income settings. Chronic pain is disproportionately prevalent in low-income populations due to occupational injury, inadequate early treatment, and limited access to non-pharmacological interventions. Unmanaged chronic pain is a primary driver of depression and social isolation. Output at [2023:2027] feeds the Home Mental Health Access Monitor alongside the Chronic Disease Monitor." ;
    re:domainName "health-personal" ;
    re:machineClass "risk-forecaster" ;
    re:arbiterRule "PASSTHROUGH" ;
