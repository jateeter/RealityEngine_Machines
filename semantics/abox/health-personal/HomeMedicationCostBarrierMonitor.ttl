    rdfs:label "Home Medication Cost Barrier Monitor" ;
    dcterms:description "Monitors prescription fill rates, dose adherence, cost-driven non-adherence, and generic/assistance program access for low- and medium-income adults managing chronic conditions at home. Medication cost barriers are a leading driver of avoidable hospitalization and disease progression in economically vulnerable populations. Output at [2011:2015] feeds the Home Social Isolation Monitor, capturing how pharmacy access barriers compound transportation and social barriers." ;
    re:domainName "health-personal" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
