m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Home Social Isolation Monitor" ;
    dcterms:description "Integration machine that reads combined output signals from the Home Medication Cost Barrier Monitor [2011:2015] and the Home Transportation Barrier Monitor [2015:2019] to detect social isolation driven by access barriers. For low- and medium-income adults managing chronic conditions at home, the combination of medication cost barriers and transportation failures systematically restricts social participation, community connection, and human contact — accelerating depression, cognitive decline, and self-neglect. Output at [2035:2039] is available to downstream care coordination systems." ;
    re:domainName "health-personal" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/health-personal/HomeSocialIsolationMonitor.json" ;
