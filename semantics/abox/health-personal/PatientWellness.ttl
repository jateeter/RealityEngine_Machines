m:openclaw-projection
    a owl:NamedIndividual , re:OpenClawProjection ;
    re:sourceMachine m:machine ;
    re:projectionId "openclaw-patient-wellness-native-input-projection" ;
    re:dispatchMode "accepted-no-wait" ;
    re:targetInputOffset 1955 ;
    re:targetInputLength 8 ;
    rdfs:comment "Normal path is deterministic PE composition from DailyPatientCare output. OpenClaw may populate the same native lane only for external wellness observations that bypass DailyPatientCare." .

m:agent-binding
    a owl:NamedIndividual , re:AgentBinding ;
    re:writesToRegionOf m:machine ;
    re:boundAgent m:agent ;
    re:autonomyMode re:Advise ;
    re:hasSemanticAxis m:axis-0 , m:axis-1 , m:axis-2 , m:axis-3 , m:axis-4 , m:axis-5 , m:axis-6 , m:axis-7 .

m:agent
    a owl:NamedIndividual , re:Agent ;
    re:agentId "openclaw-input-analyst" ;
    re:agentRole "openclaw-input-analyst" .

m:axis-0
