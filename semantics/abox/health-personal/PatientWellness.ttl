    a owl:NamedIndividual , re:Determination ;
    re:outputTier 0 ;
    re:outputConfidence 1 ;
    re:prescribesAction re:RouteReferral ;
    re:actionNarrative "Document age-adjusted wellness classification. Refer to physical or occupational therapy to explore any safe exercise option (even passive range-of-motion). Continue monitoring all five assessed dimensions at standard frequency. No urgent care plan change required." .

m:rule-wellness-level4-optimal
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wellness-level4-optimal ;
    re:matchesOutputTier 1 ;
    re:matchesOutputConfidence 0 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Level 4 — OPTIMAL: All six wellness dimensions within age-adjusted norms. Resident is thriving. Maintain current care plan." .

m:rule-wellness-level3-good
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wellness-level3-good ;
    re:matchesOutputTier 0 ;
    re:matchesOutputConfidence 1 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Level 3 — GOOD: Five wellness dimensions in norm; stress elevated but not clinically impairing. Monitor and offer stress-reduction activities." .

m:rule-wellness-level2-alert
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wellness-level2-alert ;
    re:matchesOutputTier 0 ;
    re:matchesOutputConfidence 0 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Level 2 — ALERT: Multiple wellness deficits (anxiety, stress, exercise) with active decline trend. Care plan review and targeted interventions required." .

m:rule-wellness-level1-critical
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wellness-level1-critical ;
    re:matchesOutputTier 0 ;
    re:matchesOutputConfidence 0 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "Level 1 — CRITICAL: Mental acuity below age-cohort norm with established decline trend. Immediate clinical evaluation and care plan revision required." .

m:rule-wellness-level3-good-age-adjusted
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-wellness-level3-good-age-adjusted ;
    re:matchesOutputTier 0 ;
    re:matchesOutputConfidence 1 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Level 3 — GOOD (Age-Adjusted): Five wellness dimensions in norm; exercise below standard guideline but within age-adjusted functional capacity. Not penalized against an inapplicable standard." .

m:ix-health-personal_daily-patient-care-response_patient-wellness-acuity
    a owl:NamedIndividual , re:Interconnection ;
    re:sourceMachine m:machine ;
    re:interconnectionId "health-personal.daily-patient-care-response.patient-wellness-acuity" ;
    re:interconnectionType "published-domain-bus-producer" ;
    re:busId "health-personal.daily-patient-care-response" ;
    re:targetMachineName "Daily Patient Care Response Interconnect" ;
    re:sourceOutputOffset 3931 ;
    re:sourceOutputLength 8 ;
    re:targetInputOffset 4480 ;
    re:targetInputLength 18 ;
    re:publishedOutputOffset 4498 ;
    re:publishedOutputLength 4 ;
    re:dispatchMode "asynchronous-no-wait" ;
    re:privacyBoundary "PE composes normalized status bits only; raw PHI and source payloads remain outside the universal reality vector." ;
    rdfs:comment "Publish patient wellness acuity into the personal-health daily patient care response bus." .

