m:out-out-wandering-alert
    a owl:NamedIndividual , re:Determination ;
    re:outputTier 0 ;
    re:outputConfidence 0 .

m:rule-daily-morning-routine-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-morning-routine ;
    re:outputMatchVector "1,0,0,0,0,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "Event: MORNING_COMPLETE — patient successfully completed all morning care milestones" .

m:rule-daily-evening-routine-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-evening-routine ;
    re:outputMatchVector "0,1,0,0,0,0,0,0" ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "Event: EVENING_COMPLETE — patient successfully completed all evening care milestones and settled for the night" .

m:rule-daily-fall-response-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-fall-response ;
    re:outputMatchVector "0,0,1,0,0,0,0,0" ;
    re:matchesOutputPosition 2 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Alert: FALL_CONFIRMED — patient fell and activated call system; staff response required immediately" .

m:rule-daily-fall-unresponsive-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-fall-unresponsive ;
    re:outputMatchVector "0,0,0,1,0,0,0,0" ;
    re:matchesOutputPosition 3 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "CRITICAL ALERT: UNRESPONSIVE_FALL — patient fell and is not moving; no call system activated; immediate staff wellness check required" .

m:rule-daily-bathroom-nonuse-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-bathroom-nonuse ;
    re:outputMatchVector "0,0,0,0,1,0,0,0" ;
    re:matchesOutputPosition 4 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Alert: BATHROOM_ALERT — patient has not used bathroom within care-plan-specified interval; assess for urinary retention, mobility difficulty, or fall risk" .

m:rule-daily-medication-miss-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-medication-miss ;
    re:outputMatchVector "0,0,0,0,0,1,0,0" ;
    re:matchesOutputPosition 5 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Alert: MEDICATION_MISSED — morning medications not administered within window; assess for refusal, availability issue, or documentation gap" .

m:rule-daily-night-wandering-1
    a owl:NamedIndividual , re:TriggerRule ;
    re:appliesToSequence m:seq-daily-night-wandering ;
    re:outputMatchVector "0,0,0,0,0,0,1,0" ;
    re:matchesOutputPosition 6 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "Alert: WANDERING_ALERT — patient has exited room three times during nocturnal monitoring; assess for dementia-related wandering, pain, anxiety, or environmental cause" .

