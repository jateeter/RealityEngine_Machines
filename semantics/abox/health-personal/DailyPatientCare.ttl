    re:hasElementValue m:step-nw-awake-3-e0 , m:step-nw-awake-3-e1 , m:step-nw-awake-3-e2 , m:step-nw-awake-3-e3 , m:step-nw-awake-3-e4 , m:step-nw-awake-3-e5 , m:step-nw-awake-3-e6 , m:step-nw-awake-3-e7 ;
    re:emitsDetermination m:out-out-wandering-alert .

