m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Daily Activity Monitor" ;
    dcterms:description "Compares today's in-home movement against the patient's 7-day baseline. Flags sedentary days as AMBER and prolonged inactivity (multiple consecutive sedentary days) as RED so the local AI can escalate wellness outreach." ;
    re:domainName "health-personal" ;
    re:machineClass "signal-monitor" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/health-personal/DailyActivityMonitor.json" ;
    re:hasPerceptualMapping m:perceptual-mapping ;
    re:hasGovernance m:governance ;
    re:hasSequence m:seq-activity-active , m:seq-activity-sedentary , m:seq-activity-prolonged ;
    re:hasTriggerRule m:rule-activity-active , m:rule-activity-sedentary , m:rule-activity-prolonged ;
    re:hasInterconnection m:ix-health-personal_daily-activity-wellness_activity-burden , m:ix-health-personal_chronic-disease-response_activity-tolerance-status , m:ix-health-personal_sleep-recovery-wellness_activity-tolerance .

