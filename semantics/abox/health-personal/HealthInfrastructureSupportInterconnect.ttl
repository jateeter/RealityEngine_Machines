m:openclaw-projection
    a owl:NamedIndividual , re:OpenClawProjection ;
    re:sourceMachine m:machine ;
    re:projectionId "openclaw-health-infrastructure-support-native-input-projection" ;
    re:dispatchMode "accepted-no-wait" ;
    re:targetInputOffset 16900 ;
    re:targetInputLength 16 ;
    rdfs:comment "OpenClaw may ordinal-map cross-domain support observations into this bus input; PE writes the source without waiting inside a cycle." .

m:agent-binding
