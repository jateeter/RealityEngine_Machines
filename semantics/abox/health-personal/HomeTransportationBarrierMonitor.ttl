    rdfs:label "Home Transportation Barrier Monitor" ;
    dcterms:description "Monitors transportation access barriers that prevent low- and medium-income home health patients from attending medical appointments, filling prescriptions, and accessing community services. Transportation is a top driver of missed care in rural and low-income urban settings — more predictive of care gaps than insurance status alone. Output at [2015:2019] feeds the Home Social Isolation Monitor alongside the Medication Cost Barrier Monitor." ;
    re:domainName "health-personal" ;
    re:machineClass "agent-dispatcher" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/health-personal/HomeTransportationBarrierMonitor.json" ;
