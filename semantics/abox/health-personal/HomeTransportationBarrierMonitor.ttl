    re:hasTriggerRule m:rule-transport-critical-failure , m:rule-transport-transit-dependent-risk , m:rule-transport-adequate ;
    re:hasInterconnection m:ix-health-personal_patient-safety-transport_transport-access , m:ix-health-personal_chronic-disease-response_transport-access-status , m:ix-health-personal_facilities-maintenance-response_transport-access , m:ix-health-personal_medication-access-adherence_transport-access , m:ix-health-personal_social-isolation-access_transport-access , m:ix-health_infrastructure-support_consumer_home_transportation_barrier_context .

