m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Home Caregiver Burden Monitor" ;
    dcterms:description "Integration machine that reads combined output signals from the Pediatric Nutrition Monitor [2003:2007] and the Child Development Monitor [2007:2011] to assess caregiver burden driven by child health challenges. Child nutritional problems and developmental delays are the primary pediatric-driven stressors for at-home caregivers in low-income settings. Caregiver burnout reduces care quality across all household members and is a leading predictor of preventable pediatric ED visits. Output at [2031:2035] is available to downstream care coordination systems." ;
    re:domainName "health-personal" ;
    re:machineClass "risk-forecaster" ;
    re:arbiterRule "PASSTHROUGH" ;
