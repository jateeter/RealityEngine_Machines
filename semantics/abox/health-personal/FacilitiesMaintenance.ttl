m:out-out-wellness-concern
    a owl:NamedIndividual , re:Determination ;
    re:outputTier 0 ;
    re:outputConfidence 0 ;
    re:prescribesAction re:UrgentIntervention ;
    re:actionNarrative "Immediately inform charge nurse. Worker documents specific observed behaviors (did not recognize worker, appeared tearful, was unable to state the day). Nurse assesses within 2 hours (immediately if acute). Integration layer evaluates patient context and writes to WellnessAnalytics input at offset 234." .

m:seq-maint-inaccessible
    a owl:NamedIndividual , re:CriticalEventSequence ;
    re:sequenceId "maint-inaccessible" ;
    rdfs:label "Unit Inaccessible — Welfare Check Threshold Reached" ;
    rdfs:comment "Maintenance worker is unable to enter the unit after multiple attempts. Patient does not respond to repeated knocking and announcements, and unit key is not producing a response (e.g., room appears occupied but no movement). After a facility-defined threshold (typically 2-3 attempts over 15-30 minutes), an inaccessibility concern is logged. INACCESSIBILITY_ALERT triggers emergency welfare check protocol — the patient may be unconscious, fallen, medically compromised, or (in community settings) may have eloped." ;
    re:hasStep m:step-ia-visit , m:step-ia-inaccessible ;
    re:hasInitialStep m:step-ia-visit .

