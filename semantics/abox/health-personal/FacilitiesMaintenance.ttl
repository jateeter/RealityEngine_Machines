    re:targetInputOffset 4502 ;
    re:targetInputLength 18 ;
    re:publishedOutputOffset 4520 ;
    re:publishedOutputLength 4 ;
    re:dispatchMode "asynchronous-no-wait" ;
    re:privacyBoundary "PE composes normalized facilities, environment, access, and wellness status bits only; raw PHI, staff notes, work orders, and source payloads remain outside the universal reality vector." ;
    rdfs:comment "Publish maintenance completion, hygiene, safety, wellness, and access observations into the facilities response bus." .

m:openclaw-projection
    a owl:NamedIndividual , re:OpenClawProjection ;
    re:sourceMachine m:machine ;
    re:projectionId "openclaw-facilities-maintenance-native-input-projection" ;
    re:dispatchMode "accepted-no-wait" ;
    re:targetInputOffset 1931 ;
    re:targetInputLength 8 ;
    rdfs:comment "OpenClaw maps facility visit observations to native FacilitiesMaintenance input bits; PE writes the vector source and does not wait inside a PE cycle." .

