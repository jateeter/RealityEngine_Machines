m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "FacilitiesMaintenance" ;
    dcterms:description "Integrates facilities maintenance workflows into the eldercare patient health pipeline. Models janitorial, hygiene, and general living space maintenance activities as structured observational sequences. Each maintenance visit is an observational opportunity — facilities staff serve as a frontline sensing layer, reporting hygiene deficits, fall hazards, nutritional gaps, and patient wellness concerns to the clinical care workflow engines (DailyPatientCare, WellnessAnalytics). Produces six outputs: two completion signals (daily, weekly) and four clinical alert signals feeding downstream eldercare machines." ;
    re:domainName "health-personal" ;
    re:machineClass "signal-monitor" ;
    re:severity "life-safety" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:matchAlgorithm "gte" ;
    re:sourceFile "machines/domains/health-personal/FacilitiesMaintenance.json" ;
    re:hasPerceptualMapping m:perceptual-mapping ;
    re:hasGovernance m:governance ;
    re:hasSequence m:seq-maint-daily-routine , m:seq-maint-weekly-deep-clean , m:seq-maint-hygiene-concern , m:seq-maint-safety-concern , m:seq-maint-wellness-concern , m:seq-maint-inaccessible ;
    re:hasTriggerRule m:rule-maint-daily-routine-1 , m:rule-maint-weekly-deep-clean-1 , m:rule-maint-hygiene-concern-1 , m:rule-maint-safety-concern-1 , m:rule-maint-wellness-concern-1 , m:rule-maint-inaccessible-1 ;
    re:hasInterconnection m:ix-health-personal_daily-patient-care-response_facilities-observation , m:ix-health-personal_facilities-maintenance-response_facilities-observation ;
    re:hasOpenClawProjection m:openclaw-projection ;
    re:hasAgentBinding m:agent-binding .

