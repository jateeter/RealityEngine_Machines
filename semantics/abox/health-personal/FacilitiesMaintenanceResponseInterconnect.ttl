    re:outputMatchVector "0,1,0,0" ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "ENVIRONMENT_REMEDIATION_RESPONSE: facilities and home-environment signals require remediation, utility, or housing support at [4520:4524]" .

