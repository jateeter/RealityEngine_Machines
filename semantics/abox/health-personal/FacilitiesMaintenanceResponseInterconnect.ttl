m:rule-facilities-maintenance-immediate-welfare-check-1
    a owl:NamedIndividual , re:TriggerRule ;
    rdfs:label "Facilities Maintenance Response Interconnect — facilities-maintenance-immediate-welfare-check rule 1 (RED)" ;
    re:appliesToSequence m:seq-facilities-maintenance-immediate-welfare-check ;
    re:outputMatchVector "1,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "IMMEDIATE_WELFARE_CHECK: facilities, access, social, daily-care, or wellness signals require urgent welfare check at [4520:4524]" .

