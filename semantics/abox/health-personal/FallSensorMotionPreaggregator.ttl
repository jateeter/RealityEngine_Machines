m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Fall Sensor Motion Pre-aggregator" ;
    dcterms:description "Lifts the previously prose-only sensor pre-aggregation contract from FallDetection.metadata.designNotes into an executable CES.  Input is a raw active-sample count per tick (typically derived by the wearable firmware from a window of accelerometer samples whose magnitude exceeds a motion threshold).  Output is the motion-progression ordinal (0=none, 1=brief, 2=sustained, 3=severe) that FallDetection's motion-channel input region expects.  The wearable firmware is testable against this CES — given the same raw count, both the firmware and the engine must classify into the same ordinal." ;
    re:domainName "health-personal" ;
    re:machineClass "sensor-preaggregator" ;
    re:arbiterRule "PASSTHROUGH" ;
    re:sourceFile "machines/domains/health-personal/FallSensorMotionPreaggregator.json" ;
    re:hasPerceptualMapping m:perceptual-mapping ;
    re:hasGovernance m:governance ;
    re:hasSequence m:seq-motion-none , m:seq-motion-brief , m:seq-motion-sustained , m:seq-motion-severe ;
