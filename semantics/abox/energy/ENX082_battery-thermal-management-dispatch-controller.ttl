m:agent-binding
    a owl:NamedIndividual , re:AgentBinding ;
    rdfs:label "Community Microgrid Cluster Battery Thermal Management Dispatch Controller — community_microgrid_ops_agent (automated-act)" ;
    re:writesToRegionOf m:machine ;
    re:boundAgent m:agent ;
    re:autonomyMode re:AutomatedAct ;
    re:agentTrigger "community-microgrid-battery-thermal-management-dispatch-controller" ;
    re:allowedAction "Dispatch community_microgrid_ops_agent for urgent stabilization of battery thermal management dispatch controller using local voltage, frequency, harmonic, phase-balance, PCC, and feeder/protection signals." ;
    re:allowedAction "Optimize solar, battery, inverter grid-support, import/export, and flexible-load setpoints for battery thermal management dispatch controller." ;
    re:allowedAction "Schedule preventive maintenance for battery thermal management dispatch controller when equipment drift threatens local electric quality, grid stability, or safety margins." ;
    re:allowedAction "Continue community microgrid monitoring for battery thermal management dispatch controller while preserving the current local grid quality/stability operating plan." ;
    re:requiresHumanApproval false ;
    re:maxAutonomy re:AutomatedAct .

