m:rule-enx-082-urgent-stabilize-1
    a owl:NamedIndividual , re:TriggerRule ;
    rdfs:label "Community Microgrid Cluster Battery Thermal Management Dispatch Controller — enx-082-urgent-stabilize rule 1 (RED)" ;
    re:appliesToSequence m:seq-enx-082-urgent-stabilize ;
    re:outputMatchVector "1,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:RED ;
    re:processStatus "error" ;
    rdfs:comment "Urgent stabilization, isolation, curtailment, export limiting, grid-support, or restoration action required to protect local electric quality/stability." .

m:rule-enx-082-optimize-dispatch-1
    a owl:NamedIndividual , re:TriggerRule ;
    rdfs:label "Community Microgrid Cluster Battery Thermal Management Dispatch Controller — enx-082-optimize-dispatch rule 1 (GREEN)" ;
    re:appliesToSequence m:seq-enx-082-optimize-dispatch ;
    re:outputMatchVector "0,1,0,0" ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "Dispatch optimization should run for solar, battery, inverter grid-support, feeder constraints, local grid quality, and flexible load setpoints." .

m:rule-enx-082-preventive-maintenance-1
