    re:outputMatchVector "0,0,1,0" ;
    re:matchesOutputPosition 2 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "Preventive maintenance should be scheduled and verified before asset drift degrades local electric quality or stability." .

m:rule-enx-082-operating-window-ok-1
