    rdfs:label "Ag Harvest Readiness Assessor — ag-harvest-delayed rule 1 (AMBER)" ;
    re:appliesToSequence m:seq-ag-harvest-delayed ;
    re:outputMatchVector "1,0,0,0" ;
    re:matchesOutputPosition 0 ;
    re:hasRagStatus re:AMBER ;
    re:processStatus "warning" ;
    rdfs:comment "HARVEST_DELAYED: stress conditions preventing harvest readiness at [3967:3971]" .

m:rule-ag-harvest-stress-recovery-1
    a owl:NamedIndividual , re:TriggerRule ;
    rdfs:label "Ag Harvest Readiness Assessor — ag-harvest-stress-recovery rule 1 (GREEN)" ;
    re:appliesToSequence m:seq-ag-harvest-stress-recovery ;
    re:outputMatchVector "0,1,0,0" ;
    re:matchesOutputPosition 1 ;
    re:hasRagStatus re:GREEN ;
    re:processStatus "info" ;
    rdfs:comment "STRESS_RECOVERY: growth resuming after stress event at [3967:3971]" .

m:ix-agriculture_agriculture-core_ag-harvest-readiness-assessor
    a owl:NamedIndividual , re:Interconnection ;
    rdfs:label "Ag Harvest Readiness Assessor — ag_harvest_readiness_assessor" ;
    re:sourceMachine m:machine ;
    re:interconnectionId "agriculture.agriculture-core.ag-harvest-readiness-assessor" ;
    re:interconnectionType "published-domain-bus-producer" ;
    re:busId "agriculture.agriculture-core" ;
    re:targetMachineName "Agriculture Core Interconnect" ;
    re:sourceOutputOffset 3967 ;
    re:sourceOutputLength 4 ;
    re:targetInputOffset 13000 ;
    re:targetInputLength 27 ;
    re:publishedOutputOffset 13027 ;
    re:publishedOutputLength 4 ;
    re:dispatchMode "asynchronous-no-wait" ;
    re:privacyBoundary "PE composes normalized domain status bits only; raw regulated records, operator notes, telemetry payloads, documents, and provider-specific source payloads remain outside the universal reality vector." ;
    rdfs:comment "Publish Ag Harvest Readiness Assessor active response lanes into agriculture.agriculture-core." .

