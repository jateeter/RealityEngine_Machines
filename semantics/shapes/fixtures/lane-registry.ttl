# Conformance fixture: a small lane registry standing in for the projection of
# domains/region-allocation.json. Offsets and lane ids are real ones from the
# corpus so the fixture stays recognisable.
#
# Unit annotations follow the corpus decision: UCUM canonical in data, QUDT
# canonical in semantics, OM bridge-only. Loaded by every case in cases.json,
# together with qudt-subset.ttl.

@prefix reg:   <https://realityengine.example.org/ontology/re-guardrails#> .
@prefix re:    <https://realityengine.example.org/ontology/re-core#> .
@prefix fx:    <https://realityengine.example.org/fixtures/guardrails#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Wire units, shared by the cases.
#################################################################

fx:u-unity    a reg:Unit ; rdfs:label "unity" ;
    reg:unitSystem "http://unitsofmeasure.org"^^xsd:anyURI ; reg:unitCode "1" .

fx:u-per-min  a reg:Unit ; rdfs:label "per minute" ;
    reg:unitSystem "http://unitsofmeasure.org"^^xsd:anyURI ; reg:unitCode "min-1" ;
    reg:unitDisplay "bpm" .

fx:u-cel      a reg:Unit ; rdfs:label "degree Celsius" ;
    reg:unitSystem "http://unitsofmeasure.org"^^xsd:anyURI ; reg:unitCode "Cel" .

fx:u-kelvin   a reg:Unit ; rdfs:label "kelvin" ;
    reg:unitSystem "http://unitsofmeasure.org"^^xsd:anyURI ; reg:unitCode "K" .

# A unit the axis does not accept, in the right system.
fx:u-mg-per-dl a reg:Unit ; rdfs:label "mg/dL" ;
    reg:unitSystem "http://unitsofmeasure.org"^^xsd:anyURI ; reg:unitCode "dL-1.mg" ;
    reg:unitDisplay "mg/dL" .

# OM-native contribution, bridged to UCUM at ingest. Admissible.
fx:u-om-per-min-bridged a reg:Unit ; rdfs:label "OM reciprocal minute (bridged)" ;
    reg:unitSystem "http://www.ontology-of-units-of-measure.org/resource/om-2/"^^xsd:anyURI ;
    reg:unitCode "reciprocalMinute" ;
    reg:unitDisplay "beats per minute" ;
    reg:bridgesToUcum "min-1" .

# The same contribution with no bridge declared. Refused: OM is a bridge, not
# a primary system.
fx:u-om-per-min-unbridged a reg:Unit ; rdfs:label "OM reciprocal minute (unbridged)" ;
    reg:unitSystem "http://www.ontology-of-units-of-measure.org/resource/om-2/"^^xsd:anyURI ;
    reg:unitCode "reciprocalMinute" .

#################################################################
# Life-safety lane: the Fall Detection input region.
# Machine-native progression ordinals: unity-coded, conversion prohibited.
#################################################################

fx:lane-fall-detection-input
    a reg:IngressLane ;
        reg:carriesAutonomy re:Advise ;
    reg:laneId "fall-detection-input" ;
    reg:laneOffset 3813 ;
    reg:laneLength 2 ;
    reg:lifeSafetyLane true ;
    reg:requiredAutonomy re:Advise ;
    reg:maxStalenessMs 60000 ;
    reg:permittedProvider "openclaw" , "healthkit" ;
    reg:permittedProvenance reg:Measured , reg:Derived ;
    reg:hasAxis fx:axis-fall-0 , fx:axis-fall-1 .

fx:axis-fall-0
    a reg:LaneAxis ;
    re:axisIndex 0 ;
    re:axisName "motion_progression_ordinal" ;
    reg:canonicalUcum "1" ; reg:acceptedUcum "1" ; reg:expectedUcum "1" ;
    reg:quantityKind qkind:Dimensionless ;
    reg:qudtUnitIri unit:UNITLESS ;
    reg:conversionPolicy reg:ProhibitedConversion ;
    reg:scaleType reg:OrdinalScale ;
    reg:permittedValue 0 , 1 , 2 , 3 .

fx:axis-fall-1
    a reg:LaneAxis ;
    re:axisIndex 1 ;
    re:axisName "stillness_progression_ordinal" ;
    reg:canonicalUcum "1" ; reg:acceptedUcum "1" ; reg:expectedUcum "1" ;
    reg:quantityKind qkind:Dimensionless ;
    reg:qudtUnitIri unit:UNITLESS ;
    reg:conversionPolicy reg:ProhibitedConversion ;
    reg:scaleType reg:OrdinalScale ;
    reg:permittedValue 0 , 1 , 2 , 3 .

#################################################################
# Measured device lane: HealthKit heart rate. Ratio scale, linear.
#################################################################

fx:lane-healthkit-heart-rate
    a reg:IngressLane ;
        reg:carriesAutonomy re:Advise ;
    reg:laneId "healthkit-heart-rate" ;
    reg:laneOffset 4320 ;
    reg:laneLength 2 ;
    reg:maxStalenessMs 300000 ;
    reg:permittedProvider "healthkit" ;
    reg:permittedProvenance reg:Measured ;
    reg:hasAxis fx:axis-hr-0 , fx:axis-hr-1 .

fx:axis-hr-0
    a reg:LaneAxis ;
    re:axisIndex 0 ;
    re:axisName "heart_rate" ;
    reg:canonicalUcum "min-1" ; reg:expectedUcum "min-1" ;
    reg:acceptedUcum "min-1" ;
    reg:quantityKind qkind:Frequency ;
    reg:qudtUnitIri unit:PER-MIN ;
    reg:conversionPolicy reg:LinearConversion ;
    reg:scaleType reg:RatioScale ;
    reg:minValue 20 ;
    reg:maxValue 250 ;
    reg:observableProperty fx:prop-heart-rate .

fx:axis-hr-1
    a reg:LaneAxis ;
    re:axisIndex 1 ;
    re:axisName "heart_rate_confidence" ;
    reg:canonicalUcum "1" ; reg:acceptedUcum "1" ;
    reg:quantityKind qkind:Dimensionless ;
    reg:qudtUnitIri unit:UNITLESS ;
    reg:conversionPolicy reg:NoConversion ;
    reg:scaleType reg:RatioScale ;
    reg:minValue 0.0 ;
    reg:maxValue 1.0 .

fx:prop-heart-rate a sosa:ObservableProperty ; rdfs:label "heart rate" .

#################################################################
# Environment lane: the affine case. Canonical Celsius, Kelvin accepted.
#################################################################

fx:lane-home-environment-temperature
    a reg:IngressLane ;
        reg:carriesAutonomy re:Advise ;
    reg:laneId "home-environment-temperature" ;
    reg:laneOffset 4400 ;
    reg:laneLength 1 ;
    reg:maxStalenessMs 900000 ;
    reg:permittedProvider "healthkit" , "mqtt" ;
    reg:permittedProvenance reg:Measured ;
    reg:hasAxis fx:axis-temp-0 .

fx:axis-temp-0
    a reg:LaneAxis ;
    re:axisIndex 0 ;
    re:axisName "ambient_temperature" ;
    reg:canonicalUcum "Cel" ; reg:expectedUcum "Cel" ;
    reg:acceptedUcum "Cel" , "K" ;
    reg:quantityKind qkind:Temperature ;
    reg:qudtUnitIri unit:DEG_C ;
    reg:conversionPolicy reg:AffineConversion ;
    reg:scaleType reg:IntervalScale ;
    reg:minValue -40 ;
    reg:maxValue 60 .

#################################################################
# Agent completion lane: model output only.
#################################################################

fx:lane-agent-completion-risk
    a reg:IngressLane ;
        reg:carriesAutonomy re:Advise ;
    reg:laneId "agent-completion-risk" ;
    reg:laneOffset 4200 ;
    reg:laneLength 2 ;
    reg:maxStalenessMs 600000 ;
    reg:permittedProvider "localai" , "openai" , "ollama" ;
    reg:permittedProvenance reg:Inferred ;
    reg:hasAxis fx:axis-risk-0 , fx:axis-risk-1 .

fx:axis-risk-0
    a reg:LaneAxis ;
    re:axisIndex 0 ;
    re:axisName "risk_flag" ;
    reg:canonicalUcum "1" ; reg:acceptedUcum "1" ;
    reg:quantityKind qkind:Dimensionless ;
    reg:qudtUnitIri unit:UNITLESS ;
    reg:conversionPolicy reg:ProhibitedConversion ;
    reg:scaleType reg:NominalScale ;
    reg:permittedValue 0 , 1 .

fx:axis-risk-1
    a reg:LaneAxis ;
    re:axisIndex 1 ;
    re:axisName "risk_confidence" ;
    reg:canonicalUcum "1" ; reg:acceptedUcum "1" ;
    reg:quantityKind qkind:Dimensionless ;
    reg:qudtUnitIri unit:UNITLESS ;
    reg:conversionPolicy reg:NoConversion ;
    reg:scaleType reg:RatioScale ;
    reg:minValue 0.0 ;
    reg:maxValue 1.0 .

#################################################################
# Sources
#################################################################

fx:source-healthkit-bridge
    a sosa:Sensor ;
    reg:providerId "healthkit" ;
    rdfs:label "HealthKit device bridge" .

fx:source-openclaw-projection
    a sosa:Sensor ;
    reg:providerId "openclaw" ;
    rdfs:label "OpenClaw input analyst projection" .

fx:source-ollama-adapter
    reg:providerId "ollama" ;
    rdfs:label "Ollama completion adapter" .

fx:source-unregistered
    reg:providerId "some-new-vendor" ;
    rdfs:label "Provider not listed on any lane" .

fx:procedure-risk-model
    a sosa:Procedure ;
    rdfs:label "paging-decision risk model" .

fx:feature-patient-01 rdfs:label "patient-01" .

#################################################################
# Determinations and bindings for the egress cases
#################################################################

fx:determination-red
    a re:Determination ;
    re:outputTier 3 ;
    re:hasRagStatus re:RED ;
    re:prescribesAction re:EmergencyDispatch .

fx:determination-amber
    a re:Determination ;
    re:outputTier 2 ;
    re:hasRagStatus re:AMBER ;
    re:prescribesAction re:CaregiverCheckIn .

fx:binding-supervised
    a re:AgentBinding ;
    re:maxAutonomy re:SupervisedAct ;
    re:requiresHumanApproval true ;
    re:allowedAction "emergency-dispatch" , "caregiver-check-in" ;
    reg:blockedWhenRag re:GREEN .

fx:binding-automated
    a re:AgentBinding ;
    re:maxAutonomy re:AutomatedAct ;
    re:requiresHumanApproval false ;
    re:allowedAction "emergency-dispatch" , "caregiver-check-in" , "publish-bus" .

fx:action-uncontrolled
    a re:Action ;
    rdfs:label "An action individual with no re:actionCode" .
