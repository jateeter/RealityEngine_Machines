# ILLUSTRATIVE QUDT SUBSET — FIXTURE ONLY.
#
# Hand-written for the conformance suite so the unit gates can be exercised
# without pulling the full QUDT ontology into a test run. This is NOT an
# extraction from upstream QUDT and must not be treated as authoritative:
# the IRIs and conversion facts below are representative, not verified against
# a QUDT release.
#
# Production use requires a real, pinned extraction — see
# docs/SEMANTIC_GUARDRAIL_CONTRACT.md, "The QUDT subset". Reasoning over all of
# QUDT in CI is not tractable and not necessary; only the quantity kinds and
# units the corpus actually references belong in the merged graph.
#
# The property that matters here is qudt:conversionOffset. Upstream asserts it
# only where it is non-zero — in practice DEG_C and DEG_F — which is what makes
# "this axis must be affine, not linear" a decidable check rather than a naming
# convention.

@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

qkind:Frequency     a qudt:QuantityKind ; rdfs:label "Frequency" .
qkind:Temperature   a qudt:QuantityKind ; rdfs:label "Temperature" .
qkind:Dimensionless a qudt:QuantityKind ; rdfs:label "Dimensionless" .

unit:PER-MIN
    a qudt:Unit ;
    rdfs:label "per minute" ;
    qudt:ucumCode "/min" ;
    qudt:hasQuantityKind qkind:Frequency ;
    qudt:conversionMultiplier 0.016666666666666666 .

unit:UNITLESS
    a qudt:Unit ;
    rdfs:label "unitless" ;
    qudt:ucumCode "1" ;
    qudt:hasQuantityKind qkind:Dimensionless ;
    qudt:conversionMultiplier 1.0 .

unit:K
    a qudt:Unit ;
    rdfs:label "kelvin" ;
    qudt:ucumCode "K" ;
    qudt:hasQuantityKind qkind:Temperature ;
    qudt:conversionMultiplier 1.0 .

# The affine case. Upstream QUDT carries qudt:conversionOffset 273.15 here and
# omits the property entirely on multiplicative units.
unit:DEG_C
    a qudt:Unit ;
    rdfs:label "degree Celsius" ;
    qudt:ucumCode "Cel" ;
    qudt:hasQuantityKind qkind:Temperature ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionOffset 273.15 .
