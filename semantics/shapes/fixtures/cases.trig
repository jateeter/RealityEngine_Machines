# Conformance fixtures for semantics/shapes/re-guardrails.shacl.ttl.
#
# One named graph per case. Each is validated as:
#     re-core.ttl + re-guardrails.shacl.ttl + lane-registry.ttl + <this graph>
# Expected outcomes live in cases.json.
#
# Every runtime that implements the guardrail must reproduce these accept and
# reject decisions exactly. Decision parity is the point: a guardrail four
# runtimes evaluate differently is worse than none, because the multi-engine
# registry lets a caller route around the strict one.

@prefix reg:  <https://realityengine.example.org/ontology/re-guardrails#> .
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix fx:   <https://realityengine.example.org/fixtures/guardrails#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# ACCEPT — ingress
#################################################################

fx:accept-healthkit-measured {
    fx:adm a reg:IngressAdmission ;
        reg:targetLane fx:lane-healthkit-heart-rate ;
        reg:proposedBy fx:source-healthkit-bridge ;
        reg:laneBinding reg:ResolvedFromRegistry ;
        reg:provenanceClass reg:Measured ;
        reg:atOffset 4320 ; reg:writeLength 2 ;
        reg:observedAt "1690000000000"^^xsd:long ;
        reg:receivedAt "1690000001000"^^xsd:long ;
        sosa:madeBySensor fx:source-healthkit-bridge ;
        sosa:hasFeatureOfInterest fx:feature-patient-01 ;
        reg:hasValueAt [ reg:atIndex 0 ; reg:value 72 ] ,
                       [ reg:atIndex 1 ; reg:value 0.95 ] .
}

fx:accept-openclaw-life-safety {
    fx:adm a reg:IngressAdmission ;
        reg:targetLane fx:lane-fall-detection-input ;
        reg:proposedBy fx:source-openclaw-projection ;
        reg:laneBinding reg:ResolvedFromRegistry ;
        reg:provenanceClass reg:Derived ;
        reg:atOffset 3813 ; reg:writeLength 2 ;
        reg:observedAt "1690000000000"^^xsd:long ;
        reg:receivedAt "1690000000500"^^xsd:long ;
        reg:underAutonomy re:Advise ;
        sosa:usedProcedure fx:procedure-risk-model ;
        reg:hasValueAt [ reg:atIndex 0 ; reg:value 3 ] ,
                       [ reg:atIndex 1 ; reg:value 2 ] .
}

fx:accept-ollama-completion {
    fx:adm a reg:IngressAdmission ;
        reg:targetLane fx:lane-agent-completion-risk ;
        reg:proposedBy fx:source-ollama-adapter ;
        reg:laneBinding reg:ResolvedFromRegistry ;
        reg:provenanceClass reg:Inferred ;
        reg:atOffset 4200 ; reg:writeLength 2 ;
        reg:observedAt "1690000000000"^^xsd:long ;
        reg:receivedAt "1690000002000"^^xsd:long ;
        reg:envelopeId "env_456" ;
        reg:correlationId "corr_123" ;
        sosa:usedProcedure fx:procedure-risk-model ;
        reg:hasValueAt [ reg:atIndex 0 ; reg:value 1 ] ,
                       [ reg:atIndex 1 ; reg:value 0.82 ] .
}

