# ACCEPT — egress
#################################################################

fx:accept-egress-red-escalation {
    fx:disp a reg:EgressDispatch ;
        reg:dispatchesAction re:EmergencyDispatch ;
        reg:fromDetermination fx:determination-red ;
        reg:toTarget "pagerduty:patient-safety-tier-1" ;
        reg:envelopeId "env_001" ;
        reg:correlationId "corr_001" ;
        reg:humanApproved true ;
        reg:underAutonomy re:SupervisedAct ;
        reg:dispatchStatus reg:Delivered ;
        reg:governedByBinding fx:binding-supervised .
}

