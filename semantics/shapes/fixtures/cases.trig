        reg:scaleType reg:OrdinalScale ;
        reg:permittedValue 0 , 1 .
}

#################################################################
# REJECT — the lane registry: unit contracts
#################################################################

# The affine trap, caught by QUDT: unit:DEG_C carries a conversion offset, so
# a linear policy would silently drop 273.15.
fx:reject-affine-declared-linear {
    fx:bad-temp-lane a reg:IngressLane ;
        reg:laneId "bad-temp" ;
        reg:laneOffset 9300 ;
        reg:laneLength 1 ;
        reg:permittedProvider "mqtt" ;
        reg:hasAxis fx:bad-temp-axis-0 .

    fx:bad-temp-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "bad_temp" ;
        reg:canonicalUcum "Cel" ; reg:acceptedUcum "Cel" , "K" ;
        reg:quantityKind qkind:Temperature ;
        reg:qudtUnitIri unit:DEG_C ;
        reg:conversionPolicy reg:LinearConversion ;
        reg:scaleType reg:RatioScale ;
        reg:minValue -40 ; reg:maxValue 60 .
}

fx:reject-ordinal-axis-convertible {
    fx:bad-ordinal-lane a reg:IngressLane ;
        reg:laneId "bad-ordinal" ;
        reg:laneOffset 9400 ;
        reg:laneLength 1 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:bad-ordinal-axis-0 .

    fx:bad-ordinal-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "bad_ordinal" ;
        reg:canonicalUcum "1" ; reg:acceptedUcum "1" ;
        reg:quantityKind qkind:Dimensionless ;
        reg:conversionPolicy reg:LinearConversion ;
        reg:scaleType reg:OrdinalScale ;
        reg:permittedValue 0 , 1 .
}

fx:reject-canonical-unit-not-accepted {
    fx:bad-accept-lane a reg:IngressLane ;
        reg:laneId "bad-accept" ;
        reg:laneOffset 9500 ;
        reg:laneLength 1 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:bad-accept-axis-0 .

    fx:bad-accept-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "bad_accept" ;
        reg:canonicalUcum "/min" ; reg:acceptedUcum "1" ;
        reg:quantityKind qkind:Frequency ;
        reg:conversionPolicy reg:LinearConversion ;
        reg:scaleType reg:RatioScale ;
        reg:minValue 0 ; reg:maxValue 300 .
}

fx:reject-quantity-kind-disagreement {
    fx:bad-kind-lane a reg:IngressLane ;
        reg:laneId "bad-kind" ;
        reg:laneOffset 9600 ;
        reg:laneLength 1 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:bad-kind-axis-0 .

    fx:bad-kind-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "bad_kind" ;
        reg:canonicalUcum "Cel" ; reg:acceptedUcum "Cel" ;
        reg:quantityKind qkind:Frequency ;
        reg:qudtUnitIri unit:DEG_C ;
        reg:conversionPolicy reg:AffineConversion ;
        reg:scaleType reg:IntervalScale ;
        reg:minValue -40 ; reg:maxValue 60 .
}

fx:reject-prohibited-axis-multi-unit {
    fx:bad-prohibited-lane a reg:IngressLane ;
        reg:laneId "bad-prohibited" ;
        reg:laneOffset 9700 ;
        reg:laneLength 1 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:bad-prohibited-axis-0 .

    fx:bad-prohibited-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "bad_prohibited" ;
        reg:canonicalUcum "1" ; reg:acceptedUcum "1" , "%" ;
        reg:quantityKind qkind:Dimensionless ;
        reg:conversionPolicy reg:ProhibitedConversion ;
        reg:scaleType reg:OrdinalScale ;
        reg:permittedValue 0 , 1 .
}
