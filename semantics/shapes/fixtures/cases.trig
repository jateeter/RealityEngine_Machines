#################################################################
# REJECT — the lane registry itself
#################################################################

fx:reject-lane-axis-count-mismatch {
    fx:bad-lane a reg:IngressLane ;
        reg:laneId "bad-axis-count" ;
        reg:laneOffset 9000 ;
        reg:laneLength 4 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:bad-axis-0 .

    fx:bad-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ;
        re:axisName "only_axis" ;
        reg:unit "ordinal" ;
        reg:permittedValue 0 , 1 .
}

fx:reject-lane-overlap {
    fx:overlapping-lane a reg:IngressLane ;
        reg:laneId "overlaps-fall-detection" ;
        reg:laneOffset 3814 ;
        reg:laneLength 2 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:ov-axis-0 , fx:ov-axis-1 .

    fx:ov-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "ov_zero" ; reg:unit "ordinal" ; reg:permittedValue 0 , 1 .
    fx:ov-axis-1 a reg:LaneAxis ;
        re:axisIndex 1 ; re:axisName "ov_one" ; reg:unit "ordinal" ; reg:permittedValue 0 , 1 .
}

fx:reject-life-safety-lane-without-floor {
    fx:unfloored-lane a reg:IngressLane ;
        reg:laneId "life-safety-no-floor" ;
        reg:laneOffset 9100 ;
        reg:laneLength 1 ;
        reg:lifeSafetyLane true ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:uf-axis-0 .

    fx:uf-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "uf_zero" ; reg:unit "ordinal" ; reg:permittedValue 0 , 1 .
}

fx:reject-axis-without-unit {
    fx:unitless-lane a reg:IngressLane ;
        reg:laneId "unitless" ;
        reg:laneOffset 9200 ;
        reg:laneLength 1 ;
        reg:permittedProvider "manual" ;
        reg:hasAxis fx:unitless-axis-0 .

    fx:unitless-axis-0 a reg:LaneAxis ;
        re:axisIndex 0 ; re:axisName "unitless_zero" ; reg:permittedValue 0 , 1 .
}
