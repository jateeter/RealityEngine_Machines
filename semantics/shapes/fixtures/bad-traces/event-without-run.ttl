# An event belonging to no run. Merge two such traces and the events cannot be
# told apart, which is what re:TraceRun exists to prevent.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <https://realityengine.example.org/runtime-trace/fixture#> .

t:run
    a owl:NamedIndividual , re:TraceRun ;
    rdfs:label "fixture run" ;
    re:runId "fixture-event-without-run" .

t:orphan
    a owl:NamedIndividual , re:SequenceObservation ;
    rdfs:label "observation belonging to no run" .
