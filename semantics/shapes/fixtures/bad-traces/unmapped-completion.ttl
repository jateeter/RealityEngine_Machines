# A completion write naming no mapping at all. This is the case the OWL axiom
# removed in M2 could not catch, now caught at runtime rather than statically.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <https://realityengine.example.org/runtime-trace/fixture#> .

t:run
    a owl:NamedIndividual , re:TraceRun ;
    rdfs:label "fixture run" ;
    re:runId "fixture-unmapped-completion" .

t:write
    a owl:NamedIndividual , re:SourceMappingWrite ;
    rdfs:label "fixture write with no mapping" ;
    re:writeOffset 4210 ;
    re:writeLength 4 ;
    re:correlationId "fixture-corr-2" ;
    re:inTraceRun t:run .
