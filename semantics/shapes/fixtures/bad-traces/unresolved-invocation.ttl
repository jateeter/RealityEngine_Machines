# An invocation the PE resolved to no allowed operation (no
# re:allowedOperationId), made by the run rather than by a contract probe. The
# PE refused it, correctly; the attempt is still a forbidden-endpoint use, and
# it is caught without the deployment's catalogue.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix t:    <https://realityengine.example.org/runtime-trace/fixture#> .

t:run
    a owl:NamedIndividual , re:TraceRun ;
    rdfs:label "fixture run" ;
    re:runId "fixture-unresolved-invocation" .

t:inv
    a owl:NamedIndividual , re:MCPInvocation ;
    rdfs:label "invocation the PE resolved to no allowed operation" ;
    re:integrationEndpoint "/graphql"^^xsd:anyURI ;
    re:inTraceRun t:run .
