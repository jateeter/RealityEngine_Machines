# One observation recording two determinations. A CES is a regular expression;
# a single traversal reaches one terminal determination, so two is a defect in
# whatever produced the trace.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <https://realityengine.example.org/runtime-trace/fixture#> .
@prefix m:    <https://realityengine.example.org/machines/fixture/Amb#> .

t:run
    a owl:NamedIndividual , re:TraceRun ;
    rdfs:label "fixture run" ;
    re:runId "fixture-ambiguous-determination" .

t:obs
    a owl:NamedIndividual , re:SequenceObservation ;
    rdfs:label "fixture observation with two determinations" ;
    re:recordsDetermination m:out-a , m:out-b ;
    re:inTraceRun t:run .
