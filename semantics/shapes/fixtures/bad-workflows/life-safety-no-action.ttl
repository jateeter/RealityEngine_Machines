# R6 — a life-safety sequence whose determination prescribes nothing at all.
# The purest downgrade: nothing happens, and nothing records that nothing
# happened. Eight real determinations in the corpus are in this shape.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix m:    <https://realityengine.example.org/machines/fixture/LifeSafetyNoAction#> .

m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Fixture — life-safety with no action" ;
    re:hasSequence m:seq .

m:seq
    a owl:NamedIndividual , re:CriticalEventSequence , re:LifeSafetySequence ;
    re:sequenceId "fixture-life-safety" ;
    rdfs:label "fixture life-safety sequence" ;
    re:hasStep m:step .

m:step
    a owl:NamedIndividual , re:SequenceStep ;
    rdfs:label "fixture terminal step" ;
    re:emitsDetermination m:out .

m:out
    a owl:NamedIndividual , re:Determination ;
    rdfs:label "fixture life-safety determination" ;
    re:outputTier 0 ;
    re:outputConfidence 0 .
