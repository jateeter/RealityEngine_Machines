# R1 — a determination prescribing an action the controlled vocabulary does not
# declare. re-core.ttl owns the action vocabulary; an action code invented at
# the machine is one no runtime can map to a consequence class.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix m:    <https://realityengine.example.org/machines/fixture/UnknownAction#> .

m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Fixture — unknown action" ;
    re:hasSequence m:seq .

m:seq
    a owl:NamedIndividual , re:CriticalEventSequence ;
    re:sequenceId "fixture-seq" ;
    rdfs:label "fixture sequence" ;
    re:hasStep m:step .

m:step
    a owl:NamedIndividual , re:SequenceStep ;
    rdfs:label "fixture step" ;
    re:emitsDetermination m:out .

m:out
    a owl:NamedIndividual , re:Determination ;
    rdfs:label "fixture determination" ;
    re:hasRagStatus re:RED ;
    re:prescribesAction re:SummonTheFireBrigade .
