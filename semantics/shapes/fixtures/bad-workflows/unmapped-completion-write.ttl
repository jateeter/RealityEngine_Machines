# R5 — a completion write that names no re:CompletionMapping. This is the case
# the OWL axiom removed in M2 could not catch: under the open world, "no
# asserted mapping" is not "zero mappings", so HermiT classified it as nothing.
@prefix re:   <https://realityengine.example.org/ontology/re-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix m:    <https://realityengine.example.org/machines/fixture/UnmappedWrite#> .

m:machine
    a owl:NamedIndividual , re:Machine ;
    rdfs:label "Fixture — unmapped completion write" .

m:write
    a owl:NamedIndividual , re:SourceMappingWrite ;
    rdfs:label "fixture write with no mapping" ;
    re:forMachine m:machine ;
    re:writeOffset 4200 ;
    re:writeLength 4 ;
    re:correlationId "fixture-corr-1" .
