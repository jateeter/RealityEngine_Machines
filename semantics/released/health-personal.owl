        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PatientSafetyTransportInterconnect#seq-patient-safety-transport-human-review"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PatientSafetyTransportInterconnect#seq-patient-safety-transport-stable-follow-up"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PatientSafetyTransportInterconnect#seq-patient-safety-transport-urgent-dispatch"/>
