        <rdfs:label>sequence id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#severity -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#severity">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>severity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#slaSeconds -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#slaSeconds">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>SLA seconds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#sourceFile -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#sourceFile">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Repo-relative path of the canonical machine JSON this ABox was generated from.</rdfs:comment>
        <rdfs:label>source file</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#sourceOutputLength -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#sourceOutputLength">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>source output length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#sourceOutputOffset -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#sourceOutputOffset">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>source output offset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#stateName -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#stateName">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>state name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#stepIndex -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#stepIndex">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>step index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#symmetric -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#symmetric">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Invariant under permutation of the collection. Recorded as an observed, verified property of this transformation. NOTE: whether symmetry is REQUIRED for a transformation to be admissible is contested and unsettled — see the commentary above this block. Do not read this property as a gate on what may be admitted.</rdfs:comment>
        <rdfs:label>symmetric</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#targetInputLength -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#targetInputLength">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>target input length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#targetInputOffset -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#targetInputOffset">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>target input offset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#targetMachineName -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#targetMachineName">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>target machine name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#tierLabel -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#tierLabel">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>tier label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#transformationName -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#transformationName">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>transformation name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://realityengine.example.org/ontology/re-core#Action -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#Action">
        <rdfs:comment>An action prescribed by a determination. Subclasses stratify actions by consequence so audit rules can be written against the class, not the string.</rdfs:comment>
        <rdfs:label>Action</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#Agent -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#Agent">
        <rdfs:comment>An external reasoning agent that can be dispatched on a machine&apos;s behalf. Identified by re:agentId; grouped by re:AgentFamily.</rdfs:comment>
        <rdfs:label>Agent</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#AgentBinding -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#AgentBinding">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#writesToRegionOf"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#boundAgent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The binding of one agent to one machine: its autonomy mode, the trigger it answers, the actions it is permitted, and the region its response is written back to.</rdfs:comment>
        <rdfs:label>Agent Binding</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#AgentFamily -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#AgentFamily">
        <rdfs:comment>A role-level grouping of agents (for example a care coordinator or a data-centre operations role). Declared per domain by the domain registry&apos;s defaultAgentFamilies and realized by the agents actually bound to machines in that domain.</rdfs:comment>
        <rdfs:label>Agent Family</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#AutomationAction -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#AutomationAction">
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#Action"/>
        <rdfs:comment>Machine-to-machine action with no direct human recipient: bus publication, agent workflow invocation.</rdfs:comment>
        <rdfs:label>Automation Action</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#AutonomyMode -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#AutonomyMode">
        <rdfs:comment>How far a binding may act without a human: observe, advise, supervised-act, or automated-act. Mirrors the enum in schemas/agent-binding.schema.json.</rdfs:comment>
        <rdfs:label>Autonomy Mode</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation">
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation"/>
        <owl:disjointWith rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <rdfs:comment>An output merge transformation defined over {0,1}, stating its truth condition with re:assertedWhen over the count of asserted contributions. Applied to cells carrying values above 1 it flattens them to 1, losing the machine&apos;s alphabet.</rdfs:comment>
        <rdfs:label>Boolean Merge Transformation</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#ChainMergeTransformation -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation">
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation"/>
        <rdfs:comment>An output merge transformation defined over an ordered chain {0..k}, stating its definition with re:mergeFormula. Closed over the chain, so folding a multi-valued machine with one preserves the machine&apos;s alphabet.</rdfs:comment>
        <rdfs:label>Chain Merge Transformation</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#CompletionMapping -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#CompletionMapping">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#completionOfAgent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A PE source mapping that ingests an agent&apos;s completion into the reserved completion band, distinct from the machine&apos;s own input region.</rdfs:comment>
        <rdfs:label>Completion Mapping</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#CriticalEventSequence -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#CriticalEventSequence">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#hasInitialStep"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A multi-step validated pattern (CES) within a machine. A candidate event must traverse the sequence&apos;s steps in order before the terminal determination is emitted.</rdfs:comment>
        <rdfs:label>Critical Event Sequence</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#Determination -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#Determination">
        <rdfs:comment>An output vector emitted when a sequence step completes: the machine&apos;s judgement (tier, confidence, RAG status) plus the action it prescribes.</rdfs:comment>
        <rdfs:label>Determination</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#DispatchRecord -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#DispatchRecord">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment>A ledger entry recording that a determination&apos;s prescribed action was dispatched (trigger fired, bus published, or agent invoked).</rdfs:comment>
        <rdfs:label>Dispatch Record</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#ElementValue -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#ElementValue">
        <rdfs:comment>The required level of a single input element (by index) within a sequence step.</rdfs:comment>
        <rdfs:label>Element Value</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#EscalationAction -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#EscalationAction">
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#Action"/>
        <rdfs:comment>Emergency-path action: pages an on-call responder or dispatches emergency response.</rdfs:comment>
        <rdfs:label>Escalation Action</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#EscalationDetermination -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#EscalationDetermination">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://realityengine.example.org/ontology/re-core#Determination"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#prescribesAction"/>
                        <owl:someValuesFrom rdf:resource="https://realityengine.example.org/ontology/re-core#EscalationAction"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#hasRagStatus"/>
                <owl:hasValue rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Audit invariant: an emergency-path action may only be prescribed by a RED determination.</rdfs:comment>
        <rdfs:label>Escalation Determination</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#GovernancePolicy -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#GovernancePolicy">
        <rdfs:comment>Ownership, runbook, escalation, and SLA metadata governing a machine or an individual trigger rule.</rdfs:comment>
        <rdfs:label>Governance Policy</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#Interconnection -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#Interconnection">
        <rdfs:comment>A published-bus relationship in which one machine&apos;s output region feeds another machine&apos;s input region, usually composed by the Perception Engine.</rdfs:comment>
        <rdfs:label>Interconnection</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#LifeSafetySequence -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#LifeSafetySequence">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#hasStep"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#lifeSafety"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdfs:comment>A critical event sequence whose terminal determination can page emergency response. Verification tooling treats these with the strictest parity requirements.</rdfs:comment>
        <rdfs:label>Life-Safety Sequence</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#LoggingAction -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#LoggingAction">
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#Action"/>
        <rdfs:comment>Record-only action: no human is notified.</rdfs:comment>
        <rdfs:label>Logging Action</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#Machine -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#Machine">
        <rdfs:comment>A canonical RealityEngine machine: a named behavioral contract loaded by RE engines, with a perceptual mapping into the universal reality vector and a set of critical event sequences.</rdfs:comment>
        <rdfs:label>Machine</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#NotificationAction -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#NotificationAction">
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#Action"/>
        <rdfs:comment>A human is informed on a non-emergency channel (caregiver watch, check-in).</rdfs:comment>
        <rdfs:label>Notification Action</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#ObserveBinding -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#ObserveBinding">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#autonomyMode"/>
                <owl:hasValue rdf:resource="https://realityengine.example.org/ontology/re-core#Observe"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#hasSemanticAxis"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Audit invariant: an observe-mode binding writes no element of the reality vector.</rdfs:comment>
        <rdfs:label>Observe Binding</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#OpenClawProjection -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#OpenClawProjection">
        <rdfs:comment>An OpenClaw agent projection that writes machine-native ordinals into the machine&apos;s input region via the Perception Engine.</rdfs:comment>
        <rdfs:label>OpenClaw Projection</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#OutputMergeTransformation -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation">
        <rdfs:comment>An n-input gate folding a machine&apos;s collection of potential outputs into the single output presented to the Perception Engine. Applied to the whole collection at once, not as a chain of two-input gates. (Whether symmetry is required of every admissible transformation is contested — see commentary.)</rdfs:comment>
        <rdfs:label>output merge transformation</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#PerceptionEvent -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#PerceptionEvent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>A PE write into a machine&apos;s input region at a tick. Emitted by the Perception Engine when a source updates the universal reality vector.</rdfs:comment>
        <rdfs:label>Perception Event</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#PerceptualMapping -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#PerceptualMapping">
        <rdfs:comment>The machine&apos;s input and output regions within the universal reality vector.</rdfs:comment>
        <rdfs:label>Perceptual Mapping</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#RagStatus -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#RagStatus">
        <rdfs:comment>Red/Amber/Green status attached to determinations and trigger rules.</rdfs:comment>
        <rdfs:label>RAG Status</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#ResponseMapping -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#ResponseMapping">
        <rdfs:comment>The extraction contract turning an agent&apos;s textual or structured response into element values for the write-back region.</rdfs:comment>
        <rdfs:label>Response Mapping</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#SemanticAxis -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#SemanticAxis">
        <rdfs:comment>The named meaning of one element position within a write-back region — what the value at that index represents. An axis belongs to exactly one region position of one machine.</rdfs:comment>
        <rdfs:label>Semantic Axis</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#SequenceObservation -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#SequenceObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>An RE observation that a critical event sequence advanced to (or completed at) a given step during a tick.</rdfs:comment>
        <rdfs:label>Sequence Observation</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#SequenceStep -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#SequenceStep">
        <rdfs:comment>One state vector within a critical event sequence: the input-element levels that must match at a given tick for the sequence to advance.</rdfs:comment>
        <rdfs:label>Sequence Step</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#TriggerRule -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#TriggerRule">
        <rdfs:comment>A rule from the machine&apos;s triggerConfig that maps a sequence&apos;s terminal output to a process status and RAG code for downstream trigger dispatch.</rdfs:comment>
        <rdfs:label>Trigger Rule</rdfs:label>
    </owl:Class>
    


    <!-- https://realityengine.example.org/ontology/re-core#UnrealizedAgentFamily -->

    <owl:Class rdf:about="https://realityengine.example.org/ontology/re-core#UnrealizedAgentFamily">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://realityengine.example.org/ontology/re-core#AgentFamily"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://realityengine.example.org/ontology/re-core#hasFamilyMember"/>
                        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://realityengine.example.org/ontology/re-core#AgentFamily"/>
        <rdfs:comment>An agent family declared by a domain that no agent belongs to.</rdfs:comment>
        <rdfs:label>Unrealized Agent Family</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
