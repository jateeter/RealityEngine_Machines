        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the transformation this machine folds its potential outputs with. Absent means &quot;or&quot;.</rdfs:comment>
        <rdfs:label>has output merge transformation</rdfs:label>
    </owl:DatatypeProperty>
    


