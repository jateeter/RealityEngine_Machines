    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseMonitor#step-cd-borderline-e1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
        <re:elementIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:elementIndex>
        <re:elementLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.48</re:elementLevel>
        <re:elementThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</re:elementThreshold>
        <rdfs:label>Home Chronic Disease Monitor — cd-borderline element 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseMonitor#step-cd-borderline-e2 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseMonitor#step-cd-borderline-e2">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
