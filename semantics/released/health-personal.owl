    <!-- https://realityengine.example.org/ontology/re-core#merge-and -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-and">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation"/>
        <re:assertedWhen>k = n</re:assertedWhen>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>and</re:transformationName>
        <rdfs:comment>Asserted when every contribution asserts.</rdfs:comment>
        <rdfs:label>and</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-discrete-median -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-discrete-median">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:idempotent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:idempotent>
        <re:mergeFormula>sort(x)[floor((n-1)/2)]</re:mergeFormula>
        <re:requiresChainTop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:requiresChainTop>
        <re:returnsAContributor rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:returnsAContributor>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>discrete-median</re:transformationName>
        <rdfs:comment>Majority consensus, rejecting anomalous outliers — [3,3,0,3] gives 3, filtering the transient dropout. For even n the lower of the two middle elements, which over integers is exactly floor of the median: a selection, never a division, so no float arithmetic enters the step for runtimes to differ over. Takes no chain top.</rdfs:comment>
        <rdfs:label>discrete median</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-join -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-join">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:idempotent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:idempotent>
        <re:mergeFormula>max(x_i)</re:mergeFormula>
        <re:requiresChainTop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:requiresChainTop>
        <re:returnsAContributor rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:returnsAContributor>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>join</re:transformationName>
        <rdfs:comment>Lattice maximum: the envelope. Bounded by the highest contributor, so no completed Reality Event&apos;s severity is lost — the safety-preserving fold. Accepts the chain top as an early-exit optimisation only; the answer is identical without it.</rdfs:comment>
        <rdfs:label>join</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-meet -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-meet">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:idempotent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:idempotent>
        <re:mergeFormula>min(x_i)</re:mergeFormula>
        <re:requiresChainTop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:requiresChainTop>
        <re:returnsAContributor rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:returnsAContributor>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>meet</re:transformationName>
        <rdfs:comment>Lattice minimum: the weakest link. Bounded by the lowest contributor, so a single 0 vetoes the whole collection. Takes no chain top.</rdfs:comment>
        <rdfs:label>meet</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-nand -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-nand">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation"/>
        <re:assertedWhen>k &lt; n</re:assertedWhen>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>nand</re:transformationName>
        <rdfs:comment>Asserted unless every contribution asserts. The n-input gate, not chained two-input NANDs.</rdfs:comment>
        <rdfs:label>nand</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-nor -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-nor">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation"/>
        <re:assertedWhen>k = 0</re:assertedWhen>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>nor</re:transformationName>
        <rdfs:comment>Asserted when no contribution asserts. The n-input gate, not chained two-input NORs.</rdfs:comment>
        <rdfs:label>nor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-or -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-or">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation"/>
        <re:assertedWhen>k &gt;= 1</re:assertedWhen>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>or</re:transformationName>
        <rdfs:comment>Default. Asserted when any contribution asserts.</rdfs:comment>
        <rdfs:label>or</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-strong-conjunction -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-strong-conjunction">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <re:deMorganDualOf rdf:resource="https://realityengine.example.org/ontology/re-core#merge-strong-disjunction"/>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:idempotent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:idempotent>
        <re:mergeFormula>max(0, sum(x_i) - k(n-1))</re:mergeFormula>
        <re:requiresChainTop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:requiresChainTop>
        <re:returnsAContributor rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:returnsAContributor>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>strong-conjunction</re:transformationName>
        <rdfs:comment>Łukasiewicz t-norm ⊙: strict simultaneous onset. Rises above 0 only on near-unanimous high agreement, and one absolute disagreement extinguishes it — on {0..3}, [3,3,2] gives 2 but [3,3,0] gives 0. Non-idempotent by design: x ⊙ x extinguishes.</rdfs:comment>
        <rdfs:label>strong conjunction</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-strong-disjunction -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-strong-disjunction">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <re:deMorganDualOf rdf:resource="https://realityengine.example.org/ontology/re-core#merge-strong-conjunction"/>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:idempotent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:idempotent>
        <re:mergeFormula>min(k, sum(x_i))</re:mergeFormula>
        <re:requiresChainTop rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:requiresChainTop>
        <re:returnsAContributor rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</re:returnsAContributor>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>strong-disjunction</re:transformationName>
        <rdfs:comment>Łukasiewicz t-conorm ⊕: evidence accumulation, saturating at the chain top. Several weak independent indicators combine into a strong one — on {0..3}, 1 ⊕ 1 ⊕ 1 = 3. Non-idempotent by design: x ⊕ x saturates, so a repeated contribution may not be optimised away.</rdfs:comment>
        <rdfs:label>strong disjunction</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/ontology/re-core#merge-xor -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/ontology/re-core#merge-xor">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#BooleanMergeTransformation"/>
        <re:assertedWhen>k odd</re:assertedWhen>
        <re:deterministic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:deterministic>
        <re:symmetric rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:symmetric>
        <re:transformationName>xor</re:transformationName>
        <rdfs:comment>Parity of asserted contributions.</rdfs:comment>
        <rdfs:label>xor</rdfs:label>
    </owl:NamedIndividual>
    


