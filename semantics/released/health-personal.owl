        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#ix-health-personal_patient-safety-transport_social-context"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#ix-health-personal_sleep-recovery-wellness_social-context"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#ix-health-personal_social-isolation-access_social-isolation"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#seq-social-connected-ok"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#seq-social-isolation-risk"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#seq-social-isolation-severe"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#rule-social-connected-ok-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#rule-social-isolation-risk-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeSocialIsolationMonitor#rule-social-isolation-severe-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeSocialIsolationMonitor.json</re:sourceFile>
        <dcterms:description>Integration machine that reads combined output signals from the Home Medication Cost Barrier Monitor [2011:2014] and the Home Transportation Barrier Monitor [2015:2018] to detect social isolation driven by access barriers. For low- and medium-income adults managing chronic conditions at home, the combination of medication cost barriers and transportation failures systematically restricts social participation, community connection, and human contact — accelerating depression, cognitive decline, and self-neglect. Output at [2035:2038] is available to downstream care coordination systems.</dcterms:description>
        <rdfs:label>Home Social Isolation Monitor</rdfs:label>
    </owl:NamedIndividual>
    


