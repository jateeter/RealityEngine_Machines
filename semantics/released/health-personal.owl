    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#rule-chronic-pain-opioid-risk-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
