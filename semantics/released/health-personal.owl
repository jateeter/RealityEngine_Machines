        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-transit-dependent"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-transit-dependent"/>
        <re:sequenceId>transport-transit-dependent-risk</re:sequenceId>
        <rdfs:comment>Fires TRANSIT_DEPENDENT_RISK for patients whose care access depends entirely on unreliable public transit or shared ride programs — a fragile state that one schedule change or route cut can break. Targets rural and low-income urban transit deserts.</rdfs:comment>
        <rdfs:label>Transit Dependency: TRANSIT_DEPENDENT+ → TRANSIT_DEPENDENT_RISK signal</rdfs:label>
    </owl:NamedIndividual>
    


