        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-rapid-decline-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-sustained-alert-community-1"/>
