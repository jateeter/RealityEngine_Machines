    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#seq-hk-vitals-crisis"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#seq-hk-vitals-hypertensive"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#seq-hk-vitals-nominal"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#rule-hk-vitals-crisis-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#rule-hk-vitals-hypertensive-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HealthKitVitalsMonitor#rule-hk-vitals-nominal-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HealthKitVitalsMonitor.json</re:sourceFile>
        <dcterms:description>Classifies blood-pressure family readings delivered by the iOS HealthKit bridge (localHealthkitBridge) into NOMINAL, HYPERTENSIVE, or CRISIS. Reads the canonical bridge region [4320:4323] (systolic/200, diastolic/120, pulse/200, confidence per docs/INGEST_CONTRACT.md) and emits a vitals-status word for downstream health-personal interconnects.</dcterms:description>
        <rdfs:label>HealthKit Vitals Monitor</rdfs:label>
    </owl:NamedIndividual>
    


