    <!-- https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#ix-health-personal_environment-safety-response_adolescent-behavioral-health-status"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#ix-health-personal_pediatric-adolescent-family-support_adolescent-mental-health"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#seq-adolescent-mh-behavioral-concern"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#seq-adolescent-mh-crisis"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#seq-adolescent-mh-ok"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#rule-adolescent-mh-behavioral-concern-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#rule-adolescent-mh-crisis-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/AdolescentMentalHealthMonitor#rule-adolescent-mh-ok-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>risk-forecaster</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/AdolescentMentalHealthMonitor.json</re:sourceFile>
        <dcterms:description>Integration machine that reads combined output signals from the Home Food Security Monitor [1995:1998] and the Home Environment Safety Monitor [1999:2002] to detect adolescent mental health risk driven by co-occurring social adversities. Food insecurity and housing instability are the two most predictive household stressors for adolescent depression, anxiety, and behavioral health crises. Monitors mood indicators, school engagement, risk behavior, and family conflict as 8D integrated input. Output at [2027:2030] is available to downstream care coordination systems.</dcterms:description>
        <rdfs:label>Adolescent Mental Health Monitor</rdfs:label>
    </owl:NamedIndividual>
    


