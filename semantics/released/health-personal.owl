    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#rule-wellness-level1-critical-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#rule-wellness-level1-critical-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PatientWellness#seq-wellness-level1-critical"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,1,0,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>Level 1 — CRITICAL: Mental acuity below age-cohort norm with established decline trend. Immediate clinical evaluation and care plan revision required.</rdfs:comment>
        <rdfs:label>PatientWellness — wellness-level1-critical rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#rule-wellness-level2-alert-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#rule-wellness-level2-alert-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PatientWellness#seq-wellness-level2-alert"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,1,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>Level 2 — ALERT: Multiple wellness deficits (anxiety, stress, exercise) with active decline trend. Care plan review and targeted interventions required.</rdfs:comment>
        <rdfs:label>PatientWellness — wellness-level2-alert rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#rule-wellness-level3-good-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#rule-wellness-level3-good-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
