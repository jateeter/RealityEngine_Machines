        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-adequate"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-adequate"/>
        <re:sequenceId>transport-adequate</re:sequenceId>
        <rdfs:comment>Fires TRANSPORTATION_ADEQUATE when patient has reliable transportation and is attending scheduled care consistently. May reflect personal vehicle, Medicaid NEMT, or stable transit with high attendance history.</rdfs:comment>
        <rdfs:label>Transportation Adequate: ADEQUATE+ → TRANSPORTATION_ADEQUATE signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#seq-transport-critical-failure -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#seq-transport-critical-failure">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-mobile"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-impaired"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-mobile"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#step-tp-strained"/>
        <re:sequenceId>transport-critical-failure</re:sequenceId>
        <rdfs:comment>Tracks progressive transportation access collapse. In rural and low-income urban areas, loss of a vehicle (breakdown, repossession) or transit program changes can instantly eliminate care access for patients dependent on dialysis, oncology, or specialty chronic disease management. The MOBILE+ baseline requires confirmed transportation before collapse can be signaled.</rdfs:comment>
        <rdfs:label>Access Collapse: MOBILE+ → STRAINED → IMPAIRED → CRITICAL_ACCESS_FAILURE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#seq-transport-transit-dependent-risk -->

