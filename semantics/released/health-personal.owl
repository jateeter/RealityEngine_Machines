    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/DailyPatientCare#seq-daily-night-wandering -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/DailyPatientCare#seq-daily-night-wandering">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-nw-settle"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-nw-awake-1"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-nw-awake-2"/>
