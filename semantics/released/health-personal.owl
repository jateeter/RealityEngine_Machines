    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#ix-health-personal_chronic-pain-mental-health-access_mental-health-access"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#ix-health-personal_social-isolation-access_mental-health-access"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-adequate"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-crisis"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-comorbidity-risk"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-referral-needed"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-access-adequate-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-access-crisis-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-comorbidity-risk-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-referral-needed-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeMentalHealthAccessMonitor.json</re:sourceFile>
        <dcterms:description>Integration machine that reads combined output signals from the Home Chronic Disease Monitor [2019:2022] and the Home Chronic Pain Monitor [2023:2026] to detect mental health access needs driven by chronic illness burden. Chronic disease and chronic pain are bidirectionally linked to depression and anxiety — each worsens the other — and low-income patients carrying both have the least access to mental health services. This machine identifies patients who need mental health integration into their medical home care plan. Output at [2039:2042] is available to downstream care coordination systems.</dcterms:description>
        <rdfs:label>Home Mental Health Access Monitor</rdfs:label>
    </owl:NamedIndividual>
    


