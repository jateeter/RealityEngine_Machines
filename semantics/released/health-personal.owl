        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/PatientSafetyTransportInterconnect#rule-patient-safety-transport-urgent-dispatch-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/PatientSafetyTransportInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes fall outcome, transportation access, and social isolation status into the existing care-coordination vector lane. PE owns the source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state and emits to [7378:7381] for downstream health-services, life-balance, and community-service consumers.</dcterms:description>
        <rdfs:label>Patient Safety Transport Interconnect</rdfs:label>
    </owl:NamedIndividual>
    


