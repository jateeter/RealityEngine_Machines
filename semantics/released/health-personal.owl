    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#rule-chronic-pain-crisis-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#seq-chronic-pain-crisis"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
