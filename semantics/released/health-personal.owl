    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-growth-faltering -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-growth-faltering">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-normal"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-declining"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-growth-concern"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-normal"/>
        <re:sequenceId>ped-nut-growth-faltering</re:sequenceId>
        <rdfs:comment>Detects growth trajectory deviation — the most clinically significant pediatric nutrition signal. Two or more consecutive weight/height measurements crossing downward across percentile lines without illness explanation indicate nutritional inadequacy. The NORMAL+ initial state ensures baseline growth data before faltering can be flagged.</rdfs:comment>
        <rdfs:label>Growth Faltering: NORMAL+ → DECLINING → GROWTH_CONCERN → GROWTH_ALERT</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-micronutrient -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-micronutrient">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-sufficient"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-borderline"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-deficient"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-sufficient"/>
        <re:sequenceId>ped-nut-micronutrient</re:sequenceId>
        <rdfs:comment>Tracks micronutrient status decline — iron-deficiency anemia, vitamin D deficiency, and B12 deficiency are highly prevalent in low-income pediatric populations and cause measurable cognitive and developmental impacts. This pattern fires before overt clinical symptoms appear.</rdfs:comment>
        <rdfs:label>Micronutrient Deficiency: SUFFICIENT+ → BORDERLINE → DEFICIENT → MICRONUTRIENT_CONCERN</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-ok -->

