<?xml version="1.0"?>
<rdf:RDF xmlns="https://realityengine.example.org/semantics/health-personal#"
     xml:base="https://realityengine.example.org/semantics/health-personal"
     xmlns:re="https://realityengine.example.org/ontology/re-core#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:semantics="https://realityengine.example.org/semantics#">
    <owl:Ontology rdf:about="https://realityengine.example.org/semantics/health-personal">
        <owl:versionIRI rdf:resource="https://realityengine.example.org/semantics/health-personal/1.0.0+corpus.dad12eb349c4"/>
        <dcterms:description>OWL vocabulary for the semantic representation of RealityEngine machine behavior: machines, critical event sequences, sequence steps, determinations, prescribed actions, trigger rules, governance, interconnections, the agent corpus bound to those machines, and the audit records produced by the PE-&gt;RE-&gt;PE cycle. Machine ABox files under semantics/abox/ are generated from the canonical machine JSON corpus by scripts/generate-owl.py and must stay byte-deterministic.</dcterms:description>
        <dcterms:hasVersion>1.0.0+corpus.dad12eb349c4</dcterms:hasVersion>
        <dcterms:license rdf:resource="https://opensource.org/licenses/MIT"/>
        <dcterms:source>RealityEngine_Machines@1.0.0+corpus.dad12eb349c4</dcterms:source>
        <dcterms:title>RealityEngine Core Semantics Ontology</dcterms:title>
        <rdfs:comment>RealityEngine semantics — health-personal</rdfs:comment>
        <owl:versionInfo>0.3.1</owl:versionInfo>
        <semantics:reportInfoPendingTriage>151</semantics:reportInfoPendingTriage>
        <semantics:reportProfile>semantics/robot-report-profile.txt</semantics:reportProfile>
        <semantics:reportWarnPendingTriage>0</semantics:reportWarnPendingTriage>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/hasVersion -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/hasVersion"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- https://realityengine.example.org/semantics#reportInfoPendingTriage -->

    <owl:AnnotationProperty rdf:about="https://realityengine.example.org/semantics#reportInfoPendingTriage"/>
    


    <!-- https://realityengine.example.org/semantics#reportProfile -->

    <owl:AnnotationProperty rdf:about="https://realityengine.example.org/semantics#reportProfile"/>
    


    <!-- https://realityengine.example.org/semantics#reportWarnPendingTriage -->

    <owl:AnnotationProperty rdf:about="https://realityengine.example.org/semantics#reportWarnPendingTriage"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://realityengine.example.org/ontology/re-core#appliesToSequence -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#appliesToSequence">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdfs:label>applies to sequence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#autonomyMode -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#autonomyMode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#AutonomyMode"/>
        <rdfs:label>autonomy mode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#boundAgent -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#boundAgent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Agent"/>
        <rdfs:label>bound agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#completionOfAgent -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#completionOfAgent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#CompletionMapping"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Agent"/>
        <rdfs:label>completion of agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#deMorganDualOf -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#deMorganDualOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#ChainMergeTransformation"/>
        <rdfs:comment>Each is the other under the chain&apos;s negation, ¬x = k − x. Recorded because it is the cheapest correctness check a runtime has: implement one, derive the other, and a disagreement localises the defect to one of the two.</rdfs:comment>
        <rdfs:label>De Morgan dual of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#declaresAgentFamily -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#declaresAgentFamily">
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#AgentFamily"/>
        <rdfs:comment>A domain declares the families its machines may bind. A family declared but never bound is an unrealized declaration.</rdfs:comment>
        <rdfs:label>declares agent family</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#emitsDetermination -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#emitsDetermination">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <rdfs:label>emits determination</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasAgentBinding -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasAgentBinding">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:label>has agent binding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasCompletionMapping -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasCompletionMapping">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#CompletionMapping"/>
        <rdfs:label>has completion mapping</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasElementValue -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasElementValue">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
        <rdfs:label>has element value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasFamilyMember -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasFamilyMember">
        <owl:inverseOf rdf:resource="https://realityengine.example.org/ontology/re-core#inAgentFamily"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentFamily"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Agent"/>
        <rdfs:label>has family member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasGovernance -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasGovernance">
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#GovernancePolicy"/>
        <rdfs:label>has governance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasInitialStep -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasInitialStep">
        <rdfs:subPropertyOf rdf:resource="https://realityengine.example.org/ontology/re-core#hasStep"/>
        <rdfs:label>has initial step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasInterconnection -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasInterconnection">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <rdfs:label>has interconnection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasNextStep -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasNextStep">
        <rdfs:subPropertyOf rdf:resource="https://realityengine.example.org/ontology/re-core#leadsTo"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:comment>Direct tick-to-tick succession between steps. Each hop is Hamming-distance 1 in well-formed corpora.</rdfs:comment>
        <rdfs:label>has next step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasOpenClawProjection -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasOpenClawProjection">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#OpenClawProjection"/>
        <rdfs:label>has OpenClaw projection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasPerceptualMapping -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasPerceptualMapping">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#PerceptualMapping"/>
        <rdfs:label>has perceptual mapping</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasRagStatus -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasRagStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#RagStatus"/>
        <rdfs:comment>Functional: a determination carries exactly one RAG status. Without this the escalation audit axiom below cannot fail — the reasoner infers the RED it requires and, under open-world semantics, an individual holding both GREEN and RED is not a contradiction.</rdfs:comment>
        <rdfs:label>has RAG status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasResponseMapping -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasResponseMapping">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#ResponseMapping"/>
        <rdfs:label>has response mapping</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasSemanticAxis -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasSemanticAxis">
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#SemanticAxis"/>
        <rdfs:label>has semantic axis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasSequence -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasSequence">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdfs:label>has sequence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasStep -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasStep">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:label>has step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#hasTriggerRule -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#hasTriggerRule">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <rdfs:label>has trigger rule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#inAgentFamily -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#inAgentFamily">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Agent"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#AgentFamily"/>
        <rdfs:label>in agent family</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#leadsTo -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#leadsTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>Transitive closure of hasNextStep; lets a reasoner ask whether a step can reach a terminal determination.</rdfs:comment>
        <rdfs:label>leads to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#maxAutonomy -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#maxAutonomy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#AutonomyMode"/>
        <rdfs:comment>The ceiling the binding&apos;s risk controls impose. re:autonomyMode may not exceed it.</rdfs:comment>
        <rdfs:label>maximum autonomy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#observedSequence -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#observedSequence">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceObservation"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdfs:label>observed sequence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#observedStep -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#observedStep">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceObservation"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <rdfs:label>observed step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#prescribesAction -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#prescribesAction">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Action"/>
        <rdfs:label>prescribes action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#recordsDetermination -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#recordsDetermination">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#DispatchRecord"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <rdfs:label>records determination</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#sourceMachine -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#sourceMachine">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:label>source machine</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#targetsMachine -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#targetsMachine">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#PerceptionEvent"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:label>targets machine</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#writesToRegionOf -->

    <owl:ObjectProperty rdf:about="https://realityengine.example.org/ontology/re-core#writesToRegionOf">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:comment>The machine whose region receives the binding&apos;s write-back. For the assessment axis this is the bound machine itself.</rdfs:comment>
        <rdfs:label>writes to region of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://realityengine.example.org/ontology/re-core#actionCode -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#actionCode">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The literal action string used in machine JSON output metadata.</rdfs:comment>
        <rdfs:label>action code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#actionNarrative -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#actionNarrative">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The original free-text action prose preserved when the machine JSON action was normalized to a controlled code (see scripts/backfill-action-codes.py).</rdfs:comment>
        <rdfs:label>action narrative</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#agentFamilyName -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#agentFamilyName">
