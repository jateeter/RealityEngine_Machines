        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Comma-joined value vector over the machine&apos;s output region, in cell order.</rdfs:comment>
        <rdfs:label>output match vector</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#outputMergeTransformation -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#outputMergeTransformation">
