    <!-- https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-sustained-instability-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-sustained-instability-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
