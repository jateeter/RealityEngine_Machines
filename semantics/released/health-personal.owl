        <re:targetInputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4480</re:targetInputOffset>
        <re:targetMachineName>Daily Patient Care Response Interconnect</re:targetMachineName>
        <rdfs:comment>Publish fall criticality into the personal-health daily patient care response bus.</rdfs:comment>
        <rdfs:label>Fall Detection — fall_criticality</rdfs:label>
