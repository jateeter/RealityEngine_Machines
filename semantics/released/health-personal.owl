        <re:hasSemanticAxis rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#axis-1"/>
        <re:hasSemanticAxis rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#axis-2"/>
