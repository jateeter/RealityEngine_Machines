    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-access-adequate-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-access-adequate-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-adequate"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#GREEN"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,1</re:outputMatchVector>
        <re:processStatus>info</re:processStatus>
        <rdfs:comment>MH_ACCESS_ADEQUATE: chronic illness managed; mental health comorbidity risk low; no access gap at [2039:2042]</rdfs:comment>
        <rdfs:label>Home Mental Health Access Monitor — mh-access-adequate rule 1 (GREEN)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-access-crisis-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-access-crisis-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-crisis"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:matchesOutputPosition>
        <re:outputMatchVector>1,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>MENTAL_HEALTH_CRISIS: dual chronic illness crisis driving acute mental health decompensation at [2039:2042]</rdfs:comment>
        <rdfs:label>Home Mental Health Access Monitor — mh-access-crisis rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-comorbidity-risk-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-comorbidity-risk-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-comorbidity-risk"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,1,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>COMORBIDITY_RISK: chronic disease or pain burden is degrading mental health resilience but has not reached referral/crisis threshold at [2039:2042]</rdfs:comment>
        <rdfs:label>Home Mental Health Access Monitor — mh-comorbidity-risk rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-referral-needed-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#rule-mh-referral-needed-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-referral-needed"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:matchesOutputPosition>
        <re:outputMatchVector>0,1,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>MH_REFERRAL_NEEDED: chronic illness burden driving mental health comorbidity requiring behavioral health integration at [2039:2042]</rdfs:comment>
        <rdfs:label>Home Mental Health Access Monitor — mh-referral-needed rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-adequate -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-adequate">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-supported"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-supported"/>
        <re:sequenceId>mh-access-adequate</re:sequenceId>
        <rdfs:comment>Fires MH_ACCESS_ADEQUATE when chronic illness burden is managed and mental health access or coping is adequate. Confirms that the chronic illness-mental health comorbidity loop is not active and current care coordination is sufficient.</rdfs:comment>
        <rdfs:label>MH Access Adequate: SUPPORTED+ → MH_ACCESS_ADEQUATE signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-crisis -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-access-crisis">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-stable"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-deteriorating"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-distressed"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-stable"/>
        <re:sequenceId>mh-access-crisis</re:sequenceId>
        <rdfs:comment>Tracks mental health deterioration driven by dual chronic illness burden — simultaneous disease exacerbation and pain crisis produce the highest depression and suicidality risk in home care populations. The bidirectional relationship means physical crisis accelerates mental health crisis and vice versa. Requires STABLE+ baseline before the crisis escalation arm can activate.</rdfs:comment>
        <rdfs:label>MH Crisis: STABLE+ → DISTRESSED → MH_DETERIORATING → MENTAL_HEALTH_CRISIS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-comorbidity-risk -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-comorbidity-risk">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-comorbidity-risk-state"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-comorbidity-risk-state"/>
        <re:sequenceId>mh-comorbidity-risk</re:sequenceId>
        <rdfs:comment>Fires COMORBIDITY_RISK when chronic disease burden and chronic pain impairment are co-present but not yet severe enough for referral/crisis. This preserves the declared output lane [0,0,1,0] and gives PE a lower-acuity fan-out signal.</rdfs:comment>
        <rdfs:label>Comorbidity Risk: SUBCLINICAL_COMORBIDITY+ -&gt; COMORBIDITY_RISK signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-referral-needed -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#seq-mh-referral-needed">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-comorbid"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMentalHealthAccessMonitor#step-mh-comorbid"/>
        <re:sequenceId>mh-referral-needed</re:sequenceId>
        <rdfs:comment>Fires MH_REFERRAL_NEEDED when one upstream machine is in exacerbation/crisis and the other is in poor control/impairment — the most common unaddressed mental health comorbidity state in home care. Identifies the patient population where integrated behavioral health in medical care would prevent escalation to crisis.</rdfs:comment>
        <rdfs:label>MH Referral: COMORBID+ → MH_REFERRAL_NEEDED signal</rdfs:label>
    </owl:NamedIndividual>
    


