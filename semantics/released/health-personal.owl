        <re:sequenceId>daily-patient-care-routine-recovery</re:sequenceId>
        <rdfs:comment>Daily routine is disrupted by bathroom non-use, wandering, hygiene concern, wellness concern, or hydration stress below urgent threshold.</rdfs:comment>
        <rdfs:label>Bathroom/wandering/hygiene/wellness alerts -&gt; care routine recovery</rdfs:label>
    </owl:NamedIndividual>
    


