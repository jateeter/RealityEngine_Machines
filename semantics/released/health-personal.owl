        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-delay-escalation"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-on-track"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-social-concern"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#rule-child-dev-delay-escalation-1"/>
