        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Where the name came from: sensor-normalization, input-semantics, or openclaw-projection. Records provenance so a disagreement can be adjudicated rather than merely detected.</rdfs:comment>
        <rdfs:label>axis name source</rdfs:label>
    </owl:DatatypeProperty>
    


