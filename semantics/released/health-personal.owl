        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/PatientWellness.json</re:sourceFile>
        <dcterms:description>Holistic wellness monitoring for assisted living residents across six dimensions: mental acuity, anxiety, stress, socialization, nutrition, and exercise. Produces a four-level wellness metric (OPTIMAL / GOOD / ALERT / CRITICAL) routed into the perceptual resolution space for longitudinal tracking and intervention planning. Sequences are calibrated to age-group norms for the 65-74, 75-84, and 85+ cohorts.</dcterms:description>
        <rdfs:label>PatientWellness</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#openclaw-binding -->

