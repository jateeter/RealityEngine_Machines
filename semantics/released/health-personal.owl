    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#governance"/>
