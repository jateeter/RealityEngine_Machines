        <re:processStatus>info</re:processStatus>
        <rdfs:comment>WEEKLY_COMPLETE — full weekly deep-clean completed with no concerns. All dimensions (hygiene, safety, nutrition, patient observation) within norms.</rdfs:comment>
        <rdfs:label>FacilitiesMaintenance — maint-weekly-deep-clean rule 1 (GREEN)</rdfs:label>
    </owl:NamedIndividual>
    


