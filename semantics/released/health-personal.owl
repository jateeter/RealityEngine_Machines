        <rdfs:comment>Alert: FALL_CONFIRMED — patient fell and activated call system; staff response required immediately</rdfs:comment>
        <rdfs:label>DailyPatientCare — daily-fall-response rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


