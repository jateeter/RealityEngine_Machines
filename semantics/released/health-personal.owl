    <!-- https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#seq-chronic-pain-mh-integrated-referral"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#seq-chronic-pain-mh-managed-monitoring"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#seq-chronic-pain-mh-opioid-safety-review"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#seq-chronic-pain-mh-urgent-behavioral-health-response"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#rule-chronic-pain-mh-integrated-referral-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#rule-chronic-pain-mh-managed-monitoring-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#rule-chronic-pain-mh-opioid-safety-review-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMentalHealthAccessInterconnect#rule-chronic-pain-mh-urgent-behavioral-health-response-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeChronicPainMentalHealthAccessInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes chronic disease burden, chronic pain burden, and mental-health access status into a compact fan-out lane for behavioral health integration, opioid safety review, and managed monitoring. PE owns source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state.</dcterms:description>
        <rdfs:label>Chronic Pain Mental Health Access Interconnect</rdfs:label>
    </owl:NamedIndividual>
    


