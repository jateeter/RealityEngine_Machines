        <rdfs:comment>Quiescent — no motion samples above threshold this tick.</rdfs:comment>
        <rdfs:label>Fall Sensor Motion Pre-aggregator — motion-none rule 1 (GREEN)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#rule-motion-severe-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#rule-motion-severe-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
