        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#seq-chronic-disease-access-adherence-support"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#seq-chronic-disease-preventive-intensification"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#seq-chronic-disease-stable-monitoring"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#seq-chronic-disease-urgent-response"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#rule-chronic-disease-access-adherence-support-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#rule-chronic-disease-preventive-intensification-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#rule-chronic-disease-stable-monitoring-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseResponseInterconnect#rule-chronic-disease-urgent-response-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeChronicDiseaseResponseInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes chronic disease control, medication access, transportation access, food security, and activity tolerance into a compact fan-out lane for urgent disease response, access/adherence support, preventive intensification, and stable monitoring. PE owns source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state.</dcterms:description>
        <rdfs:label>Home Chronic Disease Response Interconnect</rdfs:label>
    </owl:NamedIndividual>
    


