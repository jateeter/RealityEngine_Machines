    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#seq-motion-brief"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#seq-motion-none"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#seq-motion-severe"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#seq-motion-sustained"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#rule-motion-brief-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#rule-motion-none-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#rule-motion-severe-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallSensorMotionPreaggregator#rule-motion-sustained-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>sensor-preaggregator</re:machineClass>
        <re:outputMergeTransformation>join</re:outputMergeTransformation>
        <re:sourceFile>machines/domains/health-personal/FallSensorMotionPreaggregator.json</re:sourceFile>
        <dcterms:description>Lifts the previously prose-only sensor pre-aggregation contract from FallDetection.metadata.designNotes into an executable CES.  Input is a raw active-sample count per tick (typically derived by the wearable firmware from a window of accelerometer samples whose magnitude exceeds a motion threshold).  Output is the motion-progression ordinal (0=none, 1=brief, 2=sustained, 3=severe) that FallDetection&apos;s motion-channel input region expects.  The wearable firmware is testable against this CES — given the same raw count, both the firmware and the engine must classify into the same ordinal.</dcterms:description>
        <rdfs:label>Fall Sensor Motion Pre-aggregator</rdfs:label>
    </owl:NamedIndividual>
    


