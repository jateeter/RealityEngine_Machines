        <re:sourceOutputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</re:sourceOutputOffset>
        <re:targetMachineName>Chronic Pain Mental Health Access Interconnect</re:targetMachineName>
        <rdfs:comment>Publish chronic pain burden into the personal-health chronic-pain mental-health access bus.</rdfs:comment>
        <rdfs:label>Home Chronic Pain Monitor — pain_burden</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#ix-health-personal_chronic-pain-mental-health-access_pain-burden"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#seq-chronic-pain-crisis"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#seq-chronic-pain-functional-impairment"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#seq-chronic-pain-managed-ok"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#seq-chronic-pain-opioid-risk"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#rule-chronic-pain-crisis-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#rule-chronic-pain-functional-impairment-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#rule-chronic-pain-managed-ok-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicPainMonitor#rule-chronic-pain-opioid-risk-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>risk-forecaster</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeChronicPainMonitor.json</re:sourceFile>
        <dcterms:description>Monitors pain intensity, functional impairment, opioid risk indicators, and physical activity for adults managing chronic pain at home in low- and medium-income settings. Chronic pain is disproportionately prevalent in low-income populations due to occupational injury, inadequate early treatment, and limited access to non-pharmacological interventions. Unmanaged chronic pain is a primary driver of depression and social isolation. Output at [2023:2026] feeds the Home Mental Health Access Monitor alongside the Chronic Disease Monitor.</dcterms:description>
        <rdfs:label>Home Chronic Pain Monitor</rdfs:label>
    </owl:NamedIndividual>
    


