        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-thriving"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-thriving"/>
        <re:sequenceId>ped-nut-ok</re:sequenceId>
        <rdfs:comment>Fires NUTRITION_OK when all four nutrition dimensions are above adequate thresholds. In low-income settings this represents successful outcome of WIC participation, food bank access, or community nutrition programs.</rdfs:comment>
        <rdfs:label>Nutrition OK: THRIVING+ → NUTRITION_OK signal</rdfs:label>
    </owl:NamedIndividual>
    


