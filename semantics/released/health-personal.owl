        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-fu-post-fall-still"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-fu-rise"/>
        <re:sequenceId>daily-fall-unresponsive</re:sequenceId>
