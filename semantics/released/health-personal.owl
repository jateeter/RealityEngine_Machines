        <re:hasSemanticAxis rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#axis-7"/>
        <re:writesToRegionOf rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#machine"/>
        <rdfs:label>WellnessAnalytics — openclaw-input-analyst projection binding</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#openclaw-projection -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#openclaw-projection">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#OpenClawProjection"/>
        <re:sourceMachine rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#machine"/>
        <re:dispatchMode>accepted-no-wait</re:dispatchMode>
        <re:projectionId>openclaw-wellness-analytics-native-input-projection</re:projectionId>
        <re:targetInputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:targetInputLength>
        <re:targetInputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3931</re:targetInputOffset>
        <rdfs:comment>OpenClaw maps wellness observations to the native WellnessAnalytics input vector only when bypassing deterministic PatientWellness output; PE writes the source and does not wait inside a PE cycle.</rdfs:comment>
        <rdfs:label>WellnessAnalytics — openclaw-wellness-analytics-native-input-projection</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-inflow-evaluation -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-inflow-evaluation">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#RouteReferral"/>
        <re:actionNarrative>Initiate NewPatientInflow evaluation. Schedule intake appointment. Inform family of evaluation recommendation. Begin prescreening checklist. Patient retains full autonomy — evaluation is a recommendation, not a mandate.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputTier>
        <rdfs:label>WellnessAnalytics — out-inflow-evaluation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-inflow-urgent -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-inflow-urgent">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Initiate urgent NewPatientInflow evaluation. Notify family immediately. Physician or NP assessment within 24 hours to assess for concurrent clinical emergency. If life-threatening condition present: activate CareTransitionWorkflow Scenario 1 first, then INFLOW_URGENT upon stabilization.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>WellnessAnalytics — out-inflow-urgent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-transition-escalation -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-transition-escalation">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Notify attending physician immediately. Activate CareTransitionWorkflow Sequence 5 (emergency escalation). Assess for reversible CRITICAL causes (UTI, dehydration, medication toxicity, acute depression) before activating hospital transfer — if reversible cause identified and treatable in facility, physician may elect to treat in place and re-assess. Family notification mandatory within 24 hours.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>WellnessAnalytics — out-transition-escalation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-transition-review -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-transition-review">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#ScheduleCareReview"/>
        <re:actionNarrative>Convene interdisciplinary team meeting within 5 days. Assess whether current facility level of care can address identified wellness deficits with care plan modification, or whether a higher level of care (SNF, memory care, hospital) is clinically indicated. Initiate CareTransitionWorkflow planned transition sequences if care level change is warranted.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>WellnessAnalytics — out-transition-review</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-transition-urgent -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-transition-urgent">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Physician or NP assessment within 24 hours. Investigate cause of rapid decline: new diagnosis, medication change, acute illness, environmental disruption, significant loss event. If clinical cause identified and reversible in current setting: treat in place and re-assess at next cycle. If cause requires higher level of care: activate CareTransitionWorkflow planned or emergency transition. Do not wait for Sequence 3 two-cycle confirmation — TRANSITION_URGENT is the velocity-triggered parallel path.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>WellnessAnalytics — out-transition-urgent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-wellness-improving -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#out-out-wellness-improving">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#NotifyCareTeam"/>
        <re:actionNarrative>Notify care team of wellness improvement. Do NOT cancel any pending TRANSITION_REVIEW meetings — confirm recovery holds at next assessment cycle before closing the ALERT episode. Document which interventions correlated with the improvement. Maintain increased monitoring frequency for 2 more cycles. If recovery is confirmed at next cycle, de-escalate to standard bi-weekly monitoring.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>WellnessAnalytics — out-wellness-improving</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#perceptual-mapping -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#perceptual-mapping">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#PerceptualMapping"/>
        <re:bitsPerElement rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:bitsPerElement>
        <re:inputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:inputLength>
        <re:inputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3931</re:inputOffset>
        <re:outputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:outputLength>
        <re:outputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3939</re:outputOffset>
        <rdfs:label>WellnessAnalytics — WellnessAnalytics mapping in[3931:3939] out[3939:3947]</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-critical-community-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-critical-community-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-critical-community"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:matchesOutputPosition>
        <re:outputMatchVector>0,1,0,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>INFLOW_URGENT — CRITICAL wellness in community-dwelling patient; initiate urgent NewPatientInflow evaluation with accelerated timeline</rdfs:comment>
        <rdfs:label>WellnessAnalytics — wa-critical-community rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-critical-facility-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-critical-facility-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-critical-facility"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,1,0,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>TRANSITION_ESCALATION — CRITICAL wellness in facility resident; activate CareTransitionWorkflow emergency escalation to hospital</rdfs:comment>
        <rdfs:label>WellnessAnalytics — wa-critical-facility rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-rapid-decline-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-rapid-decline-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-rapid-decline"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,0,1,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>TRANSITION_URGENT — rapid 2-level wellness decline in facility resident; initiate priority care level review without waiting for two-cycle confirmation</rdfs:comment>
        <rdfs:label>WellnessAnalytics — wa-rapid-decline rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-sustained-alert-community-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-sustained-alert-community-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-sustained-alert-community"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:matchesOutputPosition>
        <re:outputMatchVector>1,0,0,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>INFLOW_EVALUATION — sustained ALERT in community-dwelling patient; initiate NewPatientInflow standard evaluation sequence</rdfs:comment>
        <rdfs:label>WellnessAnalytics — wa-sustained-alert-community rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-sustained-alert-facility-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-sustained-alert-facility-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-sustained-alert-facility"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,1,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>TRANSITION_REVIEW — sustained ALERT in facility resident; activate CareTransitionWorkflow for care level review</rdfs:comment>
        <rdfs:label>WellnessAnalytics — wa-sustained-alert-facility rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-wellness-improving-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-wellness-improving-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-wellness-improving"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,0,0,1,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>WELLNESS_IMPROVING — facility resident returning to GOOD level after ALERT; no care escalation required; care team notified of recovery</rdfs:comment>
        <rdfs:label>WellnessAnalytics — wa-wellness-improving rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-critical-community -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-critical-community">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-critical"/>
        <re:sequenceId>wa-critical-community</re:sequenceId>
        <rdfs:comment>A community-dwelling patient has reached CRITICAL wellness level — mental acuity below age-cohort norm with confirmed longitudinal decline trend. CRITICAL in a community resident indicates immediate risk: the patient cannot safely manage independent living and requires urgent placement evaluation, potentially concurrent with emergency clinical evaluation.</rdfs:comment>
        <rdfs:label>CRITICAL Level — Community Resident → Urgent NewPatientInflow</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-critical-facility -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-critical-facility">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cf-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cf-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cf-critical"/>
        <re:sequenceId>wa-critical-facility</re:sequenceId>
        <rdfs:comment>An ALF or SNF resident has reached CRITICAL wellness level — mental acuity below age-cohort norm with confirmed longitudinal decline trend. CRITICAL in a facility resident indicates the current care environment is not sufficient and emergency care transition is required. Routes to CareTransitionWorkflow emergency escalation (Sequence 5).</rdfs:comment>
        <rdfs:label>CRITICAL Level — Facility Resident → Emergency Care Transition</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-rapid-decline -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-rapid-decline">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-rd-good"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-rd-alert-rapid"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-rd-good"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-rd-velocity"/>
        <re:sequenceId>wa-rapid-decline</re:sequenceId>
        <rdfs:comment>A facility resident&apos;s wellness level drops two or more steps in a single assessment cycle — a velocity-based anomaly that bypasses the sustained-pattern requirement. The rapid decline signal fires an urgent care transition review before the two-cycle confirmation period that Sequence 3 requires, acknowledging that a sudden large drop is an immediate clinical signal.</rdfs:comment>
        <rdfs:label>Rapid Decline — Facility Resident → Urgent Care Transition</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-sustained-alert-community -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-sustained-alert-community">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-sac-good"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-sac-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-sac-alert-repeat"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-sac-good"/>
        <re:sequenceId>wa-sustained-alert-community</re:sequenceId>
        <rdfs:comment>A community-dwelling patient has been at ALERT wellness level for two or more consecutive bi-weekly assessment cycles. Sustained multi-dimension wellness deficit while living independently — the clinical signal that assisted living evaluation is appropriate. Routes to NewPatientInflow for standard intake evaluation.</rdfs:comment>
        <rdfs:label>Sustained ALERT — Community Resident → NewPatientInflow Evaluation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-sustained-alert-facility -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-sustained-alert-facility">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-saf-good"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-saf-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-saf-alert-repeat"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-saf-good"/>
        <re:sequenceId>wa-sustained-alert-facility</re:sequenceId>
        <rdfs:comment>An ALF or SNF resident has been at ALERT wellness level for two or more consecutive assessment cycles. Sustained deterioration within the current care level setting suggests the facility may no longer be meeting the patient&apos;s care needs. Routes to CareTransitionWorkflow for care level review.</rdfs:comment>
        <rdfs:label>Sustained ALERT — Facility Resident → Care Transition Review</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-wellness-improving -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#seq-wa-wellness-improving">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-wi-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-wi-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-wi-stabilizing"/>
        <re:sequenceId>wa-wellness-improving</re:sequenceId>
        <rdfs:comment>A facility resident who has been at ALERT level returns to GOOD wellness — improvement detected. No downstream machine activation. This is a positive outcome signal indicating that prior care plan interventions were effective. The care team is notified to continue monitoring for two more cycles to confirm the recovery is sustained before closing the ALERT episode.</rdfs:comment>
        <rdfs:label>Wellness Recovery — Facility Resident Returning to GOOD Level</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#SequenceStep"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e0"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e1"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e2"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e3"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e4"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e5"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e6"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-alert-e7"/>
        <re:hasNextStep rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#step-cc-critical"/>
