    <!-- https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-hazard-escalation -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-hazard-escalation">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-sound"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-deteriorating"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-hazardous"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-sound"/>
        <re:sequenceId>home-env-hazard-escalation</re:sequenceId>
        <rdfs:comment>Tracks progressive housing condition deterioration from sound baseline through hazardous conditions. Sustained deterioration across multiple housing dimensions (temp + structural + air quality) escalates to UNSAFE_HOUSING, indicating conditions that drive health outcomes worse than chronic illness alone.</rdfs:comment>
        <rdfs:label>Hazard Escalation: SOUND+ → DETERIORATING → HAZARDOUS → UNSAFE_HOUSING</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-health-hazard-risk -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-health-hazard-risk">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-health-hazard-risk"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-health-hazard-risk"/>
        <re:sequenceId>home-env-health-hazard-risk</re:sequenceId>
        <rdfs:comment>Fires HEALTH_HAZARD_RISK when air quality, structural, temperature, or utility conditions are degraded enough to affect health but not yet in acute unsafe-housing or utility-failure crisis.</rdfs:comment>
        <rdfs:label>Health Hazard Risk: HAZARD_PRESENT+ -&gt; HEALTH_HAZARD_RISK signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-safe -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-safe">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-safe"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-safe"/>
        <re:sequenceId>home-env-safe</re:sequenceId>
        <rdfs:comment>Fires ENVIRONMENT_SAFE when all housing dimensions are within safe operating parameters. Downstream adolescent mental health monitor uses this signal as a baseline stable-environment indicator.</rdfs:comment>
        <rdfs:label>Environment Safe: SAFE+ → ENVIRONMENT_SAFE signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-utility-failure -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-utility-failure">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-utility-current"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-past-due"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-shutoff-risk"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#step-henv-utility-current"/>
        <re:sequenceId>home-env-utility-failure</re:sequenceId>
        <rdfs:comment>Tracks utility payment status deterioration toward shutoff. In low-income households, utility shutoffs directly cause health crises (hypothermia risk, medication spoilage, food loss). Requires CURRENT+ baseline before escalation arms, preventing false triggers from billing cycle gaps.</rdfs:comment>
        <rdfs:label>Utility Failure: CURRENT+ → PAST_DUE → SHUTOFF_RISK → UTILITY_FAILURE</rdfs:label>
    </owl:NamedIndividual>
    


