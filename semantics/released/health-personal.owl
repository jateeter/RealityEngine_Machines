        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/MedicationAdherenceMonitor#seq-med-missed"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/MedicationAdherenceMonitor#seq-med-taken-on-time"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/MedicationAdherenceMonitor#rule-med-delayed-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/MedicationAdherenceMonitor#rule-med-missed-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/MedicationAdherenceMonitor#rule-med-taken-on-time-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/MedicationAdherenceMonitor.json</re:sourceFile>
        <dcterms:description>Tracks whether scheduled medication doses are acknowledged within the allotted window. Signals the local AI to trigger reminders, caregiver alerts, or clinical follow-up when doses are delayed or missed outright.</dcterms:description>
        <rdfs:label>Medication Adherence Monitor</rdfs:label>
    </owl:NamedIndividual>
    


