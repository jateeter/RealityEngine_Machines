    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#ix-health-personal_child-development-support_pediatric-nutrition-status"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#ix-health-personal_pediatric-adolescent-family-support_pediatric-nutrition"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-growth-faltering"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-micronutrient"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#seq-ped-nut-ok"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#rule-ped-nut-growth-faltering-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#rule-ped-nut-micronutrient-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#rule-ped-nut-ok-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/PediatricNutritionMonitor.json</re:sourceFile>
        <dcterms:description>Tracks child nutrition adequacy, growth trajectory, and micronutrient status for children ages 0–12 in low- and medium-income home settings. Monitors growth percentile trends, caloric adequacy, iron/vitamin D/B12 micronutrient balance, and dietary diversity — the four dimensions most predictive of developmental outcomes in under-resourced households. Output at [2003:2006] feeds the Home Caregiver Burden Monitor, as child nutritional problems are a primary driver of caregiver stress and care coordination demand.</dcterms:description>
        <rdfs:label>Pediatric Nutrition Monitor</rdfs:label>
    </owl:NamedIndividual>
    


