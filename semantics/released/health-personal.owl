    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeMedicationCostBarrierMonitor#step-med-adherent-e3 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMedicationCostBarrierMonitor#step-med-adherent-e3">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
        <re:elementIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</re:elementIndex>
