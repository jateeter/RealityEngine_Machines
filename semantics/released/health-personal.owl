        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#RouteReferral"/>
        <re:actionNarrative>ORT/DIRE risk re-screening; physician medication review; urine drug screen; PDMP check; non-opioid alternative assessment</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>Home Chronic Pain Monitor — cp-opioid-risk-output</rdfs:label>
    </owl:NamedIndividual>
    


