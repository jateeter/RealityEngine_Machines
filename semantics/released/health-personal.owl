        <re:targetInputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:targetInputLength>
        <re:targetInputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3939</re:targetInputOffset>
        <re:targetMachineName>CareTransitionWorkflow</re:targetMachineName>
        <rdfs:comment>Use transportation, housing, and local navigation state to refine transition-readiness.</rdfs:comment>
        <rdfs:label>CareTransitionWorkflow — care_transition_context</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#ix-health-personal_care-transition-response_transition-outcome"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#ix-health-personal_intake-wellness-routing_care-transition"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#ix-health_infrastructure-support_consumer_care_transition_context"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-acute-emergency"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-blocked"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-emergency-escalation"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-hospital-to-rehab"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-rehab-to-alf"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-acute-emergency-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-blocked-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-emergency-escalation-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-hospital-to-rehab-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-rehab-to-alf-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>risk-forecaster</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:severity>life-safety</re:severity>
        <re:sourceFile>machines/domains/health-personal/CareTransitionWorkflow.json</re:sourceFile>
        <dcterms:description>Models patient readiness for changes in living situation across three care transition scenarios: (1) non-assisted home/community living to acute hospital admission for life-threatening conditions; (2) acute hospital discharge to a rehabilitation facility as a transitional environment; (3) rehabilitation facility discharge to assisted living for the next phase of life. Produces transition-specific readiness outputs with embedded external communication requirements.</dcterms:description>
        <rdfs:label>CareTransitionWorkflow</rdfs:label>
    </owl:NamedIndividual>
    


