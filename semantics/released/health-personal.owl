        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#seq-fall-sustained-instability"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-confirmed-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-impact-recovered-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-intentional-lying-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-nominal-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-slow-collapse-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-stumble-recovered-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#rule-fall-sustained-instability-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:outputMergeTransformation>join</re:outputMergeTransformation>
        <re:severity>life-safety</re:severity>
        <re:sourceFile>machines/domains/health-personal/FallDetection.json</re:sourceFile>
        <dcterms:description>Resilient fall classifier. Each candidate fall must survive a multi-step critical event sequence that validates duration AND impact strength before a determination is broadcast to listeners. RED (emergency dispatch) requires six consecutive ticks of progressive evidence: motion onset → sustained motion → severe motion → post-impact stillness onset → sustained stillness → very-sustained stillness. AMBER tiers report less-certain patterns (recovered stumbles, recovered impacts, sustained instability) without escalating to emergency.</dcterms:description>
        <rdfs:label>Fall Detection</rdfs:label>
    </owl:NamedIndividual>
    


