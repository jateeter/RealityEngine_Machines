        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#rule-child-dev-social-concern-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>risk-forecaster</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/ChildDevelopmentMonitor.json</re:sourceFile>
        <dcterms:description>Tracks developmental milestone progress, social-emotional engagement, language acquisition, and learning readiness for children ages 0–12 in low- and medium-income home care settings. Early identification of developmental delays in economically vulnerable households is critical because access to early intervention services (EI, speech therapy, occupational therapy) is income- and geography-dependent. Output at [2007:2010] feeds the Home Caregiver Burden Monitor alongside the Pediatric Nutrition Monitor.</dcterms:description>
        <rdfs:label>Child Development Monitor</rdfs:label>
    </owl:NamedIndividual>
    


