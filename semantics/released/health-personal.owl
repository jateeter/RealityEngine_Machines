        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,0,0,1</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>INACCESSIBILITY_ALERT — unit inaccessible after multiple attempts by facilities staff. Welfare check protocol activated. Potential downstream: CareTransitionWorkflow emergency sequences.</rdfs:comment>
        <rdfs:label>FacilitiesMaintenance — maint-inaccessible rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-safety-concern-1 -->

