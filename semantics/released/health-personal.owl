        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/WellnessAnalytics#rule-wa-wellness-improving-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>outcome-stabilizer</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/WellnessAnalytics.json</re:sourceFile>
        <dcterms:description>Analytics layer that consumes PatientWellness four-level metric outputs and detects longitudinal anomaly patterns — sustained deterioration, rapid decline, and recovery. Routes clinical decisions to downstream machines: NewPatientInflow (for community-dwelling patients requiring initial assisted living evaluation) and CareTransitionWorkflow (for facility residents requiring care level changes). Produces six routing outputs covering both community and facility escalation paths.</dcterms:description>
        <rdfs:label>WellnessAnalytics</rdfs:label>
    </owl:NamedIndividual>
    


