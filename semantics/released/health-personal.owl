    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-daily-complete -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-daily-complete">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#LogActivity"/>
        <re:actionNarrative>Log visit completion. No clinical alert generated. Supervisor review during standard shift handoff. Contributes to longitudinal visit pattern baseline.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputTier>
        <rdfs:label>FacilitiesMaintenance — out-daily-complete</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-hygiene-alert -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-hygiene-alert">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Alert charge nurse immediately. CNA dispatched for hygiene assistance within 1 hour. Nurse assesses for incontinence, mobility decline, or cognitive factors. Document in care record. Integration layer writes BATHROOM/ALERT input to DailyPatientCare perceptual region.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>FacilitiesMaintenance — out-hygiene-alert</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-inaccessibility-alert -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-inaccessibility-alert">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Immediate: notify charge nurse and supervisor. Charge nurse accompanies facilities staff for emergency access (supervisor key or master key). Assess patient status on entry. If medical emergency: activate 911 and CareTransitionWorkflow Sequence 1. If not found: activate elopement protocol. If safe (sleeping, showering): document resolved incident. File incident report regardless.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>FacilitiesMaintenance — out-inaccessibility-alert</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-safety-alert -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-safety-alert">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Immediately mitigate hazard (wet floor sign, remove rug, clear pathway). Alert charge nurse with specific hazard description. Nurse assesses patient for evidence of prior fall or injury. Submit work order for permanent remediation. File incident report per facility policy.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>FacilitiesMaintenance — out-safety-alert</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-weekly-complete -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-weekly-complete">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#RouteReferral"/>
        <re:actionNarrative>Log weekly visit completion with nutrition assessment results. Submit to supervisor for weekly review. If nutrition indicators were marginal but within threshold, note in visit record for trending.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>FacilitiesMaintenance — out-weekly-complete</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-wellness-concern -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#out-out-wellness-concern">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Immediately inform charge nurse. Worker documents specific observed behaviors (did not recognize worker, appeared tearful, was unable to state the day). Nurse assesses within 2 hours (immediately if acute). Integration layer evaluates patient context and writes to WellnessAnalytics input at offset 234.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>FacilitiesMaintenance — out-wellness-concern</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#perceptual-mapping -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#perceptual-mapping">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#PerceptualMapping"/>
        <re:bitsPerElement rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:bitsPerElement>
        <re:inputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</re:inputLength>
