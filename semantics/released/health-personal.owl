        <re:sourceMachine rdf:resource="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseMonitor#machine"/>
        <re:busId>health-personal.chronic-disease-response</re:busId>
        <re:dispatchMode>asynchronous-no-wait</re:dispatchMode>
        <re:interconnectionId>health-personal.chronic-disease-response.disease-control-status</re:interconnectionId>
        <re:interconnectionType>published-domain-bus-producer</re:interconnectionType>
        <re:privacyBoundary>PE composes normalized chronic disease status bits only; raw biomarker, symptom, and care-plan records remain outside the universal Reality Event.</re:privacyBoundary>
        <re:sourceOutputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</re:sourceOutputLength>
        <re:sourceOutputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2019</re:sourceOutputOffset>
        <re:targetMachineName>Home Chronic Disease Response Interconnect</re:targetMachineName>
        <rdfs:comment>Publish chronic disease control status into the personal-health chronic disease response bus.</rdfs:comment>
        <rdfs:label>Home Chronic Disease Monitor — disease_control_status</rdfs:label>
    </owl:NamedIndividual>
    


