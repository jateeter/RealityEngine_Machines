    <!-- https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#seq-caregiver-support-child-followup"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#seq-caregiver-support-family-resource-support"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#seq-caregiver-support-respite-crisis"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#seq-caregiver-support-stable-monitoring"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#rule-caregiver-support-child-followup-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#rule-caregiver-support-family-resource-support-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#rule-caregiver-support-respite-crisis-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverSupportResponseInterconnect#rule-caregiver-support-stable-monitoring-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeCaregiverSupportResponseInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes caregiver burden, pediatric nutrition, child development, household food access, and social support context into a compact fan-out lane for respite crisis response, family resource support, child development/nutrition follow-up, and stable monitoring. PE owns source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state.</dcterms:description>
