    <!-- https://realityengine.example.org/ontology/re-core#idempotent -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#idempotent">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>f(x,x,..,x) = x for every x in the domain. NOT a requirement of the fold contract: the Łukasiewicz strong operations are deliberately non-idempotent, since x ⊕ x saturating and x ⊙ x extinguishing is the behaviour they are chosen for. Recorded so that a runtime cannot optimise a repeated contribution away where doing so would change the answer.</rdfs:comment>
        <rdfs:label>idempotent</rdfs:label>
    </owl:DatatypeProperty>
    


