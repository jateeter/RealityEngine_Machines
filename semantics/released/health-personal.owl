        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#perceptual-mapping"/>
