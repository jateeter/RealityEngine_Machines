    <!-- https://realityengine.example.org/machines/health-personal/HomeMedicationCostBarrierMonitor#ix-health-personal_chronic-disease-response_medication-adherence-status -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeMedicationCostBarrierMonitor#ix-health-personal_chronic-disease-response_medication-adherence-status">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <re:sourceMachine rdf:resource="https://realityengine.example.org/machines/health-personal/HomeMedicationCostBarrierMonitor#machine"/>
        <re:busId>health-personal.chronic-disease-response</re:busId>
        <re:dispatchMode>asynchronous-no-wait</re:dispatchMode>
        <re:interconnectionId>health-personal.chronic-disease-response.medication-adherence-status</re:interconnectionId>
        <re:interconnectionType>published-domain-bus-producer</re:interconnectionType>
        <re:privacyBoundary>PE composes normalized medication status bits only; raw pharmacy, benefits, and adherence records remain outside the universal Reality Event.</re:privacyBoundary>
        <re:sourceOutputLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</re:sourceOutputLength>
        <re:sourceOutputOffset rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</re:sourceOutputOffset>
        <re:targetMachineName>Home Chronic Disease Response Interconnect</re:targetMachineName>
        <rdfs:comment>Publish medication access and adherence context into the personal-health chronic disease response bus.</rdfs:comment>
        <rdfs:label>Home Medication Cost Barrier Monitor — medication_adherence_status</rdfs:label>
    </owl:NamedIndividual>
    


