    <!-- https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#seq-daily-patient-care-medication-hydration-review"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#seq-daily-patient-care-routine-recovery"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#seq-daily-patient-care-stable"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#seq-daily-patient-care-urgent-safety-response"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#rule-daily-patient-care-medication-hydration-review-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#rule-daily-patient-care-routine-recovery-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#rule-daily-patient-care-stable-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCareResponseInterconnect#rule-daily-patient-care-urgent-safety-response-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/DailyPatientCareResponseInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes daily patient care, facilities observations, fall criticality, medication adherence, hydration status, and patient wellness acuity into a compact daily-care response lane. PE owns source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state.</dcterms:description>
        <rdfs:label>Daily Patient Care Response Interconnect</rdfs:label>
    </owl:NamedIndividual>
    


