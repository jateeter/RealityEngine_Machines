    <!-- https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-delay-escalation -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-delay-escalation">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-typical"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-borderline"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-delayed"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-significant-delay"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-typical"/>
        <re:sequenceId>child-dev-delay-escalation</re:sequenceId>
        <rdfs:comment>Tracks progressive developmental deviation from age norms. In low-income settings, developmental delays frequently go undetected until school age due to lack of well-child visit access. This pattern catches multi-domain developmental regression before the critical early intervention window closes at age 3–5.</rdfs:comment>
        <rdfs:label>Developmental Delay: TYPICAL+ → BORDERLINE → DELAYED → SIGNIFICANT_DELAY → REFERRAL_NEEDED</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-on-track -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-on-track">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-on-track"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-on-track"/>
        <re:sequenceId>child-dev-on-track</re:sequenceId>
        <rdfs:comment>Fires DEVELOPMENT_OK when all developmental dimensions are within age-appropriate ranges. In low-income home health contexts, this confirms that existing caregiving and community support (Head Start, home visiting programs) are maintaining positive developmental trajectory.</rdfs:comment>
        <rdfs:label>Development On Track: ON_TRACK+ → DEVELOPMENT_OK signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-social-concern -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#seq-child-dev-social-concern">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-engaged"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-engaged"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-isolated"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/ChildDevelopmentMonitor#step-cd-withdrawing"/>
        <re:sequenceId>child-dev-social-concern</re:sequenceId>
        <rdfs:comment>Tracks social-emotional withdrawal trajectory. In low-income households social isolation in children is driven by housing instability, caregiver stress, and limited play access. This pattern fires before full withdrawal and is associated with adverse childhood experience (ACE) accumulation.</rdfs:comment>
        <rdfs:label>Social Withdrawal: ENGAGED+ → WITHDRAWING → ISOLATED → SOCIAL_DEVELOPMENTAL_CONCERN</rdfs:label>
    </owl:NamedIndividual>
    


