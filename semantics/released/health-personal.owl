    <!-- https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-borderline-e3 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PediatricNutritionMonitor#step-pn-borderline-e3">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
