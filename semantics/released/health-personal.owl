    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#ix-health-personal_daily-patient-care-response_facilities-observation"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#ix-health-personal_facilities-maintenance-response_facilities-observation"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#seq-maint-daily-routine"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#seq-maint-hygiene-concern"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#seq-maint-inaccessible"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#seq-maint-safety-concern"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#seq-maint-weekly-deep-clean"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#seq-maint-wellness-concern"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-daily-routine-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-hygiene-concern-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-inaccessible-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-safety-concern-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-weekly-deep-clean-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-wellness-concern-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:severity>life-safety</re:severity>
        <re:sourceFile>machines/domains/health-personal/FacilitiesMaintenance.json</re:sourceFile>
        <dcterms:description>Integrates facilities maintenance workflows into the eldercare patient health pipeline. Models janitorial, hygiene, and general living space maintenance activities as structured observational sequences. Each maintenance visit is an observational opportunity — facilities staff serve as a frontline sensing layer, reporting hygiene deficits, fall hazards, nutritional gaps, and patient wellness concerns to the clinical care workflow engines (DailyPatientCare, WellnessAnalytics). Produces six outputs: two completion signals (daily, weekly) and four clinical alert signals feeding downstream eldercare machines.</dcterms:description>
        <rdfs:label>FacilitiesMaintenance</rdfs:label>
    </owl:NamedIndividual>
    


