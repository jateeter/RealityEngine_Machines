        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentFamily"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>agent family name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#agentId -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#agentId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>agent id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#agentRole -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#agentRole">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>agent role</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#agentTrigger -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#agentTrigger">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>agent trigger</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#allowedAction -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#allowedAction">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>allowed action</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#arbiterRule -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#arbiterRule">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>arbiter rule</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#assertedWhen -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#assertedWhen">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#OutputMergeTransformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The gate&apos;s truth condition over k, the count of asserted contributions, and n, the size of the collection. This is the definition; an implementation is correct when it agrees with it. Boolean-domain transformations only; a chain transformation states re:mergeFormula instead.</rdfs:comment>
        <rdfs:label>asserted when</rdfs:label>
    </owl:DatatypeProperty>
    


