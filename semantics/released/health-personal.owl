    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#step-adj-anxiety-e0 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#step-adj-anxiety-e0">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
        <re:elementIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:elementIndex>
        <re:elementLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</re:elementLevel>
        <re:elementThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</re:elementThreshold>
