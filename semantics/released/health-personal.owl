    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-acute-emergency-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-acute-emergency-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-acute-emergency"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:matchesOutputPosition>
        <re:outputMatchVector>1,0,0,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>HOSPITAL_TRANSFER_COMPLETE — patient successfully transferred to acute hospital. Emergency intake protocol active.</rdfs:comment>
        <rdfs:label>CareTransitionWorkflow — transition-acute-emergency rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-blocked-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-blocked-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-blocked"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#AMBER"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,1,0,0,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>TRANSFER_BLOCKED — barrier detected during planned transfer authorization; resolution pathway initiated; transfer suspended pending clearance</rdfs:comment>
        <rdfs:label>CareTransitionWorkflow — transition-blocked rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-emergency-escalation-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-emergency-escalation-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-emergency-escalation"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#RED"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,0,0,1,0,0,0</re:outputMatchVector>
        <re:processStatus>error</re:processStatus>
        <rdfs:comment>EMERGENCY_ESCALATION — acute deterioration in post-acute/assisted living facility; patient transferred emergently to hospital for higher level of care</rdfs:comment>
        <rdfs:label>CareTransitionWorkflow — transition-emergency-escalation rule 1 (RED)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-hospital-to-rehab-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-hospital-to-rehab-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-hospital-to-rehab"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#GREEN"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:matchesOutputPosition>
        <re:outputMatchVector>0,1,0,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>info</re:processStatus>
        <rdfs:comment>REHAB_TRANSFER_COMPLETE — all readiness criteria met; patient cleared for transfer to rehabilitation facility</rdfs:comment>
        <rdfs:label>CareTransitionWorkflow — transition-hospital-to-rehab rule 1 (GREEN)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-rehab-to-alf-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#rule-transition-rehab-to-alf-1">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#TriggerRule"/>
        <re:appliesToSequence rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-rehab-to-alf"/>
        <re:hasRagStatus rdf:resource="https://realityengine.example.org/ontology/re-core#GREEN"/>
        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,1,0,0,0,0,0</re:outputMatchVector>
        <re:processStatus>info</re:processStatus>
        <rdfs:comment>ALF_TRANSFER_COMPLETE — all readiness criteria met; patient cleared for transition to assisted living</rdfs:comment>
        <rdfs:label>CareTransitionWorkflow — transition-rehab-to-alf rule 1 (GREEN)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-acute-emergency -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-acute-emergency">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#LifeSafetySequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-emerg-crisis"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-emerg-admitted"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-emerg-crisis"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-emerg-dispatch"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-emerg-family"/>
        <re:sequenceId>transition-acute-emergency</re:sequenceId>
        <rdfs:comment>Life-threatening condition triggers immediate hospital transfer. D7_EMERGENCY=H throughout. Transport is dispatched before or concurrently with family notification. Authorization is retrospective (EMTALA governs). Applies to: cardiac events, falls with fracture, stroke, respiratory failure, acute decompensation from any cause.</rdfs:comment>
        <rdfs:label>Scenario 1 — Acute Emergency Transfer to Hospital</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-blocked -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-blocked">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-blocked-stable"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-blocked-auth-attempt"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-blocked-barrier"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-blocked-stable"/>
        <re:sequenceId>transition-blocked</re:sequenceId>
        <rdfs:comment>A barrier is raised during the planned transfer authorization process, preventing transfer execution. Common causes: payer authorization denied (peer-to-peer review initiated), receiving facility at capacity (waitlist activated), family objection requiring mediation, patient clinical deterioration requiring higher level of care than planned destination, missing legal documentation (no healthcare proxy, contested POA), or bed-hold lapse.</rdfs:comment>
        <rdfs:label>Transfer Blocked — Administrative or Clinical Barrier</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-emergency-escalation -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-emergency-escalation">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#LifeSafetySequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-escalation-decline"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-escalation-decline"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-escalation-family-alert"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-escalation-transport"/>
        <re:sequenceId>transition-emergency-escalation</re:sequenceId>
        <rdfs:comment>Patient in a post-acute or assisted living facility experiences acute clinical deterioration requiring emergency hospital transfer. Common causes: new cardiac event, respiratory failure, sepsis, acute stroke, fall with suspected fracture, severe medication reaction, acute altered mental status. D6=H and D7=H together distinguish this sequence from Sequence 1 (which has D7=H but D6=L — no prior facility context). This sequence handles both SNF→Hospital and ALF→Hospital emergency escalations.</rdfs:comment>
        <rdfs:label>Emergency Re-escalation — Any Care Facility to Acute Hospital</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-hospital-to-rehab -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-hospital-to-rehab">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-stable"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-auth"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-bed"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-docs"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-family"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-stable"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-rehab-transport"/>
        <re:sequenceId>transition-hospital-to-rehab</re:sequenceId>
        <rdfs:comment>Patient has reached medical stability and no longer meets acute inpatient criteria. Clinical team determines rehabilitation potential. Discharge planning sequence: clinical certification → payer authorization → bed confirmation → documentation transfer → family briefing → transport. D7=L (planned, non-emergency). Medicare requires 3-day qualifying hospital stay for SNF coverage.</rdfs:comment>
        <rdfs:label>Scenario 2 — Planned Discharge: Acute Hospital to Rehabilitation Facility</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-rehab-to-alf -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#seq-transition-rehab-to-alf">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#CriticalEventSequence"/>
        <re:hasInitialStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-goals-met"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-auth"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-bed"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-docs"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-family-meeting"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-goals-met"/>
        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/CareTransitionWorkflow#step-alf-transport"/>
        <re:sequenceId>transition-rehab-to-alf</re:sequenceId>
        <rdfs:comment>Patient has met or plateaued on rehabilitation goals. Long-term functional level is established. ALF is the appropriate next-phase living environment. Family meeting is the first and primary step — ALF placement is a major life decision requiring genuine family/proxy engagement before administrative processes proceed. Sequence: clinical goal certification → family meeting → payer/financial confirmation → care plan transfer → ALF bed → transport.</rdfs:comment>
        <rdfs:label>Scenario 3 — Planned Discharge: Rehabilitation Facility to Assisted Living</rdfs:label>
