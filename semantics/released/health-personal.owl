        <re:isInitialStep rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:isInitialStep>
        <re:stateName>BORDERLINE</re:stateName>
        <rdfs:label>Home Chronic Disease Monitor — BORDERLINE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseMonitor#step-cd-borderline-e0 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeChronicDiseaseMonitor#step-cd-borderline-e0">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#ElementValue"/>
