    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-alert -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-alert">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#ScheduleCareReview"/>
        <re:actionNarrative>Schedule multidisciplinary care plan conference within 5 business days. Refer for: anxiety/stress counseling or psychiatric consultation, physical therapy for activity re-engagement, occupational therapy for lifestyle restructuring. Increase assessment frequency to weekly. Notify attending physician and family.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>PatientWellness — out-alert</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-critical -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-critical">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#UrgentIntervention"/>
        <re:actionNarrative>Notify attending physician immediately. Order comprehensive cognitive evaluation (neuropsychological testing, imaging if not recent). Review and revise care plan within 48 hours. Assess for reversible causes: UTI, dehydration, medication side effects, depression-related pseudodementia. Increase supervision level. Notify family and document in medical record. Consult social work for advanced care planning discussion.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>PatientWellness — out-critical</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-good -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-good">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#RouteReferral"/>
        <re:actionNarrative>Offer stress-reduction programming (mindfulness, pet therapy, chaplaincy). Reassess stress dimension at next cycle. No care plan change required at this time.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>PatientWellness — out-good</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-good-adj -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-good-adj">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#RouteReferral"/>
        <re:actionNarrative>Document age-adjusted wellness classification. Refer to physical or occupational therapy to explore any safe exercise option (even passive range-of-motion). Continue monitoring all five assessed dimensions at standard frequency. No urgent care plan change required.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputTier>
        <rdfs:label>PatientWellness — out-good-adj</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-optimal -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/PatientWellness#out-out-optimal">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Determination"/>
        <re:prescribesAction rdf:resource="https://realityengine.example.org/ontology/re-core#ContinueMonitoring"/>
        <re:actionNarrative>Continue current care plan. Document as reference baseline for future assessments.</re:actionNarrative>
        <re:outputConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</re:outputConfidence>
        <re:outputTier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</re:outputTier>
        <rdfs:label>PatientWellness — out-optimal</rdfs:label>
    </owl:NamedIndividual>
    


