    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasAgentBinding rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#agent-binding"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#governance"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#ix-health-personal_chronic-disease-response_activity-tolerance-status"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#ix-health-personal_daily-activity-wellness_activity-burden"/>
        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#ix-health-personal_sleep-recovery-wellness_activity-tolerance"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#seq-activity-active"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#seq-activity-prolonged"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#seq-activity-sedentary"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#rule-activity-active-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#rule-activity-prolonged-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityMonitor#rule-activity-sedentary-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/DailyActivityMonitor.json</re:sourceFile>
        <dcterms:description>Compares today&apos;s in-home movement against the patient&apos;s 7-day baseline. Flags sedentary days as AMBER and prolonged inactivity (multiple consecutive sedentary days) as RED so the local AI can escalate wellness outreach.</dcterms:description>
        <rdfs:label>Daily Activity Monitor</rdfs:label>
    </owl:NamedIndividual>
    


