        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-hazard-escalation"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-health-hazard-risk"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-safe"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#seq-home-env-utility-failure"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#rule-home-env-hazard-escalation-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#rule-home-env-health-hazard-risk-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#rule-home-env-safe-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyMonitor#rule-home-env-utility-failure-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>risk-forecaster</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeEnvironmentSafetyMonitor.json</re:sourceFile>
        <dcterms:description>Monitors housing quality conditions that directly affect resident health in low- and medium-income households. Tracks temperature stability (heating/cooling reliability), air quality (mold, lead, particulates), structural hazards, and utility shutoff risk. These social determinants of health are disproportionately present in aging rental housing stock occupied by economically vulnerable families. Output at [1999:2002] feeds the Adolescent Mental Health Monitor.</dcterms:description>
        <rdfs:label>Home Environment Safety Monitor</rdfs:label>
    </owl:NamedIndividual>
    


