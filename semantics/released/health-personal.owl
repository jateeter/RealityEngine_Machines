        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/SleepQualityMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/SleepQualityMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/SleepQualityMonitor#seq-sleep-disturbed"/>
