        <re:machineClass>signal-monitor</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeFoodSecurityMonitor.json</re:sourceFile>
        <dcterms:description>Monitors household food access, meal frequency, and nutrition assistance engagement for low- and medium-income families receiving home-based care. Tracks the progression from adequate food access through food insecurity to crisis conditions requiring immediate SNAP, WIC, or food-bank referral. Output at [1995:1998] feeds the Adolescent Mental Health Monitor, reflecting the documented link between food insecurity and adolescent behavioral health outcomes.</dcterms:description>
        <rdfs:label>Home Food Security Monitor</rdfs:label>
    </owl:NamedIndividual>
    


