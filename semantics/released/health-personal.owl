        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#ix-health-personal_patient-safety-transport_fall-outcome"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/FallDetection#openclaw-projection"/>
