        <re:hasInterconnection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#ix-health_infrastructure-support_consumer_home_caregiver_burden_context"/>
        <re:hasOpenClawProjection rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#openclaw-projection"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#seq-caregiver-burnout-escalation"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#seq-caregiver-coping-ok"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#seq-caregiver-high-burden"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#rule-caregiver-burnout-escalation-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#rule-caregiver-coping-ok-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeCaregiverBurdenMonitor#rule-caregiver-high-burden-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>risk-forecaster</re:machineClass>
        <re:matchAlgorithm>gte</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeCaregiverBurdenMonitor.json</re:sourceFile>
        <dcterms:description>Integration machine that reads combined output signals from the Pediatric Nutrition Monitor [2003:2006] and the Child Development Monitor [2007:2010] to assess caregiver burden driven by child health challenges. Child nutritional problems and developmental delays are the primary pediatric-driven stressors for at-home caregivers in low-income settings. Caregiver burnout reduces care quality across all household members and is a leading predictor of preventable pediatric ED visits. Output at [2031:2034] is available to downstream care coordination systems.</dcterms:description>
        <rdfs:label>Home Caregiver Burden Monitor</rdfs:label>
    </owl:NamedIndividual>
    


