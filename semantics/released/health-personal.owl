        <re:matchesOutputPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</re:matchesOutputPosition>
        <re:outputMatchVector>0,0,1,0,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>HYGIENE_ALERT — bathroom or linen hygiene deficit observed by facilities staff. Downstream: DailyPatientCare bathroom-nonuse detection.</rdfs:comment>
        <rdfs:label>FacilitiesMaintenance — maint-hygiene-concern rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#rule-maint-inaccessible-1 -->

