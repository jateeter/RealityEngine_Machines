    <!-- https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#perceptual-mapping -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#perceptual-mapping">
