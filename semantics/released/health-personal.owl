        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#seq-food-security-nutrition-behavioral-followup"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#seq-food-security-stable-monitoring"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#seq-food-security-urgent-response"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#rule-food-security-benefits-access-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#rule-food-security-nutrition-behavioral-followup-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#rule-food-security-stable-monitoring-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityResponseInterconnect#rule-food-security-urgent-response-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/HomeFoodSecurityResponseInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes food-security status, pediatric nutrition status, adolescent behavioral-health status, and hydration status into a compact food-security response lane. PE owns source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state.</dcterms:description>
        <rdfs:label>Home Food Security Response Interconnect</rdfs:label>
    </owl:NamedIndividual>
    


