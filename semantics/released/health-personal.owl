        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SemanticAxis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Element offset within the write-back region, zero-based.</rdfs:comment>
        <rdfs:label>axis index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#axisName -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#axisName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#SemanticAxis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Functional: one position of one region carries exactly one meaning. Two sources asserting different names for the same axis is an inconsistency, not a variant spelling.</rdfs:comment>
        <rdfs:label>axis name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://realityengine.example.org/ontology/re-core#axisNameSource -->

    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#axisNameSource">
