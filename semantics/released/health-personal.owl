        <re:writesToRegionOf rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#machine"/>
        <rdfs:label>FacilitiesMaintenance — openclaw-input-analyst projection binding</rdfs:label>
