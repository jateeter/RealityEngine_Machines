        <re:hasStep rdf:resource="https://realityengine.example.org/machines/health-personal/HomeFoodSecurityMonitor#step-hf-food-insecure-state"/>
        <re:sequenceId>home-food-insecure</re:sequenceId>
        <rdfs:comment>Fires FOOD_INSECURE when meal frequency, food quality, and pantry depth have fallen below stable range, but the household is not yet in acute crisis and may not yet require emergency referral.</rdfs:comment>
        <rdfs:label>Food Insecure: STRAINED+ -&gt; FOOD_INSECURE signal</rdfs:label>
    </owl:NamedIndividual>
    


