        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-bath-visit-e2"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-bath-visit-e3"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-bath-visit-e4"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-bath-visit-e5"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-bath-visit-e6"/>
        <re:hasElementValue rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-bath-visit-e7"/>
        <re:hasNextStep rdf:resource="https://realityengine.example.org/machines/health-personal/DailyPatientCare#step-bn-overdue"/>
