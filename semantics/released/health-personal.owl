    <!-- https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#agent-binding -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#agent-binding">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#AgentBinding"/>
        <re:autonomyMode rdf:resource="https://realityengine.example.org/ontology/re-core#SupervisedAct"/>
        <re:boundAgent rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#agent"/>
        <re:maxAutonomy rdf:resource="https://realityengine.example.org/ontology/re-core#SupervisedAct"/>
        <re:writesToRegionOf rdf:resource="https://realityengine.example.org/machines/health-personal/HomeTransportationBarrierMonitor#machine"/>
        <re:agentTrigger>home-transportation-barrier-agent-dispatcher-risk-signal</re:agentTrigger>
        <re:allowedAction>Dispatch caregiver_support_agent to coordinate appointment transportation when care access is blocked or fragile.</re:allowedAction>
        <re:allowedAction>Record the resolved transportation support plan back through the PE completion source mapping.</re:allowedAction>
        <re:allowedAction>Stage ride-support, caregiver outreach, or community-service referral actions for patient transport gaps.</re:allowedAction>
        <re:requiresHumanApproval rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</re:requiresHumanApproval>
        <rdfs:label>Home Transportation Barrier Monitor — caregiver_support_agent (supervised-act)</rdfs:label>
    </owl:NamedIndividual>
    


