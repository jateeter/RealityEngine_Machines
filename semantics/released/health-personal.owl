    <!-- https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#governance"/>
        <re:hasPerceptualMapping rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#perceptual-mapping"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#seq-daily-activity-wellness-activity-support"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#seq-daily-activity-wellness-hydration-sleep-recovery"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#seq-daily-activity-wellness-stable-routine"/>
        <re:hasSequence rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#seq-daily-activity-wellness-urgent-check"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#rule-daily-activity-wellness-activity-support-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#rule-daily-activity-wellness-hydration-sleep-recovery-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#rule-daily-activity-wellness-stable-routine-1"/>
        <re:hasTriggerRule rdf:resource="https://realityengine.example.org/machines/health-personal/DailyActivityWellnessInterconnect#rule-daily-activity-wellness-urgent-check-1"/>
        <re:arbiterRule>PASSTHROUGH</re:arbiterRule>
        <re:domainName>health-personal</re:domainName>
        <re:machineClass>bridge</re:machineClass>
        <re:matchAlgorithm>equals</re:matchAlgorithm>
        <re:sourceFile>machines/domains/health-personal/DailyActivityWellnessInterconnect.json</re:sourceFile>
        <dcterms:description>Published personal-health bridge bus that composes daily activity, sleep quality, hydration status, and social-isolation context into a compact wellness deterioration lane. PE owns source composition and writes the compact input lane; RE evaluates this machine as ordinary vector state.</dcterms:description>
        <rdfs:label>Daily Activity Wellness Interconnect</rdfs:label>
    </owl:NamedIndividual>
    


