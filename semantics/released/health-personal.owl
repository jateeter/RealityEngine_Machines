        <re:outputMatchVector>0,0,0,0,1,0,0,0</re:outputMatchVector>
        <re:processStatus>warning</re:processStatus>
        <rdfs:comment>Alert: BATHROOM_ALERT — patient has not used bathroom within care-plan-specified interval; assess for urinary retention, mobility difficulty, or fall risk</rdfs:comment>
        <rdfs:label>DailyPatientCare — daily-bathroom-nonuse rule 1 (AMBER)</rdfs:label>
    </owl:NamedIndividual>
    


