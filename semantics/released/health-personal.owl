        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#OpenClawProjection"/>
        <re:sourceMachine rdf:resource="https://realityengine.example.org/machines/health-personal/FacilitiesMaintenance#machine"/>
        <re:dispatchMode>accepted-no-wait</re:dispatchMode>
        <re:projectionId>openclaw-facilities-maintenance-native-input-projection</re:projectionId>
