    <!-- https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyResponseInterconnect#machine -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyResponseInterconnect#machine">
        <rdf:type rdf:resource="https://realityengine.example.org/ontology/re-core#Machine"/>
        <re:hasGovernance rdf:resource="https://realityengine.example.org/machines/health-personal/HomeEnvironmentSafetyResponseInterconnect#governance"/>
