    <!-- https://realityengine.example.org/machines/health-personal/DailyPatientCare#rule-daily-bathroom-nonuse-1 -->

    <owl:NamedIndividual rdf:about="https://realityengine.example.org/machines/health-personal/DailyPatientCare#rule-daily-bathroom-nonuse-1">
