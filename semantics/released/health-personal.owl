    <owl:DatatypeProperty rdf:about="https://realityengine.example.org/ontology/re-core#publishedOutputOffset">
        <rdfs:domain rdf:resource="https://realityengine.example.org/ontology/re-core#Interconnection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>published output offset</rdfs:label>
