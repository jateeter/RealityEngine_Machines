{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realityengine.example.org/schemas/lane-contract.schema.json",
  "title": "Ingress lane contracts",
  "description": "Semantics of externally-writable spans of the universal vector: what each position means, in what unit, over what value domain, convertible how. Deliberately separate from region-allocation.schema.json, which stays the authority on allocation \u2014 which span belongs to whom. Generated by scripts/backfill-lane-contracts.py and consumed by the lane projector, which resolves each axis as its lane profile overlaid with the axis's own overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generator",
    "derivationProfiles",
    "summary",
    "lanes",
    "review"
  ],
  "$defs": {
    "ucumCode": {
      "type": "string",
      "minLength": 1,
      "description": "A UCUM code in canonical form. Canonicality is not expressible in JSON Schema and is enforced by scripts/ucum.py in the generator and in tests/contracts/lane_contracts_test.py: the guardrail shapes compare codes as strings, so 'mg/dL' and 'mg.dL-1' must not both occur."
    },
    "conversionPolicy": {
      "enum": [
        "none",
        "linear",
        "affine",
        "prohibited"
      ],
      "description": "prohibited is required for ordinal and nominal scales: rescaling a category is a category error, not an arithmetic one."
    },
    "scaleType": {
      "enum": [
        "ratio",
        "interval",
        "ordinal",
        "nominal"
      ]
    },
    "unitContract": {
      "type": "object",
      "description": "The unit half of an axis. Appears on a derivation profile and, as an override, on an individual axis.",
      "properties": {
        "canonicalUcum": {
          "$ref": "#/$defs/ucumCode"
        },
        "expectedUcum": {
          "$ref": "#/$defs/ucumCode"
        },
        "acceptedUcum": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ucumCode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "quantityKind": {
          "type": "string",
          "format": "uri"
        },
        "qudtUnitIri": {
          "type": "string",
          "format": "uri"
        },
        "conversionPolicy": {
          "$ref": "#/$defs/conversionPolicy"
        },
        "scaleType": {
          "$ref": "#/$defs/scaleType"
        },
        "permittedValue": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minValue": {
          "type": "number"
        },
        "maxValue": {
          "type": "number"
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "$comment": {
      "type": "string"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "derivationProfiles": {
      "type": "object",
      "description": "Named unit contracts a lane can adopt wholesale, keyed '<normalization>/<bitsPerElement>'. Factoring these out keeps a rule change one edit rather than thousands, and keeps the rule legible.",
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/unitContract"
          },
          {
            "required": [
              "canonicalUcum",
              "acceptedUcum",
              "quantityKind",
              "conversionPolicy",
              "scaleType"
            ]
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "lanes",
        "lanesAnnotated",
        "lanesNeedingReview",
        "positionsAnnotated",
        "machinesCovered",
        "reviewByReason"
      ],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "integer",
          "minimum": 0
        },
        "lanesAnnotated": {
          "type": "integer",
          "minimum": 0
        },
        "lanesNeedingReview": {
          "type": "integer",
          "minimum": 0
        },
        "positionsAnnotated": {
          "type": "integer",
          "minimum": 0
        },
        "machinesCovered": {
          "type": "integer",
          "minimum": 0
        },
        "reviewByReason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "offset",
          "length",
          "readers",
          "axes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Matches the pattern reg:IngressLaneShape enforces, so a lane id that projects cleanly here cannot be refused there."
          },
          "source": {
            "enum": [
              "machine-input",
              "service-lane",
              "reserved-band"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 1
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "readers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Machines reading this lane. Several machines legitimately share one externally-written region, which is why a lane is a region rather than a machine."
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "axes": {
            "type": "array",
            "description": "Empty when the lane is unresolved; the reason is then in review. An axis carries what varies \u2014 position and meaning \u2014 plus any override of its lane's profile.",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/unitContract"
                },
                {
                  "type": "object",
                  "required": [
                    "index",
                    "name"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "contention": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sharedCells",
              "arbitrated"
            ],
            "description": "Present when this lane shares cells with another lane. Overlap is ordinary \u2014 a machine output feeding another machine's input is the interconnect mechanism. What is recorded here is whether the resulting contention has a declared resolution in domains/arbitration-registry.json.",
            "properties": {
              "sharedCells": {
                "type": "integer",
                "minimum": 1
              },
              "arbitrated": {
                "type": "boolean"
              },
              "undeclaredCells": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "array",
      "description": "Lanes the evidence does not settle. These are not defects in the generator: a fabricated unit behind a guardrail is worse than an absent one, so anything unresolved is surfaced rather than guessed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "laneId",
          "reason",
          "detail"
        ],
        "properties": {
          "laneId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "profile-unrecognised",
              "axis-name-disagreement",
              "contention-undeclared",
              "physical-units-need-owner"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "readers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "undeclaredCells": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
