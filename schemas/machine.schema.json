{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realityengine.example.org/schemas/machine.schema.json",
  "title": "RealityEngine Machine",
  "description": "Compatibility-safe schema for canonical RealityEngine machine corpus files. It constrains the cross-engine contract surface while leaving domain-specific metadata extensible.",
  "type": "object",
  "required": ["version", "machine"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "machine": {
      "$ref": "#/$defs/machine"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "machine": {
      "type": "object",
      "required": [
        "name",
        "description",
        "metadata",
        "arbiterRule",
        "perceptualMapping",
        "sequences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "arbiterRule": {
          "type": "string",
          "enum": ["PASSTHROUGH"]
        },
        "matchAlgorithm": {
          "type": "string",
          "enum": ["equals", "gte"]
        },
        "perceptualMapping": {
          "$ref": "#/$defs/perceptualMapping"
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "inputSequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputSequence"
          }
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "governance",
        "triggerConfig",
        "machineClass"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sequenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "machineClass": {
          "$ref": "machine-class.schema.json"
        },
        "inputSemantics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensorNormalization": {
          "type": "object",
          "additionalProperties": true
        },
        "governance": {
          "$ref": "#/$defs/governance"
        },
        "triggerConfig": {
          "$ref": "#/$defs/triggerConfig"
        },
        "tagging": {
          "$ref": "#/$defs/tagging"
        },
        "agentBinding": {
          "$ref": "agent-binding.schema.json"
        },
        "interconnections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interconnection"
          }
        },
        "publishedDomainBus": {
          "$ref": "#/$defs/publishedDomainBus"
        },
        "domainLevelTag": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "perceptualMapping": {
      "type": "object",
      "required": ["input", "output", "bitsPerElement"],
      "properties": {
        "input": {
          "$ref": "#/$defs/region"
        },
        "output": {
          "$ref": "#/$defs/region"
        },
        "bitsPerElement": {
          "type": "integer",
          "enum": [1, 2, 4, 8]
        }
      },
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "required": ["offset", "length"],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": ["id", "vectors"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vectorState"
          }
        }
      },
      "additionalProperties": true
    },
    "vectorState": {
      "type": "object",
      "required": ["elements"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "isInitial": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vectorElement"
          }
        },
        "nextVectorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputVectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputVector"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "vectorElement": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "comparatorType": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "outputVector": {
      "type": "object",
      "required": ["vector"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vector": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "inputSequence": {
      "type": "object",
      "required": ["name", "vectors"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "required": ["schemaVersion", "ownerTeam", "runbook", "escalationPolicy", "sla"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "ownerTeam": {
          "type": "string",
          "minLength": 1
        },
        "runbook": {
          "type": "string",
          "minLength": 1
        },
        "escalationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "object",
          "additionalProperties": true
        },
        "sla": {
          "type": "object",
          "additionalProperties": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "triggerConfig": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "processId": {
          "type": "string",
          "minLength": 1
        },
        "processName": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "dispatch": {
          "type": "object",
          "additionalProperties": true
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/triggerRule"
          }
        }
      },
      "additionalProperties": true
    },
    "triggerRule": {
      "type": "object",
      "required": ["sequenceId", "outputMatches", "ragStatusCode"],
      "properties": {
        "sequenceId": {
          "type": "string",
          "minLength": 1
        },
        "outputMatches": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "ragStatusCode": {
          "type": "string",
          "enum": ["GREEN", "AMBER", "RED"]
        },
        "processStatus": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "governance": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "tagging": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "managedBy": {
          "type": "string",
          "minLength": 1
        },
        "primaryDomain": {
          "type": "string",
          "minLength": 1
        },
        "domainTags": {
          "$ref": "#/$defs/stringArray"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "machineCode": {
          "type": "string",
          "minLength": 1
        },
        "capabilityTags": {
          "$ref": "#/$defs/stringArray"
        },
        "workflowTags": {
          "$ref": "#/$defs/stringArray"
        },
        "integrationTags": {
          "$ref": "#/$defs/stringArray"
        },
        "validationTags": {
          "$ref": "#/$defs/stringArray"
        },
        "allTags": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interconnection": {
      "type": "object",
      "required": ["id", "type", "busId", "busTag"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "busId": {
          "type": "string",
          "minLength": 1
        },
        "busTag": {
          "type": "string",
          "minLength": 1
        },
        "sourceOutputRegion": {
          "$ref": "#/$defs/region"
        },
        "targetInputRegion": {
          "$ref": "#/$defs/region"
        },
        "publishedOutputRegion": {
          "$ref": "#/$defs/region"
        },
        "peCompositionRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "publishedDomainBus": {
      "type": "object",
      "required": ["id", "tag", "domain", "inputRegion", "outputRegion", "inputComposition"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "inputRegion": {
          "$ref": "#/$defs/region"
        },
        "outputRegion": {
          "$ref": "#/$defs/region"
        },
        "inputComposition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "sourceMachine", "machineOutputRegion"],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "sourceMachine": {
                "type": "string",
                "minLength": 1
              },
              "machineInputRegion": {
                "$ref": "#/$defs/region"
              },
              "machineOutputRegion": {
                "$ref": "#/$defs/region"
              },
              "composedInputElements": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "mapping": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "downstreamConsumers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["machine", "inputRegion"],
            "properties": {
              "machine": {
                "type": "string",
                "minLength": 1
              },
              "inputRegion": {
                "$ref": "#/$defs/region"
              }
            },
            "additionalProperties": true
          }
        },
        "peContract": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
