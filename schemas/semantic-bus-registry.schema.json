{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realityengine.example.org/schemas/semantic-bus-registry.schema.json",
  "title": "RealityEngine Semantic Bus Registry",
  "description": "Authoritative inventory of semantic published-domain buses (domains/semantic-bus-registry.json), generated by scripts/inventory-semantic-buses.py. Compatibility-safe: constrains the contract surface while leaving room for growth.",
  "type": "object",
  "required": [
    "schemaVersion",
    "purpose",
    "generatedBy",
    "sourceRoot",
    "classificationPolicy",
    "counts",
    "semanticBuses",
    "setAsideMechanicalBuses"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "generatedBy": { "type": "string", "minLength": 1 },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "classificationPolicy": {
      "type": "object",
      "required": ["semanticDefinition"],
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "semanticBuses": { "type": "array", "items": { "$ref": "#/$defs/semanticBus" } },
    "setAsideMechanicalBuses": { "type": "array", "items": { "$ref": "#/$defs/mechanicalBus" } }
  },
  "additionalProperties": true,
  "$defs": {
    "region": {
      "type": "object",
      "required": ["offset", "length"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "semanticBus": {
      "type": "object",
      "required": ["id", "tag", "domain", "machineFile", "inputRegion", "outputRegion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "machineFile": { "type": "string", "minLength": 1 },
        "machineName": { "type": "string", "minLength": 1 },
        "inputRegion": { "$ref": "#/$defs/region" },
        "outputRegion": { "$ref": "#/$defs/region" },
        "inputSemantics": { "type": "array", "items": { "type": ["string", "object"] } },
        "outputSemantics": { "type": "array", "items": { "type": ["string", "object"] } },
        "outputSpace": { "type": ["string", "null"] },
        "sourceDomains": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceMachines": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "inputComposition": { "type": "array" },
        "downstreamConsumers": { "type": "array" },
        "peContract": { "type": "object" }
      },
      "additionalProperties": true
    },
    "mechanicalBus": {
      "type": "object",
      "required": ["id", "domain", "machineFile", "inputRegion", "outputRegion", "classification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "machineFile": { "type": "string", "minLength": 1 },
        "inputRegion": { "$ref": "#/$defs/region" },
        "outputRegion": { "$ref": "#/$defs/region" }
      },
      "additionalProperties": true
    }
  }
}
