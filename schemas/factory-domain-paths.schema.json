{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realityengine.example.org/schemas/factory-domain-paths.schema.json",
  "title": "Canonical domain to factory directory mapping",
  "type": "object",
  "required": ["schemaVersion", "purpose", "aliases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "purpose": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "aliases": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "not": {"pattern": "[^a-z0-9-]"}},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "not": {"pattern": "[^A-Za-z0-9_-]"}}
    }
  },
  "additionalProperties": false
}
