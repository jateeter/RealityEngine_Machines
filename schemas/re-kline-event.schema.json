{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realityengine.example.org/schemas/re-kline-event.schema.json",
  "title": "re-kline-event/1: an event on a stored K-line",
  "description": "Appended to a K-line segment when a completed K-line's sustain ends (RealityEngine_CI SURFACE_SPEC.md, 'Record').",
  "type": "object",
  "required": [
    "format",
    "kline",
    "event",
    "through",
    "at"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "re-kline-event/1"
    },
    "kline": {
      "$ref": "kline-defs.schema.json#/$defs/klineId"
    },
    "event": {
      "const": "sustain-end"
    },
    "through": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "$ref": "kline-defs.schema.json#/$defs/clock"
    }
  }
}
