        "disease_burden_signal_norm": "0.0=[1,0,0,0] DISEASE_EXACERBATION from ChronicDisease (bit 366), 0.5=[0,1,0,0] POOR_CONTROL (bit 367), 1.0=[0,0,0,1] DISEASE_CONTROLLED (bit 369)",
        "pain_burden_signal_norm": "0.0=[1,0,0,0] PAIN_CRISIS from ChronicPain (bit 370), 0.5=[0,0,1,0] FUNCTIONAL_IMPAIRMENT (bit 372), 1.0=[0,0,0,1] PAIN_MANAGED (bit 373)",
        "depression_screen_norm": "0.0=PHQ-9 score >15 (severe depression); active suicidal ideation screening positive, 0.5=PHQ-9 score 5–14 (mild to moderate); hopelessness reported, 1.0=PHQ-9 score <5; mood adequate",
