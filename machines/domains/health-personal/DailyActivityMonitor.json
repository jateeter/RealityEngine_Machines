        },
        {
          "id": "health-personal.sleep-recovery-wellness.activity-tolerance",
          "type": "published-domain-bus-producer",
          "role": "activity_tolerance",
          "sourceMachine": "Daily Activity Monitor",
          "sourceOutputRegion": {
            "offset": 1953,
            "length": 2
          },
          "targetInputElements": [
            2,
