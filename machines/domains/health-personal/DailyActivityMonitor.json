{
  "version": "1.0.0",
  "machine": {
    "name": "Daily Activity Monitor",
    "description": "Compares today's in-home movement against the patient's 7-day baseline. Flags sedentary days as AMBER and prolonged inactivity (multiple consecutive sedentary days) as RED so the local AI can escalate wellness outreach.",
    "metadata": {
      "category": "health-personal",
      "domain": "wellness",
      "author": "Reality Engine",
      "created": "2026-04-21T00:00:00Z",
      "workflow": "in-home-activity-baseline",
      "eventSpace": "2D binary: [below_baseline_today, sedentary_streak_active]",
      "outputSpace": "2D binary: {[0,0]=ACTIVE, [1,0]=SEDENTARY, [1,1]=PROLONGED_INACTIVITY}",
      "tags": [
        "anomaly-detection",
        "ces-sequences",
        "ces-sequences-3",
        "daily-activity-monitor",
        "elder-care",
        "health-personal",
        "in-home-monitoring",
        "input-sequences",
        "input-sequences-2",
        "startup-loadable",
        "trigger",
        "wellness"
      ],
      "sequenceCount": 3,
      "triggerConfig": {
        "endpoint": "http://localhost:4000/graphql",
        "template": "examples/triggers/graphql_trigger_template.py",
        "processId": "ACTIVITY-MONITOR",
        "processName": "Daily Activity Monitor",
        "rules": [
          {
            "sequenceId": "activity-active",
            "outputMatches": [
              0,
              0
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "ok",
            "description": "Movement on par with baseline"
          },
          {
            "sequenceId": "activity-sedentary",
            "outputMatches": [
              1,
              0
            ],
            "ragStatusCode": "AMBER",
            "processStatus": "warning",
            "description": "Below baseline today \u2014 suggest a short activity nudge"
          },
          {
            "sequenceId": "activity-prolonged",
            "outputMatches": [
              1,
              1
            ],
            "ragStatusCode": "RED",
            "processStatus": "error",
            "description": "Multi-day inactivity streak \u2014 escalate to caregiver / clinician"
          }
        ]
      },
      "tagging": {
        "schemaVersion": "1.0.0",
        "managedBy": "scripts/manage_machine_tags.mjs",
        "primaryDomain": "health-personal",
        "domainTags": [
          "health-personal",
          "wellness"
        ],
        "family": "daily-activity-monitor",
        "machineCode": "daily-activity-monitor",
        "capabilityTags": [
          "in-home-monitoring"
        ],
        "workflowTags": [
          "anomaly-detection",
          "daily-activity-monitor",
          "elder-care",
          "trigger"
        ],
        "integrationTags": [],
        "validationTags": [
          "ces-sequences",
          "ces-sequences-3",
          "input-sequences",
          "input-sequences-2",
          "startup-loadable"
        ],
        "allTags": [
          "anomaly-detection",
          "ces-sequences",
          "ces-sequences-3",
          "daily-activity-monitor",
          "elder-care",
          "health-personal",
          "in-home-monitoring",
          "input-sequences",
          "input-sequences-2",
          "startup-loadable",
          "trigger",
          "wellness"
        ]
      },
      "governance": {
        "schemaVersion": "1.0.0",
        "ownerTeam": "patient-safety-on-call",
        "runbook": "https://runbooks.example.org/health-personal/dailyactivitymonitor",
        "escalationPolicy": "pagerduty:patient-safety",
        "contact": {
          "primary": "patient-safety-on-call-primary@example.org",
          "secondary": "patient-safety-on-call-secondary@example.org"
        },
        "sla": {
          "ok": null,
          "info": null,
          "warning": 600,
          "error": 60
        },
        "notes": "Auto-backfilled by scripts/backfill-governance.mjs from primaryDomain=\"health-personal\".  Review and tune the routing as the team owning DailyActivityMonitor matures."
      },
      "machineClass": "signal-monitor",
      "inputSemantics": [
        "below_baseline_today_bit",
        "sedentary_streak_active_bit"
      ],
      "interconnections": [
        {
          "id": "health-personal.daily-activity-wellness.activity-burden",
          "type": "published-domain-bus-producer",
          "role": "activity_burden",
          "sourceMachine": "Daily Activity Monitor",
          "sourceOutputRegion": {
            "offset": 1953,
            "length": 2
          },
          "targetInputElements": [
            0,
            1
          ],
          "normalizedElements": [
            "below baseline today bit from DailyActivityMonitor [1953]",
            "sedentary streak active bit from DailyActivityMonitor [1954]"
          ],
          "purpose": "Publish in-home activity decline into the personal-health daily activity wellness bus.",
          "privacyBoundary": "PE composes normalized activity status bits only; raw step counts, room traces, and wearable telemetry remain outside the universal Reality Event.",
          "busId": "health-personal.daily-activity-wellness",
          "busTag": "published-bus-health-personal-daily-activity-wellness",
          "targetMachine": "Daily Activity Wellness Interconnect",
          "targetMachineFile": "DailyActivityWellnessInterconnect.json",
          "busInputRegion": {
            "offset": 4310,
            "length": 10
          },
          "busOutputRegion": {
            "offset": 4320,
            "length": 4
          },
          "peCompositionRequired": true,
          "compositionOwner": "perception-engine",
          "dispatchMode": "asynchronous-no-wait"
        },
        {
          "id": "health-personal.chronic-disease-response.activity-tolerance-status",
          "type": "published-domain-bus-producer",
          "role": "activity_tolerance_status",
          "sourceMachine": "Daily Activity Monitor",
          "sourceOutputRegion": {
            "offset": 1953,
            "length": 2
          },
          "targetInputElements": [
            16,
            17
          ],
          "normalizedElements": [
            "below baseline activity bit from DailyActivityMonitor [1953]",
            "sedentary streak active bit from DailyActivityMonitor [1954]"
          ],
          "purpose": "Publish activity tolerance and sedentary-streak context into the personal-health chronic disease response bus.",
          "privacyBoundary": "PE composes normalized activity status bits only; raw wearable and in-home movement traces remain outside the universal Reality Event.",
          "busId": "health-personal.chronic-disease-response",
          "busTag": "published-bus-health-personal-chronic-disease-response",
          "targetMachine": "Home Chronic Disease Response Interconnect",
          "targetMachineFile": "HomeChronicDiseaseResponseInterconnect.json",
          "busInputRegion": {
            "offset": 4368,
            "length": 18
          },
          "busOutputRegion": {
            "offset": 4386,
            "length": 4
          },
          "peCompositionRequired": true,
          "compositionOwner": "perception-engine",
