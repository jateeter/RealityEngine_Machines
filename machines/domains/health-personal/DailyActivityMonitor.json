          ],
          "normalizedElements": [
            "below baseline bit",
            "prolonged inactivity bit"
          ],
          "purpose": "Publish activity tolerance into health-personal.sleep-recovery-wellness.",
          "busId": "health-personal.sleep-recovery-wellness",
          "busTag": "published-bus-health-personal-sleep-recovery-wellness",
          "targetMachine": "Sleep Recovery Wellness Interconnect",
          "targetMachineFile": "SleepRecoveryWellnessInterconnect.json",
          "targetInputRegion": {
            "offset": 4542,
            "length": 14
          },
          "busInputRegion": {
            "offset": 4542,
            "length": 14
          },
          "publishedOutputRegion": {
            "offset": 4556,
            "length": 4
          },
          "busOutputRegion": {
            "offset": 4556,
            "length": 4
          },
          "peCompositionRequired": true,
          "compositionOwner": "perception-engine",
          "dispatchMode": "asynchronous-no-wait",
          "privacyBoundary": "PE composes normalized health-personal status bits only; raw PHI, staff notes, device telemetry, claims, records, and source payloads remain outside the universal Reality Event."
        }
      ],
      "openClawProjection": {
        "projectionId": "openclaw-daily-activity-native-input-projection",
        "owner": "openclaw-input-analyst",
        "dispatchMode": "accepted-no-wait",
        "writeBackRegion": {
          "offset": 1951,
          "length": 2
        },
        "normalization": "machine-native-binary",
        "semantics": [
          "below_baseline_today_bit",
          "sedentary_streak_active_bit"
        ],
        "peContract": "OpenClaw maps activity observations to native machine input bits; PE writes the vector source and does not wait inside a PE cycle."
      }
    },
    "arbiterRule": "PASSTHROUGH",
    "perceptualMapping": {
      "input": {
        "offset": 1951,
        "length": 2
      },
      "output": {
        "offset": 1953,
        "length": 2
      },
      "bitsPerElement": 1
    },
    "sequences": [
      {
        "id": "activity-active",
        "name": "Active day \u2192 GREEN",
        "metadata": {
          "description": "Today's movement matches or exceeds 7-day baseline"
        },
        "events": [
          {
            "id": "activity-ev-active",
            "elements": [
              {
                "value": 0,
                "threshold": 0.5
              },
              {
                "value": 0,
                "threshold": 0.5
              }
            ],
            "isInitial": true,
            "metadata": {
              "name": "active",
              "state": "ACTIVE"
            },
            "outputEvents": [
              {
                "id": "activity-out-active",
                "vector": [
                  0,
                  0
                ],
                "metadata": {
                  "ragStatusCode": "GREEN",
                  "state": "ACTIVE"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "activity-sedentary",
        "name": "Sedentary day \u2192 AMBER",
        "metadata": {
          "description": "Single-day dip below baseline"
        },
        "events": [
          {
            "id": "activity-ev-sedentary",
            "elements": [
              {
                "value": 1,
                "threshold": 0.5
              },
              {
                "value": 0,
                "threshold": 0.5
              }
            ],
            "isInitial": true,
            "metadata": {
              "name": "sedentary",
              "state": "SEDENTARY"
            },
            "outputEvents": [
              {
                "id": "activity-out-sedentary",
                "vector": [
                  1,
                  0
                ],
                "metadata": {
                  "ragStatusCode": "AMBER",
                  "state": "SEDENTARY"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "activity-prolonged",
        "name": "Prolonged inactivity \u2192 RED",
        "metadata": {
          "description": "Consecutive sedentary days exceeded streak threshold"
        },
        "events": [
          {
            "id": "activity-ev-prolonged",
            "elements": [
              {
                "value": 1,
                "threshold": 0.5
              },
              {
                "value": 1,
                "threshold": 0.5
              }
            ],
            "isInitial": true,
            "metadata": {
              "name": "prolonged",
              "state": "PROLONGED_INACTIVITY"
            },
            "outputEvents": [
              {
                "id": "activity-out-prolonged",
                "vector": [
                  1,
                  1
                ],
                "metadata": {
                  "ragStatusCode": "RED",
                  "state": "PROLONGED_INACTIVITY"
                }
              }
            ]
          }
        ]
      }
    ],
    "inputSequences": [
      {
        "name": "Active day",
        "pattern": "[0,0]",
        "description": "On-baseline day \u2014 GREEN trigger",
        "events": [
          [
            0,
            0
          ]
        ]
      },
      {
        "name": "Sedentary \u2192 prolonged streak",
        "pattern": "[1,0] \u2192 [1,1]",
        "description": "One sedentary day (AMBER) followed by streak escalation (RED)",
        "events": [
          [
            0,
            0
          ],
          [
            1,
            0
          ],
          [
            1,
            1
          ],
          [
            0,
            0
          ]
        ]
      }
    ],
    "matchAlgorithm": "gte"
  }
}
