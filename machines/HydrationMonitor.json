        "vectors": [
          {
            "id": "hydration-ev-low",
            "elements": [
              {
                "value": 1,
                "threshold": 0.5
              },
              {
                "value": 0,
                "threshold": 0.5
              }
            ],
            "isInitial": true,
            "metadata": {
              "name": "low",
              "state": "LOW"
            },
            "outputVectors": [
              {
                "id": "hydration-out-low",
                "vector": [
                  1,
                  0
                ],
                "metadata": {
                  "ragStatusCode": "AMBER",
                  "state": "LOW"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "hydration-critical",
        "name": "Critical intake \u2192 RED",
        "metadata": {
          "description": "Intake below quarter-target near end of day"
        },
        "vectors": [
          {
            "id": "hydration-ev-crit",
            "elements": [
              {
                "value": 1,
                "threshold": 0.5
              },
              {
                "value": 1,
                "threshold": 0.5
              }
            ],
            "isInitial": true,
            "metadata": {
              "name": "critical",
              "state": "CRITICAL"
