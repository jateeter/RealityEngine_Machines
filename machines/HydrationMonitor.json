        "owner": "openclaw-input-analyst",
        "dispatchMode": "accepted-no-wait",
        "writeBackRegion": {
          "offset": 1947,
          "length": 2
        },
        "normalization": "machine-native-binary",
        "semantics": [
          "below_half_daily_intake_target_bit",
          "below_quarter_daily_intake_target_bit"
        ],
        "peContract": "OpenClaw maps hydration observations to native machine input bits; PE writes the vector source and does not wait inside a PE cycle."
      }
    },
    "arbiterRule": "PASSTHROUGH",
    "perceptualMapping": {
      "input": {
        "offset": 1947,
        "length": 2
      },
      "output": {
        "offset": 1949,
        "length": 2
      },
      "bitsPerElement": 1
    },
    "sequences": [
