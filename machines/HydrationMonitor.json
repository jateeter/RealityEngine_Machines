        "schemaVersion": "1.0.0",
        "ownerTeam": "patient-safety-on-call",
        "runbook": "https://runbooks.example.org/health-personal/hydrationmonitor",
        "escalationPolicy": "pagerduty:patient-safety",
        "contact": {
          "primary": "patient-safety-on-call-primary@example.org",
          "secondary": "patient-safety-on-call-secondary@example.org"
        },
        "sla": {
          "ok": null,
          "info": null,
          "warning": 600,
          "error": 60
        },
        "notes": "Auto-backfilled by scripts/backfill-governance.mjs from primaryDomain=\"health-personal\".  Review and tune the routing as the team owning HydrationMonitor matures."
      },
      "machineClass": "signal-monitor",
      "inputSemantics": [
        "below_half_daily_intake_target_bit",
        "below_quarter_daily_intake_target_bit"
      ],
      "interconnections": [
        {
          "id": "health-personal.daily-activity-wellness.hydration-status",
          "type": "published-domain-bus-producer",
          "role": "hydration_status",
          "sourceMachine": "Hydration Monitor",
          "sourceOutputRegion": {
            "offset": 1949,
            "length": 2
          },
          "targetInputElements": [
            4,
            5
          ],
          "normalizedElements": [
            "below half daily target bit from HydrationMonitor [1949]",
            "below quarter daily target bit from HydrationMonitor [1950]"
          ],
          "purpose": "Publish hydration risk into the personal-health daily activity wellness bus.",
          "privacyBoundary": "PE composes normalized hydration status bits only; raw smart-cup, fridge, faucet, and bathroom event streams remain outside the universal reality vector.",
          "busId": "health-personal.daily-activity-wellness",
          "busTag": "published-bus-health-personal-daily-activity-wellness",
          "targetMachine": "Daily Activity Wellness Interconnect",
          "targetMachineFile": "DailyActivityWellnessInterconnect.json",
