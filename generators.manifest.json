      "cadence": "on-demand",
      "invoked_by": [
        "scripts/extract-qudt-subset.sh",
        "package.json"
      ],
      "gated_by": [
        "scripts/extract-qudt-subset.sh"
      ],
      "note": "validate-corpus.sh gates this through the shell wrapper (extract-qudt-subset.sh --check), not by calling the .py directly. The wrapper exists to resolve QUDT_PYTHON, since PEP 668 marks the system interpreter externally managed and the dependency owner has to be named rather than guessed."
    },
    {
      "script": "generate-owl.py",
      "modes": [
        "--check",
