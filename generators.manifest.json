      "artifact": "runtime trace RDF/JSON-LD (not committed; one file per recorded run)",
      "corpus": "runtime",
      "cadence": "on-demand",
      "invoked_by": [
        "package.json"
      ],
      "gated_by": []
    },
    {
      "script": "extract-qudt-subset.py",
      "modes": [
        "--check",
        "--write",
        "npm:qudt:check"
      ],
      "artifact": "domains/qudt-subset.ttl",
